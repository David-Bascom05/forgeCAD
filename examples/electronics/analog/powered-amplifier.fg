schematic

analog = library(file: "analog-symbols.fg")
power = library(file: "forge:power")
main = sheet(title: "Amplifier supply check")

source = role(kind: "power", voltage_mv: 3300)
Supply = symbol(ref_prefix: "J", pins: {
  OUT: pin(number: "1", kind: "power_out", at: (4,0), gives: [source]),
  RTN: pin(number: "2", kind: "passive", at: (4,-5))
}, graphics: [rect(from: (-3,-7), to: (2,2)), line(from: (2,0), to: (4,0)), line(from: (2,-5), to: (4,-5))])

J1 = place(sheet: main, symbol: Supply, at: (-23,16))
U1 = place(sheet: main, symbol: analog.Amplifier, at: (3,0), ref_offset: (2.3,5.65), value_offset: (2.3,3.4))
C1 = place(sheet: main, symbol: analog.Capacitor, value: "100 nF", at: (23,12))
vdd = junction(sheet: main, at: (3,16))
gnd = place(sheet: main, symbol: power.GND, at: (3,-16))
source_return = place(sheet: main, symbol: power.GND, at: (-15,8))
cap_return = place(sheet: main, symbol: power.GND, at: (23,6))
feed = wire(sheet: main, from: J1.OUT, to: vdd)
input_supply = wire(sheet: main, from: vdd, to: U1.VDD)
bypass_supply = wire(sheet: main, from: vdd, to: C1.P)
input_return = wire(sheet: main, from: U1.VSS, to: gnd.net)
supply_return = wire(sheet: main, from: J1.RTN, to: source_return.net, via: [(-15,11)])
bypass_return = wire(sheet: main, from: C1.N, to: cap_return.net)
local_cap = fulfill(sheet: main, want: U1.VDD, give: C1.P, role: analog.bypass, return_from: C1.N, return_to: U1.VSS)

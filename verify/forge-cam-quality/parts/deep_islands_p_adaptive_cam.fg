machining
# Benchmark (adaptive vs clear): deep_islands.fg's open level, 15.0 mm deep with a
# 6 mm end mill (2.5 D, flute 18 mm), material group P: adaptive.
shared tol = 0.01

f    = part("deep_islands.fg", group: "P")
m    = machine("generic-vmc3")
t1   = tool("flat-6", t: 1, stickout: 30, holder: "bt40-er32")
op1  = setup(f, machine: m, stock: box(margin: (3, 3, 1)), origin: "top-corner", tol: tol)
skim = facing(op1, tool: t1, to: 25, step: 1)
rough = adaptive(op1, tool: t1, from: 25, to: 10.2, step: 15, engagement: 40)
prog = program(op1, post: "fanuc", number: 5008)

# long fine: 200 turns inside
shared w = 40
sketch plan(on: xy) {
  outline = rect(center: (0, 0), size: (w, w))
}
param b.h = 110
b = extrude(plan, h)
sketch top(on: b.end) {
  c = pt(0, 0)
}
param hole1.d = 19.46
param hole1.major = 20
param hole1.pitch = 0.5
hole1 = hole(at: top.c, d: d, depth: thru, thread: (major, pitch))
thread1 = thread(hole: hole1, length: "full")

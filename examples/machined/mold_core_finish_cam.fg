machining
# mold_core.fg finished with forge-cam-3d's ops on CAM-3AXIS's drop-cutter (after z-level
# roughing): steep-and-shallow over the core, a spiral on the block's top, flat-area on the
# plate. Every stepover and step-down from a 0.01 mm cusp; every move certified (column route).
shared tol = 0.01

f     = part("mold_core.fg", group: "N")
m     = machine("generic-vmc3")
t1    = tool("flat-10", t: 1, stickout: 40, holder: "bt40-er32")
t2    = tool("ball-6", t: 2, stickout: 40, holder: "bt40-er32")
op1   = setup(f, machine: m, stock: box(margin: (0, 0, 2)), origin: "top-center", tol: tol, at: (-200, -150, -250))
rough = zlevel(op1, tool: t1, leave: 0.5, step: 3, stepover: 4, area: (-45, -35, 45, 35), grid: 1)
ss    = steep_shallow(op1, tool: t2, cusp: 0.01, threshold: 45, area: (-30, -24, 30, 24), from: 26, to: 10.5, grid: 1)
top   = spiral(op1, tool: t2, cusp: 0.01, area: (-12, -8, 12, 8), r1: 15)
plate = flat(op1, tool: t2, cusp: 0.01, area: (-30, -24, 30, 24), to: 9.5, from: 10.5)
prog  = program(op1, post: "fanuc", number: 1003)

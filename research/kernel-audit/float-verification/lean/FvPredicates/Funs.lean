  (y2 : ((Array F64 2#usize) × Std.Usize))
  (x2 : ((Array F64 2#usize) × Std.Usize))
  (y1 : ((Array F64 2#usize) × Std.Usize)) (h : Array F64 16#usize) :
  Result (Std.Usize × (Array F64 16#usize))
  := do
  let fl ← zero
  let p := Array.repeat 8#usize fl
  let q := Array.repeat 8#usize fl
  let (a, i) := x1
  let s ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice F64)) a { «end» := i }
  let (a1, i1) := y2
  let s1 ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice F64)) a1 { «end» := i1 }
  let (np, p1) ← mul_small s s1 p
  let (a2, i2) := x2
  let s2 ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice F64)) a2 { «end» := i2 }
  let (a3, i3) := y1
  let s3 ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice F64)) a3 { «end» := i3 }
  let (nq, q1) ← mul_small s2 s3 q
  let q2 ← cross_two_loop q1 nq 0#usize
  let s4 ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice F64)) p1 { «end» := np }
  let s5 ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice F64)) q2 { «end» := nq }
  let (s6, to_slice_mut_back) ← lift (Array.to_slice_mut h)
  let (i4, s7) ← sum_into s4 s5 s6
  let h1 := to_slice_mut_back s7
  ok (i4, h1)

/-- [fv_predicates::diff2]:
    Source: 'src/lib.rs', lines 360:0-367:1
    Visibility: public -/
def diff2 (a : F64) (b : F64) : Result ((Array F64 2#usize) × Std.Usize) := do
  let (x, y) ← two_diff a b
  let fl ← zero
  let b1 ← F64.Insts.CoreCmpPartialEqF64.eq y fl
  if b1
  then ok (Array.make 2#usize [ x, fl ], 1#usize)
  else ok (Array.make 2#usize [ y, x ], 2#usize)

/-- [fv_predicates::exact_diffs4]:
    Source: 'src/lib.rs', lines 323:0-341:1
    Visibility: public -/
def exact_diffs4
  (a : Point2) (b : Point2) (c : Point2) :
  Result (Option (Array F64 4#usize))
  := do
  let (x0, t0) ← two_diff a.x c.x
  let fl ← zero
  let b1 ← F64.Insts.CoreCmpPartialEqF64.ne t0 fl
  if b1
  then ok none
  else
    let (x1, t1) ← two_diff a.y c.y
    let b2 ← F64.Insts.CoreCmpPartialEqF64.ne t1 fl
    if b2
    then ok none
    else
      let (x2, t2) ← two_diff b.x c.x
      let b3 ← F64.Insts.CoreCmpPartialEqF64.ne t2 fl
      if b3
      then ok none
      else
        let (x3, t3) ← two_diff b.y c.y
        let b4 ← F64.Insts.CoreCmpPartialEqF64.ne t3 fl
        if b4
        then ok none
        else ok (some (Array.make 4#usize [ x0, x1, x2, x3 ]))

/-- [fv_predicates::orient2d_exact]:
    Source: 'src/lib.rs', lines 343:0-357:1
    Visibility: public -/
def orient2d_exact (a : Point2) (b : Point2) (c : Point2) : Result F64 := do
  let o ← exact_diffs4 a b c
  match o with
  | none =>
    let acx ← diff2 a.x c.x
    let acy ← diff2 a.y c.y
    let bcx ← diff2 b.x c.x
    let bcy ← diff2 b.y c.y
    let fl ← zero
    let h := Array.repeat 16#usize fl
    let (n, h1) ← cross_two acx bcy acy bcx h
    let s ←
      core.array.Array.index (core.ops.index.IndexSlice
        (core.slice.index.SliceIndexRangeToUsizeSlice F64)) h1 { «end» := n }
    estimate s
  | some a1 =>
    let acx ← Array.index_usize a1 0#usize
    let acy ← Array.index_usize a1 1#usize
    let bcx ← Array.index_usize a1 2#usize
    let bcy ← Array.index_usize a1 3#usize
    let fl ← zero
    let h := Array.repeat 4#usize fl
    let (n, h1) ← cross_exact acx bcy acy bcx h
    let s ←
      core.array.Array.index (core.ops.index.IndexSlice
        (core.slice.index.SliceIndexRangeToUsizeSlice F64)) h1 { «end» := n }
    estimate s

/-- [fv_predicates::orient2d_adapt]:
    Source: 'src/lib.rs', lines 307:0-320:1
    Visibility: public -/
def orient2d_adapt
  (a : Point2) (b : Point2) (c : Point2) (detsum : F64) : Result F64 := do
  let acx ← F64.Insts.CoreOpsArithSubF64F64.sub a.x c.x
  let acy ← F64.Insts.CoreOpsArithSubF64F64.sub a.y c.y
  let bcx ← F64.Insts.CoreOpsArithSubF64F64.sub b.x c.x
  let bcy ← F64.Insts.CoreOpsArithSubF64F64.sub b.y c.y
  let fl ← zero
  let h := Array.repeat 4#usize fl
  let (n, h1) ← cross_exact acx bcy acy bcx h
  let s ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice F64)) h1 { «end» := n }
  let det ← estimate s
  let fl1 ← ccw_bound_b
  let fl2 ← F64.Insts.CoreOpsArithMulF64F64.mul fl1 detsum
  let b1 ← F64.Insts.CoreCmpPartialOrdF64.ge det fl2
  if b1
  then ok det
  else
    let fl3 ← F64.Insts.CoreOpsArithNegF64.neg det
    let fl4 ← F64.Insts.CoreOpsArithMulF64F64.mul fl1 detsum
    let b2 ← F64.Insts.CoreCmpPartialOrdF64.ge fl3 fl4
    if b2
    then ok det
    else
      let e ← orient2d_exact a b c
      let b3 ← F64.Insts.CoreCmpPartialEqF64.ne e e
      if b3
      then big.orient2d_big a b c
      else ok e

/-- [fv_predicates::orient2d]:
    Source: 'src/lib.rs', lines 295:0-305:1
    Visibility: public -/
def orient2d (a : Point2) (b : Point2) (c : Point2) : Result F64 := do
  let fl ← F64.Insts.CoreOpsArithSubF64F64.sub a.x c.x
  let fl1 ← F64.Insts.CoreOpsArithSubF64F64.sub b.y c.y
  let left ← F64.Insts.CoreOpsArithMulF64F64.mul fl fl1
  let fl2 ← F64.Insts.CoreOpsArithSubF64F64.sub a.y c.y
  let fl3 ← F64.Insts.CoreOpsArithSubF64F64.sub b.x c.x
  let right ← F64.Insts.CoreOpsArithMulF64F64.mul fl2 fl3
  let det ← F64.Insts.CoreOpsArithSubF64F64.sub left right
  let fl4 ← core.f64.F64.abs left
  let fl5 ← core.f64.F64.abs right
  let detsum ← F64.Insts.CoreOpsArithAddF64F64.add fl4 fl5
  let fl6 ← ccw_bound
  let bound ← F64.Insts.CoreOpsArithMulF64F64.mul fl6 detsum
  let b1 ← F64.Insts.CoreCmpPartialOrdF64.gt det bound
  if b1
  then ok det
  else
    let fl7 ← F64.Insts.CoreOpsArithNegF64.neg det
    let b2 ← F64.Insts.CoreCmpPartialOrdF64.gt fl7 bound
    if b2
    then ok det
    else orient2d_adapt a b c detsum

end fv_predicates

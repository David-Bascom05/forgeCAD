assembly

# panel joint: ISO 7380 M5x12 through both returns, ISO 7089-5, ISO 10511-M5

shared z_lower = 0
shared size_m5 = 5
shared min_m5 = 5   # the nut's whole thread
shared zx_nut = 4.04
shared zx_scr = 0

lower = part("plates/return_t1.fg", ground: true, at: pose(at: (0, 0, z_lower)))
upper = part("plates/return_t1.fg")
wsh = part("../iso7089_5.fg")
nut = part("../iso10511_m5.fg")
scr = part("../iso7380_m5x12.fg")
at_upper = fastened(upper.a, lower.b)
at_wsh = fastened(wsh.a, upper.b)
at_nut = fastened(nut.seat, wsh.b)
at_scr = fastened(scr.head, lower.a)
m5 = fit_rule(external_thread, internal_thread, size: size_m5, min_engagement: min_m5)

expect interferences = 0
expect mobility = 0
expect z(nut) = zx_nut +- 0.001
expect z(scr) = zx_scr +- 0.001

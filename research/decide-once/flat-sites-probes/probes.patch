+/// PROBE (temporary): G14, the box-only accept; returns true (no behaviour change) unless FORGE_G14=strict.
+fn g14_probe(site: &str, ix: &Index, f: FaceId, p: Point3) -> bool {
+    use std::sync::OnceLock;
+    static MODE: OnceLock<u8> = OnceLock::new();
+    let mode = *MODE.get_or_init(|| match std::env::var("FORGE_G14").as_deref() {
+        Ok("log") => 1,
+        Ok("strict") => 2,
+        _ => 0,
+    });
+    if mode == 0 {
+        return true;
+    }
+    let w = ix.point_in_face(f, p);
+    if w != Where::Outside {
+        if mode == 1 { eprintln!("G14 {site} ok {w:?}"); }
+        return true;
+    }
+    let kind = match &ix.body.face(f).surface { Surface::Plane(_) => "plane", _ => "curved" };
+    eprintln!("G14 {site} OUTSIDE face {f:?} {kind} p {p:?}");
+    mode == 1
+}

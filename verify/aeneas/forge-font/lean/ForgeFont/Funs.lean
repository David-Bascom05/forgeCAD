  then
    let i1 ← «from» + i
    let i2 ← i1 % n
    let j ← first + i2
    let after_last ←
      if found
      then do
           let i3 ← i + 1#usize
           ok (i3 = n)
      else ok false
    let (g1, w1) ←
      if after_last

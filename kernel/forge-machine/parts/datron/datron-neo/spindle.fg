# datron-neo spindle: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.spindle); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared c0x = 0
shared c0y = 0
shared c0z0 = 225.5
shared c0r = 44.5
shared c0h = 299

sketch sc0(on: offset(xy, c0z0)) {
  c = circle((c0x, c0y), c0r)
}
c0 = extrude(sc0.c, c0h)

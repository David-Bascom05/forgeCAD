# haas-vf-3yt table: 1372 x 610 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -685
shared y0 = -304
shared z0 = -89
shared lx = 1370
shared ly = 608
shared lz = 88
shared cx = 0
shared cy = 0
shared cw = 1372
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

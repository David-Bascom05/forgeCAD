def glyf_core.contour
  (g : glyf_core.Simple) (first : Std.Usize) (last : Std.Usize) :
  Result (alloc.vec.Vec glyf_core.SegI)
  := do
  let i ← last + 1#usize
  let n ← i - first
  if n < 2#usize
  then ok (alloc.vec.Vec.new glyf_core.SegI)
  else
    let (g1, k, found) ← glyf_core.contour_loop0 g first n 0#usize false
    let (start, «from») ←
      if found
      then
        do
        let i1 ← first + k
        let p ← glyf_core.at g1 i1
        let i2 ← k + 1#usize
        ok (p, i2)
      else
        do
        let p ← glyf_core.at g1 first
        let i1 ← first + 1#usize
        let p1 ← glyf_core.at g1 i1
        let p2 ← glyf_core.mid p p1
        ok (p2, 1#usize)
    let w ←
      glyf_core.contour_loop1 g1 first n found «from»
        { at_ := start, ctrl := none, out := (alloc.vec.Vec.new glyf_core.SegI)
        } 0#usize
    let w1 ← glyf_core.step w start true
    ok w1.out


# akira-seiki-v5 column: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.column); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -434.5
shared b0y0 = 550.5
shared b0z0 = -179.5
shared b0sx = 869
shared b0sy = 299
shared b0h = 1454

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

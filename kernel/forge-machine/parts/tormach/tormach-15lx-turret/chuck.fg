# tormach-15lx-turret chuck: 152 mm recommended (published) + 5 mm, 90 long (estimate)
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared cx = 0
shared cy = 0
shared z0 = -89
shared R = 80
shared H = 88
shared rb = 15

sketch plan(on: offset(xy, z0)) {
  outline = circle((cx, cy), R)
}
body = extrude(plan.outline, H)
sketch bb(on: body.end) {
  c = circle((cx, cy), rb)
}
through = cut(bb.c, H)

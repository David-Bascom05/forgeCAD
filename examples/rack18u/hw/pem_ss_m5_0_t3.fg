# PEM SS-M5-0 self-clinching nut, as installed in a 3.02 sheet
# source: PEM bulletin CL (https://damlite.pemnet.com/CLS-M6-1_pdf_2.pdf), S/SS/CLS table, shank code 0
# frame: origin on the axis in the sheet's flush face (the face the screw enters); +z through the sheet to the nut head; the shank's end is recessed t - A below the flush face

shared tsh = 3.02   # sheet thickness this file is for
shared d = 5   # thread
shared P = 0.8   # pitch
shared A = 0.77   # shank length, max (bulletin CL, shank code 0)
shared C = 6.33   # shank diameter, max
shared E = 8.64   # head diameter
shared T = 2   # head height above the sheet
shared c = 0.3   # head top edge chamfer (modelled)
shared rm = (d - 1.082532 * P) / 2   # thread bore: half the ISO 965 minor diameter D1 = d - 1.0825 P
shared z0 = tsh - A   # where the shank (and the thread) starts
shared rcs = C / 2
shared re = E / 2
shared zref = tsh + T
shared xref = re

sketch prof(on: xz) {
  o = poly([(rm, z0), (rcs, z0), (rcs, tsh), (re, tsh), (re, tsh + T - c), (re - c, tsh + T), (rm, tsh + T)])
  c0 = pt(0, 0)
  pz0 = pt(0, 0)
  pz1 = pt(0, z0)
  pz2 = pt(0, tsh + T)
  zax = line((0, 0), (0, zref), construction: true)
  xax = line((0, 0), (xref, 0), construction: true)
}
body = revolve(prof.o, axis: prof.zax)

flush = anchor(plane(at: prof.pz0, normal: prof.zax.dir, x: prof.xax.dir))
thd = anchor(plane(at: prof.pz1, normal: prof.zax.dir, x: prof.xax.dir), kind: internal_thread, size: d, depth: A + T)
end = anchor(plane(at: prof.pz2, normal: prof.zax.dir, x: prof.xax.dir))

expect valid
expect bodies = 1
expect volume = 103.118 +- 0.05%

schematic

analog = library(file: "analog-symbols.fg")
main = sheet(title: "Switched load connections")
load_return = role(kind: "return", connect_to: P2, through: "mosfet", part_path: "channel")
output_cap = role(kind: "bypass", connect_to: P2, through: "capacitor", value: "10 nF")
load_coil = role(kind: "signal", connect_to: J1.P1, through: "inductor", value_range: ["90 uH", "110 uH"])

Switch = symbol(ref_prefix: "Q", part_kind: "mosfet", paths: {channel: [D, S]}, pins: {
    D: pin(number: "3", kind: "passive", at: (0,5)),
    G: pin(number: "1", kind: "input", at: (-5,0)),
    S: pin(number: "2", kind: "passive", at: (0,-5))
  }, graphics: [line(from:(0,5),to:(0,2)), line(from:(0,2),to:(-1,2)), line(from:(-1,2),to:(-1,-2)),
                line(from:(-1,-2),to:(0,-2)), line(from:(0,-2),to:(0,-5)), line(from:(-2,2),to:(-2,-2)),
                line(from:(-5,0),to:(-2,0))])
Coil = symbol(ref_prefix: "L", part_kind: "inductor", pins: {
    A: pin(number: "1", kind: "passive", at: (-6,0)), B: pin(number: "2", kind: "passive", at: (6,0))
  }, graphics: [line(from:(-6,0),to:(-3,0)),arc(from:(-3,0),mid:(-2,1),to:(-1,0)),
                arc(from:(-1,0),mid:(0,1),to:(1,0)),arc(from:(1,0),mid:(2,1),to:(3,0)),line(from:(3,0),to:(6,0))])

J1 = place(sheet: main, symbol: analog.Connector2, at: (16,10), wants: {P1: [load_return, output_cap]})
J2 = place(sheet: main, symbol: analog.Connector2, at: (-35,10), wants: {P1: [load_coil]})
L1 = place(sheet: main, symbol: Coil, at: (-14,10), value: "0.1 mH")
Q1 = place(sheet: main, symbol: Switch, at: (0,0))
C1 = place(sheet: main, symbol: analog.Capacitor, at: (28,0), value: "10 nF")
drain = junction(sheet: main, at: (0,10))
ret = junction(sheet: main, at: (0,-10))
supply = wire(sheet: main, from: J2.P1, to: L1.A)
load = wire(sheet: main, from: L1.B, to: drain)
switch_drain = wire(sheet: main, from: drain, to: Q1.D)
gate_drive = wire(sheet: main, from: J2.P2, to: Q1.G, via: [(-25,5),(-25,0)])
switch_source = wire(sheet: main, from: Q1.S, to: ret)
switched = wire(sheet: main, from: drain, to: J1.P1, via: [(0,17),(23,17),(23,10)])
ground = wire(sheet: main, from: J1.P2, to: ret, via: [(24,5),(24,-10)])
cap_high = wire(sheet: main, from: J1.P1, to: C1.P, via: [(28,10)])
cap_low = wire(sheet: main, from: C1.N, to: ret, via: [(28,-10)])

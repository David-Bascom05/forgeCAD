# Benchmark: a slot 12 wide and 15 deep open at both ends, for adaptive vs clear in a narrow,
# deep open channel.

shared L = 80
shared W = 40
shared t = 20
shared w = 12
shared depth = 15

sketch plan(on: xy) {
  outline = rect(corner: (0, 0), size: (L, W))
}
plate = extrude(plan, t)
sketch sl(on: plate.end) {
  s = rect(corner: (-5, (W - w) / 2), size: (L + 10, w))
}
channel = cut(sl.s, depth)

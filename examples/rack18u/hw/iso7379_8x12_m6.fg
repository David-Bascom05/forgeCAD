# ISO 7379 hexagon socket shoulder screw 8 x 12, thread M6 x 11
# source: https://www.fasteners.eu/standards/ISO/7379/ (ds 8, dk 13, k 5.5, s 4, b 11); Ganter ISO 7379-8-M6 sheets (l2 11)
# frame: origin on the axis at the head underside; +z along the shoulder to the tip; head at z < 0

properties(description: "ISO 7379 hexagon socket shoulder screw 8 x 12, thread M6 x 11", material: "8.8")
shared ds = 8   # shoulder diameter (f9)
shared ls = 12   # shoulder length
shared d = 6   # thread major diameter
shared P = 1   # pitch
shared lt = 11   # thread length
shared dk = 13   # head diameter
shared k = 5.5   # head height
shared s = 4   # hexagon socket across flats
shared t = 3   # socket depth (modelled; not on the supplier sheets read)
shared c = 0.5   # head top edge chamfer (modelled)
shared ch = 0.6 * P   # tip chamfer
shared l = ls + lt   # head underside to the tip
shared rsh = ds / 2
shared rs = d / 2
shared rk = dk / 2
shared rc = s / sqrt(3)
shared n6 = count(6)
shared zref = l
shared xref = rs

sketch prof(on: xz) {
  o = poly([(0, -k), (rk - c, -k), (rk, c - k), (rk, 0), (rsh, 0), (rsh, ls), (rs, ls), (rs, l - ch), (rs - ch, l), (0, l)])
  c0 = pt(0, 0)
  pz0 = pt(0, 0)
  pz1 = pt(0, ls)
  pz2 = pt(0, l)
  zax = line((0, 0), (0, zref), construction: true)
  xax = line((0, 0), (xref, 0), construction: true)
}
body = revolve(prof.o, axis: prof.zax)
sketch hx(on: body.side(prof.o[0]), at: prof.c0) {
  hexo = poly(polar(n: n6, r: rc, start: 0deg))
}
socket = cut(hx, t)

head = anchor(plane(at: prof.pz0, normal: prof.zax.dir, x: prof.xax.dir))
shoulder = anchor(plane(at: prof.pz0, normal: prof.zax.dir, x: prof.xax.dir), kind: shaft, size: ds, depth: ls)
clamp = anchor(plane(at: prof.pz1, normal: prof.zax.dir, x: prof.xax.dir))
thd = anchor(plane(at: prof.pz1, normal: prof.zax.dir, x: prof.xax.dir), kind: external_thread, size: d, depth: lt)
tip = anchor(plane(at: prof.pz2, normal: prof.zax.dir, x: prof.xax.dir))

expect valid
expect bodies = 1
expect volume = 1594.521 +- 0.05%

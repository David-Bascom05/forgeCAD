# A connector housing: n pin holes in a row on its top face, `pitch` apart. Its anchors: `face`
# (the top, z out of it: where wires leave), `pin[1]`..`pin[n]` at the holes' mouths, and `seat`
# (its bottom, z down).
shared n = count(8)
shared pitch = 2.54
shared w = 8
shared h = 10
shared edge = 3
shared hd = 1.8
shared hdepth = 6
properties(part_number: "HDR-1", description: "connector housing", material: "PA66")
sketch plan(on: xy) {
  outline = rect(center: (0, 0), size: (pitch * n + edge, w))
  o = pt(0, 0)
}
body = extrude(plan, h)
sketch top(on: body.end) {
  c = pt(0, 0)
  for k in 1..=n {
    p = pt(pitch * (2 * k - n - 1) / 2, 0)
  }
}
holes = hole(at: top.p, d: hd, depth: hdepth)
face = anchor(plane(at: top.c, normal: body.end.normal, x: plan.outline[0].dir))
seat = anchor(plane(at: plan.o, normal: body.start.normal, x: plan.outline[0].dir))
for k in 1..=n {
  pin = anchor(plane(at: top.p[k], normal: body.end.normal, x: plan.outline[0].dir))
}

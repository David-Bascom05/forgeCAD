machining
# Benchmark (verify/forge-cam-quality): face, then pocket round both islands with a 10 mm end mill.
shared tol = 0.01

f    = part("pocket_islands.fg", material: "6061-T6")
m    = machine("generic-vmc3")
t1   = tool("flat-10", t: 1, stickout: 32, holder: "bt40-er32")
op1  = setup(f, machine: m, stock: box(margin: (3, 3, 1)), origin: "top-corner", tol: tol)
skim = facing(op1, tool: t1, to: 20, step: 1)
well = pocket(op1, tool: t1, from: 20, to: 10, stepover: 4, step: 5, ramp: 3)
prog = program(op1, post: "fanuc", number: 5001)

# kingpin rivet 10.0: countersunk head flush in the plate, lower head 16 x 3 under the race
# source: SPEC 6.2 (representative: Blickle gives only "riveted kingpin")
# frame: the caster frame (SPEC 5.10): origin on the kingpin axis in the plate's top face, z up, y along the plate's long side, the wheel towards -y

properties(description: "kingpin rivet 10.0", material: "AISI 1018")
shared rs = 5   # shank
shared rh = 8   # both heads
shared hk = 3   # 90deg countersunk head depth
shared zr = 17.53   # lower head's top: the race's underside
shared hh = 3   # lower head height
shared lref = 10

sketch ref(on: xy) {
  o = pt(0, 0)
  xl = line((0, 0), (lref, 0), construction: true)
  yl = line((0, 0), (0, lref), construction: true)
  xn = line((lref, 0), (0, 0), construction: true)
}
sketch prof(on: rotate(ref.plane, about: ref.xl, by: 90deg)) {
  o = poly([(0, 0), (rh, 0), (rs, -hk), (rs, -zr), (rh, -zr), (rh, -zr - hh), (0, -zr - hh)])
  zax = line((0, 0), (0, -zr), construction: true)
}
pin = revolve(prof.o, axis: prof.zax)

cf = anchor(plane(at: ref.o, normal: ref.plane.normal, x: ref.xl.dir))

expect valid
expect bodies = 1
expect volume = 2149.635 +- 0.05%

def cdt.triangulate_within
  {R : Type _} (RefineInst : cdt.Refine R)
  (points : Slice forge_math.vec.Point2)
  (loops : Slice (alloc.vec.Vec Std.U32))
  (interior : Slice forge_math.vec.Point2) (refine : Option R) (tangled : Bool)
  :
  Result (core.result.Result cdt.Triangulation cdt.CdtError)
  := do
  let r ←
    cdt.within RefineInst points loops interior refine tangled cdt.ROUNDS false
  match r with
  | core.result.Result.Ok p => let (t, _) := p
                               ok (core.result.Result.Ok t)
  | core.result.Result.Err e => ok (core.result.Result.Err e)


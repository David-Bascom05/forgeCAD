# A vacuum-formed cover modelled as a solid: its surface is the cover's outside, the wall t thick
# inside it (from: "outer", the default). The male mould is generated: the solid less the wall,
# grown by the plastic's shrink, on a base, vented.
shared t = 2
shared W = 120
shared L = 80
shared H = 35
shared lean = 5deg
shared r = 8
shared rt = 5
sketch footprint(on: xy) {
  outline = hull(disc((r - W / 2, r - L / 2), r), disc((W / 2 - r, r - L / 2), r),
                 disc((W / 2 - r, L / 2 - r), r), disc((r - W / 2, L / 2 - r), r))
}
body = extrude(footprint, H, taper: lean)
round = fillet(edges(of: body.end), rt)
cover = thermoform(body, t: t, material: "HIPS")

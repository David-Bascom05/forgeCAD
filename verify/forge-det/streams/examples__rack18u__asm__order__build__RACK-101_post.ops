{"op":"ReplaceFeature","id":"fb","text":"sketch fb(on: leg_b.top) {\n  for i in 0..n_stud {\n    stud = pt(s_stud, L - w_stud[i])\n  }\n  for i in 0..n_pnl {\n    pnl = pt(s_pnl, L - w_pnl[i])\n  }\n  for i in 0..n_hng {\n    hng = pt(s_hng, L - w_hng[i])\n  }\n  for i in 0..n_stk {\n    stk = pt(s_stk, L - w_stk[i])\n  }\n  ax = line((0, 0), (1, 0), construction: true)\n}\n"}

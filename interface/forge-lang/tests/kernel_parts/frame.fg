tt_st = fillet(edges(between: (tt, st), crease: "concave"), vary([(0, 3), (0.5, 4.5), (1, 3)]))
cluster = fillet(edges(between: (st, bb), crease: "concave") + edges(between: (dt, bb), crease: "concave") + edges(between: (st, dt), crease: "concave"), 3)
tt_ht = fillet(edges(between: (tt, ht), crease: "concave"), 3)
dt_ht = fillet(edges(between: (dt, ht), crease: "concave"), 3)

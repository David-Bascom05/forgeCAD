# Eksi & Karabeyoglu 2017b, ASTRJ 11(2):198, DOI 10.12913/22998624/71147: HIPS 825E 1.5 mm, female cone opening 100,
# depth 50, base 75 (the Ruse paper's mould), vacuum only. Assumptions: eksi2017b_cone.notes.md.
sketch plan(on: xy) {
  rim = circle((0, 0), 50)
}
cav = extrude(plan, -50, taper: 14.036243deg)
floor = fillet(edges(of: cav.end), 6)
part = thermoform(cav, t: 1.5, material: "HIPS", tool: "female", flange: 20, margin: 5, shrink: ratio(0), vent: false, temperature: 135, pressure: ratio(0.097))

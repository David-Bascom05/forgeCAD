# haas-dm-1 table: 660 x 381 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -329
shared y0 = -189.5
shared z0 = -89
shared lx = 658
shared ly = 379
shared lz = 88
shared cx = 0
shared cy = 0
shared cw = 660
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

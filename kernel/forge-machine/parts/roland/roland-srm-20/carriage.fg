# roland-srm-20 carriage: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.carriage); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -49.5
shared b0y0 = 35.5
shared b0z0 = 191.25
shared b0sx = 99
shared b0sy = 138.5
shared b0h = 99.5

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

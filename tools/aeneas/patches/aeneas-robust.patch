+(** forge: lower Charon's breakable blocks to structured code, linearly.
+
+    With [--no-code-duplication], Charon does not copy a block that several branches reach:
+    it wraps the region in a [loop] that never continues to itself (a breakable block), and
+    the branches leave it with [break]s (and reach enclosing loops with [break i] / [continue i],
+    [i > 0]). Aeneas's loops take only [break 0] / [continue 0]. This pass removes every
+    breakable block: an exit code (a fresh [usize] local) is set where a branch leaves the block,
+    the statements after a possible exit run only while the code is 0, and after the block a
+    switch on the code performs the [break] / [continue] that went past it. The program's
+    behaviour is unchanged, and its size grows linearly (no duplication). *)
+let lower_breakable_blocks (_crate : crate) (f : fun_decl) : fun_decl =
+  match f.body with
+  | StructuredBody body ->
+      let locals = ref body.locals.locals in
+      let next = ref (List.length !locals) in
+      let fresh span : local_id =
+        let id = LocalId.of_int !next in
+        incr next;
+        locals :=
+          !locals
+          @ [
+              {
+                index = id;
+                name = Some "exit";
+                span;
+                local_ty = TypesUtils.mk_usize_ty;
+                is_mutable = true;
+                borrowck_constraints = [];
+                drop_flag_for = None;
+              };
+            ];
+        id
+      in
+      let place id : place = { kind = PlaceLocal id; ty = TypesUtils.mk_usize_ty } in
+      let cst (n : int) : constant_expr =
+        {
+          kind = CInteger (UnsignedInteger (Usize, Z.of_int n));
+          ty = TypesUtils.mk_usize_ty;
+        }
+      in
+      let mk span kind : statement =
+        { span; statement_id = StatementId.zero; kind; comments_before = [] }
+      in
+      let mkb span statements : block =
+        { span; block_id = BlockId.zero; statements }
+      in
+      let assign span x n = mk span (Assign (place x, Use (Constant (cst n), NoRetag))) in
+      (* an exit: tagged so that the symbolic execution treats it as leaving the block (it does not
+         join the branches after a switch one of whose branches exits; see
+         [LlbcAstUtils.block_has_break_continue_return]) *)
+      let exit span x n = { (assign span x n) with comments_before = [ "forge:exit" ] } in
+      let switch span x (cases : (int * block) list) (default : block) : statement =
+        let data : switch_data =
+          {
+            scrutinee = SwitchValue (Read (place x));
+            branches = List.mapi (fun i (n, _) -> (cst n, BranchId.of_int i)) cases;
+            fallback = Some (BranchId.of_int (List.length cases));
+          }
+        in
+        mk span (Switch (data, List.map snd cases @ [ default ]))
+      in
+      (* Does the loop [b] (its body) continue to itself? *)
+      let continues_to_self (b : block) : bool =
+        let found = ref false in
+        let visitor =
+          object
+            inherit [_] iter_statement as super
+            method! visit_Loop depth b = super#visit_Loop (depth + 1) b
+            method! visit_Continue depth i = if i = depth then found := true
+          end
+        in
+        visitor#visit_block 0 b;
+        !found
+      in
+      (* Lower the breakable block with body [b] (whose inner blocks are lowered already):
+         the statements to put in its place *)
+      let lower_block span (b : block) : statement list =
+        let x = fresh span in
+        let codes : (int * statement_kind) list ref = ref [] in
+        let code_of (k : statement_kind) : int =
+          match List.find_opt (fun (_, k') -> k' = k) !codes with
+          | Some (n, _) -> n
+          | None ->
+              let n = 2 + List.length !codes in
+              codes := !codes @ [ (n, k) ];
+              n
+        in
+        (* [depth]: real loops entered inside the block. Returns the statements and whether
+           they may set the exit code. *)
+        let rec tr_stmts depth (sts : statement list) : statement list * bool =
+          match sts with
+          | [] -> ([], false)
+          | st :: rest ->
+              let st', ex, uncond = tr_stmt depth st in
+              if uncond then (st', true)
+              else
+                let rest', ex' = tr_stmts depth rest in
+                if ex && depth = 0 && rest' <> [] then
+                  (st' @ [ switch st.span x [ (0, mkb st.span rest') ] (mkb st.span []) ], true)
+                else (st' @ rest', ex || ex')
+        and tr_block depth (b : block) : block * bool =
+          let sts, ex = tr_stmts depth b.statements in
+          ({ b with statements = sts }, ex)
+        and tr_stmt depth (st : statement) : statement list * bool * bool =
+          match st.kind with
+          | Break i when i < depth -> ([ st ], false, false)
+          | Continue i when i < depth -> ([ st ], false, false)
+          | Continue i when i = depth ->
+              [%craise] st.span "Continue to a breakable block"
+          | (Break i | Continue i) when depth <= 1 ->
+              (* The exit leaves the block ([i = depth]) or goes past it to an enclosing loop
+                 ([i > depth]); the jump past it is the code's to perform, after the block.
+                 From inside one real loop of the block ([depth = 1]) it also leaves that loop. *)
+              let n =
+                if i = depth then 1
+                else
+                  match st.kind with
+                  | Break _ -> code_of (Break (i - depth - 1))
+                  | _ -> code_of (Continue (i - depth - 1))
+              in
+              let leave = if depth = 1 then [ { st with kind = Break 0 } ] else [] in
+              (exit st.span x n :: leave, true, true)
+          | Break i ->
+              (* from two or more real loops deep: not lowered (Aeneas takes no break past a
+                 loop); its index loses the removed block *)
+              if i = depth then
+                [%craise] st.span "Break out of two loops into an enclosing breakable block"
+              else ([ { st with kind = Break (i - 1) } ], false, false)
+          | Continue i -> ([ { st with kind = Continue (i - 1) } ], false, false)
+          | Switch (data, branches) ->
+              let bs = List.map (tr_block depth) branches in
+              ( [ { st with kind = Switch (data, List.map fst bs) } ],
+                List.exists snd bs,
+                false )
+          | Loop lb ->
+              (* an exit from inside the loop (one deep) leaves it with the code set *)
+              let lb', ex = tr_block (depth + 1) lb in
+              ([ { st with kind = Loop lb' } ], ex && depth = 0, false)
+          | _ -> ([ st ], false, false)
+        in
+        let body, _ = tr_stmts 0 b.statements in
+        let dispatch =
+          match !codes with
+          | [] -> []
+          | cs ->
+              [
+                switch span x
+                  (List.map (fun (n, k) -> (n, mkb span [ mk span k ])) cs)
+                  (mkb span []);
+              ]
+        in
+        (assign span x 0 :: body) @ dispatch
+      in
+      let rec lower_stmts (sts : statement list) : statement list =
+        List.concat_map
+          (fun (st : statement) ->
+            match st.kind with
+            | Loop b ->
+                let b = lower_blk b in
+                if continues_to_self b then [ { st with kind = Loop b } ]
+                else lower_block st.span b
+            | Switch (data, branches) ->
+                [ { st with kind = Switch (data, List.map lower_blk branches) } ]
+            | _ -> [ st ])
+          sts
+      and lower_blk (b : block) : block = { b with statements = lower_stmts b.statements } in
+      (* Aeneas does not interpret unwinding (calls, drops and asserts are evaluated with their
+         [on_unwind] block ignored), but its loop checks visit those blocks; with
+         [--no-code-duplication] the cleanups are shared, and leave through [break i]. Empty them. *)
+      let no_unwind =
+        object
+          inherit [_] map_statement as super
+          method! visit_statement_kind env k =
+            let empty (b : block) : block = { b with statements = [] } in
+            let k =
+              match k with
+              | Call (c, p, b) -> Call (c, p, empty b)
+              | Drop (p, f, kd, b) -> Drop (p, f, kd, empty b)
+              | DropEmptyBox (p, b) -> DropEmptyBox (p, empty b)
+              | Assert (a, ak, b) -> Assert (a, ak, empty b)
+              | Panic (c, b) -> Panic (c, empty b)
+              | k -> k
+            in
+            super#visit_statement_kind env k
+        end
+      in
+      let new_body = lower_blk (no_unwind#visit_block () body.body) in
+      if false then f
+      else
+        {
+          f with
+          body =
+            StructuredBody
+              { body with body = new_body; locals = { body.locals with locals = !locals } };
+        }
+  | _ -> f
+
+(** forge: lower the loop exits [update_loops] cannot take, linearly.
+
+    [update_loops] removes a [return] from a loop when the loop has no [break], or when the
+    statements after the loop end in a [return] or a panic; it takes no [break i] / [continue i]
+    with [i > 0], and no [return] inside a nested loop. Kernel code has all three (an early
+    [return] or [?] inside a [for] with a [break], a [continue 'outer]). For each loop that has
+    one of these exits (innermost loops first), this pass gives the loop an exit code (a fresh
+    [usize] local, 0 before the loop): the exit sets the code and leaves the loop with [break 0],
+    and after the loop a switch on the code performs the exit there, one loop further out
+    ([return], [break (i - 1)], [continue (i - 1)]). An exit that is still not [update_loops]'
+    is lowered again at the enclosing loop. Loops [update_loops] already takes are left alone,
+    so the translations it already gives are unchanged. The program's behaviour is unchanged,
+    and its size grows linearly. *)
+let lower_loop_exits (_crate : crate) (f : fun_decl) : fun_decl =
+  match f.body with
+  | StructuredBody body ->
+      let locals = ref body.locals.locals in
+      let next = ref (List.length !locals) in
+      let changed = ref false in
+      let fresh span : local_id =
+        let id = LocalId.of_int !next in
+        incr next;
+        locals :=
+          !locals
+          @ [
+              {
+                index = id;
+                name = Some "exit";
+                span;
+                local_ty = TypesUtils.mk_usize_ty;
+                is_mutable = true;
+                borrowck_constraints = [];
+                drop_flag_for = None;
+              };
+            ];
+        id
+      in
+      let place id : place = { kind = PlaceLocal id; ty = TypesUtils.mk_usize_ty } in
+      let cst (n : int) : constant_expr =
+        {
+          kind = CInteger (UnsignedInteger (Usize, Z.of_int n));
+          ty = TypesUtils.mk_usize_ty;
+        }
+      in
+      let mk span kind : statement =
+        { span; statement_id = StatementId.zero; kind; comments_before = [] }
+      in
+      let mkb span statements : block =
+        { span; block_id = BlockId.zero; statements }
+      in
+      let assign span x n = mk span (Assign (place x, Use (Constant (cst n), NoRetag))) in
+      let switch span x (cases : (int * block) list) (default : block) : statement =
+        let data : switch_data =
+          {
+            scrutinee = SwitchValue (Read (place x));
+            branches = List.mapi (fun i (n, _) -> (cst n, BranchId.of_int i)) cases;
+            fallback = Some (BranchId.of_int (List.length cases));
+          }
+        in
+        mk span (Switch (data, List.map snd cases @ [ default ]))
+      in
+      (* The structured children of a statement (not the unwind blocks, which
+         [lower_breakable_blocks] has emptied). *)
+      let children (st : statement) : block list =
+        match st.kind with
+        | Switch (_, bs) -> bs
+        | Loop b -> [ b ]
+        | _ -> []
+      in
+      (* Does the body [b] of a loop have, at [d] loops deep inside it (0: the loop's own level):
+         an exit past the loop (break/continue to an enclosing loop), a return, a break of its own? *)
+      let rec scan d (b : block) (acc : bool * bool * bool * bool) : bool * bool * bool * bool =
+        List.fold_left
+          (fun (past, ret0, retn, brk) (st : statement) ->
+            match st.kind with
+            | Break i -> (past || i > d, ret0, retn, true)
+            | Continue i -> (past || i > d, ret0, retn, brk)
+            | Return -> (past, ret0 || d = 0, retn || d > 0, brk)
+            | Loop lb -> scan (d + 1) lb (past, ret0, retn, brk)
+            | _ ->
+                List.fold_left (fun acc c -> scan d c acc) (past, ret0, retn, brk) (children st))
+          acc b.statements
+      in
+      (* Do the statements after a loop end in a return or a panic ([update_loops]'
+         transformations 2 and 3)? *)
+      let ends_out (after : statement list) : bool =
+        List.exists
+          (fun (st : statement) ->
+            match st.kind with
+            | Return | Panic _ | UnwindTerminate _ | UndefinedBehavior -> true
+            | _ -> false)
+          after
+      in
+      (* Lower the loop with body [b] (inner loops lowered already): the statements in its place *)
+      let lower span (b : block) : statement list =
+        let x = fresh span in
+        let codes : (int * statement_kind) list ref = ref [] in
+        let code_of (k : statement_kind) : int =
+          match List.find_opt (fun (_, k') -> k' = k) !codes with
+          | Some (n, _) -> n
+          | None ->
+              let n = 1 + List.length !codes in
+              codes := !codes @ [ (n, k) ];
+              n
+        in
+        let exit (st : statement) (k : statement_kind) : statement list =
+          [ { (assign st.span x (code_of k)) with comments_before = st.comments_before };
+            { st with kind = Break 0; comments_before = [] } ]
+        in
+        let rec tr d (b : block) : block =
+          {
+            b with
+            statements =
+              List.concat_map
+                (fun (st : statement) ->
+                  match st.kind with
+                  | Break i when i > d -> exit st (Break (i - d - 1))
+                  | Continue i when i > d -> exit st (Continue (i - d - 1))
+                  | Loop lb -> [ { st with kind = Loop (tr (d + 1) lb) } ]
+                  | Switch (data, bs) -> [ { st with kind = Switch (data, List.map (tr d) bs) } ]
+                  | _ -> [ st ])
+                b.statements;
+          }
+        in
+        let b = tr 0 b in
+        let dispatch =
+          switch span x
+            (List.map (fun (n, k) -> (n, mkb span [ mk span k ])) !codes)
+            (mkb span [])
+        in
+        changed := true;
+        [ assign span x 0; mk span (Loop b); dispatch ]
+      in
+      (* A loop [update_loops] cannot take because of a return: a return and a break at its own
+         level, and no return or panic after it in its block *)
+      let stuck (b : block) (after : statement list) : bool =
+        let _, ret0, _, brk = scan 0 b (false, false, false, false) in
+        ret0 && brk && not (ends_out after)
+      in
+      (* Is there such a loop in [sts] (outside any other loop)? *)
+      let rec has_stuck (sts : statement list) : bool =
+        match sts with
+        | [] -> false
+        | st :: after -> (
+            match st.kind with
+            | Loop b -> stuck b after || has_stuck after
+            | Switch (_, bs) -> List.exists (fun (b : block) -> has_stuck b.statements) bs || has_stuck after
+            | _ -> has_stuck after)
+      in
+      let terminal (b : block) : bool =
+        match List.rev b.statements with
+        | { kind = Return | Panic _ | Break _ | Continue _ | UnwindTerminate _ | UndefinedBehavior; _ } :: _ -> true
+        | _ -> false
+      in
+      (* [in_loop]: inside an enclosing loop. A switch with a stuck loop inside gets the statements
+         after it copied into each branch (that does not end in a jump), so that the loop's return
+         is followed, in its block, by the function's own [return]: [update_loops]'
+         transformation 2 then applies. *)
+      let rec lower_stmts (in_loop : bool) (sts : statement list) : statement list =
+        match sts with
+        | [] -> []
+        | st :: after -> (
+            match st.kind with
+            | Switch (data, bs)
+              when (not in_loop) && after <> [] && has_stuck [ { st with kind = Switch (data, bs) } ] ->
+                changed := true;
+                let bs =
+                  List.map
+                    (fun (b : block) ->
+                      if terminal b then b else { b with statements = b.statements @ after })
+                    bs
+                in
+                [ { st with kind = Switch (data, List.map (lower_blk in_loop) bs) } ]
+            | _ ->
+                let here =
+                  match st.kind with
+                  | Loop b ->
+                      let b = lower_blk true b in
+                      let past, _, _, _ = scan 0 b (false, false, false, false) in
+                      if past then lower st.span b else [ { st with kind = Loop b } ]
+                  | Switch (data, bs) ->
+                      [ { st with kind = Switch (data, List.map (lower_blk in_loop) bs) } ]
+                  | _ -> [ st ]
+                in
+                here @ lower_stmts in_loop after)
+      and lower_blk in_loop (b : block) : block =
+        { b with statements = lower_stmts in_loop b.statements }
+      in
+      let new_body = lower_blk false body.body in
+      if not !changed then f
+      else
+        {
+          f with
+          body =
+            StructuredBody
+              { body with body = new_body; locals = { body.locals with locals = !locals } };
+        }
+  | _ -> f

# okuma-genos-m560-v column: behind the spindle from the published spindle-to-column distance; width and depth estimates.
# A stand-in built from published overall dimensions and estimates (not the maker's CAD).
# frame: the machine's base frame at the home pose.
shared x0 = -390
shared y0 = 620
shared z0 = -400
shared L = 780
shared W = 450
shared H = 1660

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (L, W))
}
body = extrude(plan, H)

# haas-tm-1 table: 1213 x 267 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -791.6
shared y0 = -208.6
shared z0 = -164.5
shared lx = 1399.7
shared ly = 357.9
shared lz = 163.5
shared cx = 0
shared cy = 0
shared cw = 1213
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

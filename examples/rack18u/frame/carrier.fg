# RACK-111 rail carrier: L 32 (horizontal) x 40 (vertical) outer, t2, 714 long (SPEC 5.3, rev B R7). x4.
# Part frame: origin on the outer corner line at the front end; a = x along the length, b = y along the
# horizontal leg, c = z up the vertical leg. Horizontal leg: outer face c = 0 (sits on the pan);
# vertical leg: outer face b = 0 (the rail web bears on it). Patterns symmetric about a = 357.
# Shop: hw/shop.fg, copied verbatim (SPEC 10 gap 12).

shared t3 = 3.02
shared t2 = 1.88
shared t1 = 1.52
shared r_scs = 1.6
shared kerf_scs = 0.2                       # not published by SendCutSend; Forge's stand-in
shared hw_scs = [
  hardware(kind: "nut",  size: "M4", sheet: (0.8, 12.7), hole: 5.41, edge: 6.9, max_hardness: ratio(80),
           code: "S-M4-0",   source: "PEM CL bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "nut",  size: "M5", sheet: (0.8, 12.7), hole: 6.35, edge: 7.1, max_hardness: ratio(80),
           code: "SS-M5-0",  source: "PEM CL bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "nut",  size: "M6", sheet: (1.22, 12.7), hole: 8.75, edge: 8.6, max_hardness: ratio(80),
           code: "S-M6-0",   source: "PEM CL bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "stud", size: "M4", sheet: (1.0, 12.7), hole: 4.0, edge: 7.2, max_hardness: ratio(80),
           code: "FH-M4-12", source: "PEM FH bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "stud", size: "M6", sheet: (1.6, 12.7), hole: 6.0, edge: 7.9, max_hardness: ratio(80),
           code: "FH-M6-20", source: "PEM FH bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "stud", size: "M8", sheet: (2.4, 12.7), hole: 8.0, edge: 9.6, max_hardness: ratio(80),
           code: "FH-M8-25", source: "PEM FH bulletin; sendcutsend.com hardware catalog")]
# [R5] stock() limits are per_t(..) values (a plain number is WrongType), as in hw/shop.fg
shared scs = shop([
  stock(t: t3, bend: kfactor(ratio(0.38)), radii: [r_scs], min_flange: per_t(ratio(0), plus: 11.84),
        hole_to_bend: per_t(ratio(0), plus: 5.84), hole_to_edge: per_t(ratio(0), plus: 0.91), min_hole: per_t(ratio(0), plus: 1.02), min_slot: per_t(ratio(0), plus: 1.02), hardness: ratio(57),
        relief: relief_rule(shape: "rect", width: per_t(ratio(1)), depth: 5.13, from: "bend_line",
                            corner: "round", corner_placement: "intersection")),
  stock(t: t2, bend: kfactor(ratio(0.40)), radii: [r_scs], min_flange: per_t(ratio(0), plus: 8.13),
        hole_to_bend: per_t(ratio(0), plus: 4.15), hole_to_edge: per_t(ratio(0), plus: 0.56), min_hole: per_t(ratio(0), plus: 0.71), min_slot: per_t(ratio(0), plus: 0.71), hardness: ratio(57),
        relief: relief_rule(shape: "rect", width: per_t(ratio(1)), depth: 3.99, from: "bend_line",
                            corner: "round", corner_placement: "intersection")),
  stock(t: t1, bend: kfactor(ratio(0.40)), radii: [r_scs], min_flange: per_t(ratio(0), plus: 7.85),
        hole_to_bend: per_t(ratio(0), plus: 4.27), hole_to_edge: per_t(ratio(0), plus: 0.56), min_hole: per_t(ratio(0), plus: 0.71), min_slot: per_t(ratio(0), plus: 0.71), hardness: ratio(57),
        relief: relief_rule(shape: "rect", width: per_t(ratio(1)), depth: 3.61, from: "bend_line",
                            corner: "round", corner_placement: "intersection"))],
  kerf: kerf_scs, hardware: hw_scs)

shared L = 714                  # length (SPEC rev B R7: was 716)
shared bh = 32                  # horizontal leg, outer
shared cv = 40                  # vertical leg, outer
shared n_rail = count(28)       # rail nuts: a = a0 + p k, c = c_rail
shared a0 = 19.5
shared p = 25
shared c_rail = 20
shared a_pan = [57, 357, 657]   # pan nuts at b = b_pan
shared n_pan = count(3)
shared b_pan = 19.12

# the horizontal leg is the base wall: sketch plane z = t2 (its inner face), sheet below it to c = 0;
# the vertical leg turns up off the edge b = 0, its outer sharp on that edge
sketch plan(on: offset(xy, t2)) {
  outline = rect(corner: (0, 0), size: (L, bh))
}
horiz = sheet(plan, t: t2, shop: scs)
vert = flange(horiz.edge(plan.outline[0]), height: cv)

sketch dirs(on: horiz.top) {
  da = line((0, 0), (1, 0), construction: true)
  db = line((0, 0), (0, 1), construction: true)
}
sketch dirc(on: vert.top) {
  dc = line((0, 0), (1, 0), construction: true)
}
# points on the outer faces (the bottoms: their y runs the other way)
sketch fh(on: horiz.bottom) {
  for i in 0..n_pan {
    pn = pt(a_pan[i], -b_pan)
  }
}
sketch fv(on: vert.bottom) {
  for k in 0..n_rail {
    rn = pt(c_rail - t2, -(a0 + p * k))
  }
}
for i in 0..n_pan {
  pan_nut = pem("nut", "M6", at: fh.pn[i], wall: horiz)
}
for k in 0..n_rail {
  rail_nut = pem("nut", "M6", at: fv.rn[k], wall: vert)
}

# placement anchors (SPEC rev B R1: the hw S-M6-0 carries the thread), on the flush outer faces; x in the
# joint face, pointing from the corner along the other leg (rail: +c, pan: +b), so it meets the rail's
# and the pan's anchor x at all four carrier poses
for k in 0..n_rail {
  rail = anchor(plane(at: fv.rn[k], normal: dirs.db.dir, x: dirc.dc.dir))
}
for i in 0..n_pan {
  pan = anchor(plane(at: fh.pn[i], normal: dirc.dc.dir, x: dirs.db.dir))
}

param flat.drop = 80
flat = unfold(horiz, on: offset(horiz.bottom, drop))

# design intent, folded: two straight legs, the 90deg bend's quarter annulus, less 31 holes 8.75;
# the flat: the blank less one bend deduction (K 0.40), less the same holes
shared h_m6 = 8.75
shared hole_area = (n_rail + n_pan) * pi / 4 * h_m6 * h_m6
shared folded_area = (bh + cv - 2 * (r_scs + t2)) * L + pi / 4 * ((r_scs + t2) * (r_scs + t2) - r_scs * r_scs) / t2 * L
shared bd = 2 * (r_scs + t2) - pi / 2 * (r_scs + ratio(0.40) * t2)
shared flat_area = (bh + cv - bd) * L
shared vol = t2 * (folded_area - hole_area + flat_area - hole_area)
expect volume = vol +- 0.1%
expect bodies = 2
expect valid

schematic
measurement = role(kind:"signal", key:"example.sensor.measurement")
logic = role(kind:"signal", key:"example.logic")
Sensor = symbol(pins:{OUT:pin(number:"1",kind:"output",at:(2,0),gives:[measurement])})
Controller = symbol(pins:{P0:pin(number:"7",kind:"bidirectional",at:(-2,0),wants:[logic],functions:{ADC:function(kind:"input",wants:[measurement]), GPIO:function(kind:"input",wants:[logic]), RAW:function(kind:"input")})})
Monitor = symbol(pins:{IN:pin(number:"2",kind:"input",at:(-2,0),wants:[measurement])})
TestPoint = symbol(pins:{PAD:pin(number:"1",kind:"passive",at:(0,0))})
main=sheet()
U1=place(sheet:main,symbol:Sensor,at:(0,0))
U2=place(sheet:main,symbol:Controller,at:(40,0),functions:{P0:ADC})
U3=place(sheet:main,symbol:Monitor,at:(40,16))
TP1=place(sheet:main,symbol:TestPoint,at:(20,-16))
tap=junction(sheet:main,at:(20,0))
src=wire(sheet:main,from:U1.OUT,to:tap)
adc=wire(sheet:main,from:tap,to:U2.P0)
mon=wire(sheet:main,from:tap,to:U3.IN)
probe=wire(sheet:main,from:tap,to:TP1.PAD)
no_monitor=variant(omit:["main/U3"])

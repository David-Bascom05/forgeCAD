# A controller wired to two motor plugs and a sensor: a braided trunk to a clip, a branch to the
# first motor, on to a second clip, branches to the second motor and the sensor; 14 wires of three
# gauges. The harness is written in this file; robot_loom.fg places the same harness from a file
# of its own (loom.fg).
shared out = 20
shared out_ctrl = 45
shared od18 = 2.4
shared od22 = 1.6
shared od26 = 1.1
shared bend18 = 12
shared bend22 = 6
shared bend26 = 4
shared g18 = 18
shared g22 = 22
shared g26 = 26
shared n18 = 16
shared n22 = 7
shared n26 = 7
shared t105 = 105
shared t80 = 80
shared v600 = 600
shared v300 = 300
shared i_motor = 3
shared braid = 0.4
shared slack = ratio(0.03)
shared step = 5
shared seat_in = 4
shared n_ctrl = count(14)
shared n_motor = count(4)
shared n_sens = count(6)
shared wide = 3.5
shared hole_big = 2.8
shared hole_small = 1.4

plate = part("plate.fg", ground: true)
ctrl = part("header.fg", with: {n: n_ctrl, pitch: wide, hd: hole_big})
ma = part("header.fg", with: {n: n_motor, pitch: wide, hd: hole_big})
mb = part("header.fg", with: {n: n_motor, pitch: wide, hd: hole_big})
sn = part("header.fg", with: {n: n_sens, hd: hole_small})
on_ctrl = fastened(ctrl.seat, plate.ctrl_seat, flip: true)
on_ma = fastened(ma.seat, plate.ma_seat, flip: true)
on_mb = fastened(mb.seat, plate.mb_seat, flip: true)
on_sn = fastened(sn.seat, plate.sn_seat, flip: true)

harness loom(slack: slack, round_up: step, insert: seat_in) {
  p18 = wire_type(awg: g18, od: od18, min_bend: bend18, colour: "RD", conductor: "Cu", strands: n18, insulation: "PVC", temp: t105, volts: v600, spec: "UL 1015", spec_tag: "UL1015", source: "example values, not a datasheet")
  s22 = wire_type(awg: g22, od: od22, min_bend: bend22, colour: "WH", conductor: "Cu", strands: n22, insulation: "PVC", temp: t80, volts: v300, spec: "UL 1007", spec_tag: "UL1007", source: "example values, not a datasheet")
  s26 = wire_type(awg: g26, od: od26, min_bend: bend26, colour: "YE", conductor: "Cu", strands: n26, insulation: "PVC", temp: t80, volts: v300, spec: "UL 1007", spec_tag: "UL1007", source: "example values, not a datasheet")

  J1 = connector(ctrl.face, pins: ctrl.pin)
  J2 = connector(ma.face, pins: ma.pin)
  J3 = connector(mb.face, pins: mb.pin)
  J4 = connector(sn.face, pins: sn.pin)

  n1 = node(J1, out: out_ctrl)
  hub1 = node(plate.clip1, along: "x", clip: true)
  hub2 = node(plate.clip2, along: "x", clip: true)
  n2 = node(J2, out: out)
  n3 = node(J3, out: out)
  n4 = node(J4, out: out)

  trunk = segment(n1, hub1, covering: "PET braid 8", wall: braid)
  span = segment(hub1, hub2)
  to_a = segment(hub1, n2)
  to_b = segment(hub2, n3)
  to_s = segment(hub2, n4)

  W1 = wire(J1[1], J2[1], type: p18, colour: "RD", current: i_motor)
  W2 = wire(J1[2], J2[2], type: p18, colour: "BK", current: i_motor)
  W3 = wire(J1[3], J2[3], type: s22, colour: "WH/BU")
  W4 = wire(J1[4], J2[4], type: s22, colour: "BU/WH")
  W5 = wire(J1[5], J3[1], type: p18, colour: "RD", current: i_motor)
  W6 = wire(J1[6], J3[2], type: p18, colour: "BK", current: i_motor)
  W7 = wire(J1[7], J3[3], type: s22, colour: "WH/OG")
  W8 = wire(J1[8], J3[4], type: s22, colour: "OG/WH")
  W9 = wire(J1[9], J4[1], type: s26, colour: "RD")
  W10 = wire(J1[10], J4[2], type: s26, colour: "BK")
  W11 = wire(J1[11], J4[3], type: s26, colour: "YE")
  W12 = wire(J1[12], J4[4], type: s26, colour: "GN")
  W13 = wire(J1[13], J4[5], type: s26, colour: "GN/YE")
  W14 = wire(J1[14], J4[6], type: s26, colour: "VT")
}

expect mobility = 0

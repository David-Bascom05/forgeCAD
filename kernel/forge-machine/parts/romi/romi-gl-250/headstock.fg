# romi-gl-250 headstock: the headstock behind the chuck (estimate).
# A stand-in built from published overall dimensions and estimates (not the maker's CAD).
# frame: the machine's base frame at the home pose.
shared x0 = -177.55
shared y0 = -177.55
shared z0 = -610
shared L = 355.1
shared W = 355.1
shared H = 500

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (L, W))
}
body = extrude(plan, H)

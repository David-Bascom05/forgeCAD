# Buntinx et al. 2014, Polymers 6:3019, CC BY: female tray 190 x 132 top, 10 deg walls, depth 25, floor R1;
# plug + air. Compared on the mean wall only. Notes: buntinx2014_tray25.notes.md.
sketch plan(on: xy) {
  outline = hull(disc((-89.591825, -60.591825), 5.408175), disc((89.591825, -60.591825), 5.408175),
                 disc((89.591825, 60.591825), 5.408175), disc((-89.591825, 60.591825), 5.408175))
}
cav = extrude(plan, -25, taper: 10deg)
floor = fillet(edges(of: cav.end), 1)
part = thermoform(cav, t: 0.4, material: "PP", tool: "female", flange: 15, shrink: ratio(0), vent: false, temperature: 155, pressure: ratio(0.4))

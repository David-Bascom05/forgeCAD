symbol_library

supply_voltage = role(kind: "power", voltage_range_v: [1.8, 5.5])
bypass = role(kind: "bypass", prefer: 3mm, key: "analog.local_bypass")

Amplifier = symbol(
  datasheet: "https://www.ti.com/lit/ds/symlink/tlv9001.pdf",
  fields: {Manufacturer: "Texas Instruments", MPN: "TLV9001IDBVR"},
  pins: {
    INP: pin(description: "Noninverting analog input. Connect the filtered sensor signal here.", number: "3", kind: "input", at: (-7, 3)),
    INM: pin(description: "Inverting analog input. Connect the feedback network here.", number: "4", kind: "input", at: (-7, -3)),
    OUT: pin(description: "Analog output. Feeds the load and feedback path.", number: "1", kind: "output", at: (9, 0)),
    VDD: pin(description: "Positive supply. Bypass to VSS with a capacitor close to the device.", number: "5", kind: "power_in", at: (0, 8), wants: [supply_voltage, bypass]),
    VSS: pin(description: "Negative supply. Connect to ground for single-supply operation.", number: "2", kind: "passive", at: (0, -8))
  },
  graphics: [
    polyline(points: [(-4, 6), (7, 0), (-4, -6), (-4, 6)]),
    text(at: (-3.2, 2.5), value: "+"), text(at: (-3.2, -3.5), value: "-"),
    line(from: (-7, 3), to: (-4, 3)), line(from: (-7, -3), to: (-4, -3)),
    line(from: (7, 0), to: (9, 0)), line(from: (0, 8), to: (0, 3.8)),
    line(from: (0, -8), to: (0, -3.8))
  ]
)
Resistor = symbol(ref_prefix: "R", pins: {
    A: pin(number: "1", kind: "passive", at: (-6, 0)),
    B: pin(number: "2", kind: "passive", at: (6, 0))
  }, graphics: [rect(from: (-3,-1), to: (3,1)), line(from: (-6,0),to:(-3,0)), line(from: (3,0),to:(6,0))])
Capacitor = symbol(ref_prefix: "C", pins: {
    P: pin(description: "Connect to the rail being bypassed.", number: "1", kind: "passive", at: (0, 4), gives: [bypass]),
    N: pin(description: "Connect to the local return.", number: "2", kind: "passive", at: (0, -4))
  }, graphics: [line(from:(0,4),to:(0,0.55)),line(from:(-2.5,0.55),to:(2.5,0.55)),
                 line(from:(-2.5,-0.55),to:(2.5,-0.55)),line(from:(0,-0.55),to:(0,-4))])

# hurco-vmx50i-50t head (unpublished sizes, conservative)
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared ax = 635
shared ay = 330
shared nz = 712
shared nr = 94
shared nh = 159
shared x0 = 446
shared y0 = 141
shared z0 = 871
shared lx = 378
shared ly = 378
shared lz = 379

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
housing = extrude(plan, lz)
sketch nk(on: offset(xy, nz)) {
  c = circle((ax, ay), nr)
}
nose = extrude(nk.c, nh)

+for f in Types Funs FunsExternal_Template TypesExternal_Template; do
+  if [ -f "$work/gen/$f.lean" ]; then cp "$work/gen/$f.lean" "$dest/$f.lean"; else rm -f "$dest/$f.lean"; fi
+done

# milltronics-vm3018 saddle: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.saddle); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -258.58
shared b0y0 = -456.7
shared b0z0 = -179.5
shared b0sx = 517.16
shared b0sy = 456.2
shared b0h = 119

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

# fadal-vmc-2520 head: nose and housing back to the column (sizes unpublished)
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared ax = 323.85
shared ay = 254
shared nz = 636
shared nr = 94
shared nh = 159
shared x0 = 134.85
shared y0 = 65
shared z0 = 795
shared lx = 378
shared ly = 716.4
shared lz = 419

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
housing = extrude(plan, lz)
sketch nk(on: offset(xy, nz)) {
  c = circle((ax, ay), nr)
}
nose = extrude(nk.c, nh)

        (core.slice.index.SliceIndexRangeToUsizeSlice F64)) p1
        { «end» := np }
    let s5 ← lift (Array.to_slice (Array.make 2#usize [ z0, z1 ]))
    let (s6, to_slice_mut_back1) ← lift (Array.to_slice_mut q)
    let (nq, s7) ← predicates.sum_into s4 s5 s6
    let q1 := to_slice_mut_back1 s7
    let s8 ←
      core.array.Array.index (core.ops.index.IndexSlice
        (core.slice.index.SliceIndexRangeToUsizeSlice F64)) q1
        { «end» := nq }
    let e ← predicates.estimate s8
    let b ← core.f64.F64.is_nan e
    if b
    then predicates.dot3_big u v
    else ok e

end forge_math

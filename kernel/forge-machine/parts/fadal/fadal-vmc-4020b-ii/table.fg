# fadal-vmc-4020b-ii table: 47.25 x 19.75 in published, thickness estimated
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -599.075
shared y0 = -249.825
shared z0 = -99
shared lx = 1198.15
shared ly = 499.65
shared lz = 98
shared cx = 0
shared cy = 0
shared cw = 1200.15
shared cl = 18
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

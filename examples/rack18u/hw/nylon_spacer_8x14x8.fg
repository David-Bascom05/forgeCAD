# PA66 spacer 8.2 ID x 14 OD x 8.0 (hinge pins and fan tray hangers)
# source: SPEC section 7 (8.2-8.4 ID x 14 x 8); 8.2 taken so it also bears on the 8.0 shoulder
# frame: origin on the axis in the bottom face; +z through the part

properties(description: "PA66 spacer 8.2 ID x 14 OD x 8.0", material: "PA66")
shared di = 8.2   # inner diameter
shared do = 14   # outer diameter
shared h = 8   # thickness
shared ri = di / 2
shared ro = do / 2
shared zref = h
shared xref = ro
shared nb = 8   # nominal bore size for fit rules

sketch prof(on: xz) {
  o = poly([(ri, 0), (ro, 0), (ro, h), (ri, h)])
  c0 = pt(0, 0)
  pz0 = pt(0, 0)
  pz1 = pt(0, h)
  zax = line((0, 0), (0, zref), construction: true)
  xax = line((0, 0), (xref, 0), construction: true)
}
body = revolve(prof.o, axis: prof.zax)

a = anchor(plane(at: prof.pz0, normal: prof.zax.dir, x: prof.xax.dir))
b = anchor(plane(at: prof.pz1, normal: prof.zax.dir, x: prof.xax.dir))
bore = anchor(plane(at: prof.pz0, normal: prof.zax.dir, x: prof.xax.dir), kind: bore, size: nb, depth: h)

expect valid
expect bodies = 1
expect volume = 809.023 +- 0.05%

pcb
# Small fabrication fixture. The two ground and supply rails have physical pins on both faces.
source = schematic(file: "controller.fg")
perimeter = edge(points: [(0,0),(30,0),(30,18),(0,18)])
window = cutout(points: [(25,13),(28,13),(28,16),(25,16)])
mount = npth(at: (2,2), to: (4,2), drill: 1.6mm)
top = copper(thickness: 0.035mm, weight_oz_ft2: 1)
prepreg = dielectric(material: "FR-4 prepreg", thickness: 0.18mm)
plane = copper(thickness: 0.018mm, weight_oz_ft2: 0.5)
core = dielectric(material: "FR-4 core", thickness: 1.134mm)
inner = copper(thickness: 0.018mm, weight_oz_ft2: 0.5)
lower = dielectric(material: "FR-4 prepreg", thickness: 0.18mm)
bottom = copper(thickness: 0.035mm, weight_oz_ft2: 1)
stack = stackup(layers: [top,prepreg,plane,core,inner,lower,bottom])
prototype = process(min_width: 0.2mm, min_spacing: 0.2mm, min_drill: 0.25mm, min_annular_ring: 0.15mm, min_mask_web: 0.1mm, silk_clearance: 0.15mm, min_edge: 0.25mm, hole_clearance: 0.2mm)
power = net(terminal: "main/u.vdd")
ground = net(terminal: "main/u.vss")

supply_class = net_class(nets: [power], min_width: 0.25mm, min_spacing: 0.25mm)
packages = library(file: "footprints/controller.fg")
reg = place(footprint: packages.header, occurrence: "main/reg", at: (4,8), side: "top")
cap = place(footprint: packages.passives.chip, occurrence: "main/c", at: (12,8), side: "top")
mcu = place(footprint: packages.device, occurrence: "main/u", at: (24,8), side: "bottom", angle: 180deg)

supply_feed = track(net: power, layer: top, width: 0.3mm, points: [(4,6),(12,6),(18,6)])
supply_via = through_via(net: power, at: (18,6), drill: 0.3mm, diameter: 0.65mm, mask_top: 0.05mm)
supply_end = track(net: power, layer: bottom, width: 0.3mm, points: [(18,6),(24,6)])
return_feed = track(net: ground, layer: top, width: 0.3mm, points: [(4,10),(12,10),(18,10)])
return_via = through_via(net: ground, at: (18,10), drill: 0.3mm, diameter: 0.65mm)
return_end = track(net: ground, layer: bottom, width: 0.3mm, points: [(18,10),(24,10)])
shield = zone(layer: plane, net: ground, clearance: 0.25mm, points: [(3,4),(21,4),(21,12),(3,12)])
antenna = keepout(layer: top, points: [(24,14),(25,14),(25,16),(24,16)])
front = silk_text(side: "top", value: "CTRL A", at: (5,14), height: 1.2mm, width: 0.15mm)
back = silk_text(side: "bottom", value: "U1", at: (26,8), height: 1mm, width: 0.15mm)
polarity = silk_line(side: "top", width: 0.15mm, points: [(10.5,5),(13.5,5)])

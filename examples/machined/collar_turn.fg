machining
# collar.fg on the generic lathe from a Ø26 bar: face, rough, finish down to the collar's edge
# (right hand), groove the neck, then a left-hand VBMT finishes up the back chamfer, which faces
# the chuck and no right-hand tool reaches. Placed: G5 in full.
shared bar = 26

f     = part("collar.fg")
t1    = lathe_tool("od-rough-cnmg", t: 1)
t2    = lathe_tool("od-profile-vbmt", t: 2)
t5    = lathe_tool("groove-3", t: 5)
t9    = lathe_tool("od-profile-vbmt-left", t: 9)
jaws  = chuck(face: -55, grip: 30, jaw: 15)
op1   = lathe_setup(f, bar: bar, front: 1, chuck: jaws, machine: "generic-lathe", at: 100,
                    offsets: ((1, 0, 0), (2, 0, 0), (5, 0, 0), (9, 0, 0)))
face  = turn_face(op1, tool: t1, to: 0, step: 1)
rough = turn_rough(op1, tool: t1, leave: 0.3, step: 2, to: -41)
fin   = turn_finish(op1, tool: t2, to: -16)
neck  = turn_groove(op1, tool: t5, from: -30, to: -20, r: 8)
back  = turn_finish(op1, tool: t9, from: -21, to: -16)
prog  = lathe_program(op1, post: "fanuc-lathe", number: 3)

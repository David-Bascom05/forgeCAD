  | cdt.Fault.WalkLostEdge => ok (toStr "walk lost edge")
  | cdt.Fault.RecoveryStuck =>
    ok (toStr "constraint recovery did not converge")
  | cdt.Fault.BoundaryTooLong => ok (toStr "the boundary would take too long")
  | cdt.Fault.CrossedEdgeGone => ok (toStr "crossed edge vanished")
  | cdt.Fault.NotRecovered => ok (toStr "constraint not recovered")
  | cdt.Fault.Untangled => ok (toStr "a tangled boundary did not untangle")
  | cdt.Fault.ChordGone => ok (toStr "a boundary chord vanished")
  | cdt.Fault.LocationFailed => ok (toStr "point location failed")
  | cdt.Fault.RefinementTooLong => ok (toStr "refinement would take too long")
  | cdt.Fault.EdgeTooFine => ok (toStr "an edge would take too many points")
  | cdt.Fault.CrossingsTooFine =>
    ok (toStr "crossing chords would take too many points")
  | cdt.Fault.FaceTooFine => ok (toStr "a face would take too many points")
  | cdt.Fault.OnHull => ok (toStr "a point on the hull")
  | cdt.Fault.InsertedTwice => ok (toStr "a point inserted twice")
  | cdt.Fault.OffHull => ok (toStr "a constraint runs off the hull")
  | cdt.Fault.FaceTooLong => ok (toStr "the face would take too long")
  | cdt.Fault.Subnormal => ok (toStr "a point\'s coordinate is subnormal")
  | cdt.Fault.FarFromOrigin =>
    ok (toStr "points too far from the origin for their spread")
  | cdt.Fault.StaircaseOffNodes =>
    ok (toStr "a grid\'s staircase off its placed nodes")


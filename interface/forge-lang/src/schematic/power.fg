symbol_library

GND = symbol(power_net: "GND", pins: {net: pin(number: "1", kind: "passive", at: (0,0))},
    graphics: [line(from:(0,0),to:(0,-1.4)), polyline(points:[(-1.5,-1.4),(0,-2.9),(1.5,-1.4),(-1.5,-1.4)])])


# ---------------------------------------------------------------------------------------------------
# fit rules (SPEC 8): the shortest whole nut per size; PEM heads pressed into their sheets

shared s_m4 = 4
shared s_m5 = 5
shared s_m6 = 6
shared s_m8 = 8
shared min_m4 = 2.77
shared min_m5 = 2.77
shared min_m6 = 4.78
shared min_m8 = 6.76   # the ISO 10511 M8 nut's whole thread (h max)
m4 = fit_rule(external_thread, internal_thread, size: s_m4, min_engagement: min_m4)
m5 = fit_rule(external_thread, internal_thread, size: s_m5, min_engagement: min_m5)
m6 = fit_rule(external_thread, internal_thread, size: s_m6, min_engagement: min_m6)
m8 = fit_rule(external_thread, internal_thread, size: s_m8, min_engagement: min_m8)
press_fh6 = fit_rule("../hw/pem_fh_m6_20.fg", "../frame/post.fg")
press_fh8 = fit_rule("../hw/pem_fh_m8_25.fg", "../frame/top_pan.fg")

# ---------------------------------------------------------------------------------------------------
# expects (SPEC 8)

# the two other rail positions SPEC 8 runs: (50, 750) and (100, 400)
shared kf_a = count(0)
shared kr_a = count(27)
shared kf_b = count(2)
shared kr_b = count(13)
shared y_f_a = 50
shared y_r_a = 750
shared y_f_b = 100
shared y_r_b = 400
# other dummy positions: D04 at the bottom, D01 just under D02; D01 at the top, D02 under it
shared ud01_a = count(9)
shared ud02_a = count(13)
shared ud04_a = count(1)
shared ud01_b = count(18)
shared ud02_b = count(16)
shared ud04_b = count(5)
shared tol = 0.01
shared tol_x = 0.025            # SPEC: x(RF) - x(LF) = 465.10 +- 0.05, so each side within half
shared tol_j = 0.001
shared x_eia = 232.55
shared z_k0 = 59.30             # U1 bottom 52.95 + 6.35
shared z_k26 = 446.65           # U9 bottom 408.55 + 38.10
shared z_k53 = 846.70           # U18 bottom 808.60 + 38.10
shared c_fan_rail = 20
shared c_tray_car = 5
shared c_tip = 1.5
shared c_dummy_fan = 5
shared conc = 0.1
shared x_fan = 70               # fan centres (SPEC 1): x +-70, y 330 and 470
shared y_fan_f = 330
shared y_fan_r = 470
shared d_bore = 114             # grille bars in each air column (fans/test_air.fg): the 114 disc of floor
shared rg = 56                  # less the 11 slots (6 wide on 9.5, ends on a 112 circle)
shared sp = 9.5
shared ws = 6
shared ns = count(11)
shared q0 = sqrt(rg ^ 2 - (ws / 2) ^ 2)
shared q1 = sqrt(rg ^ 2 - (sp + ws / 2) ^ 2)
shared q2 = sqrt(rg ^ 2 - (2 * sp + ws / 2) ^ 2)
shared q3 = sqrt(rg ^ 2 - (3 * sp + ws / 2) ^ 2)
shared q4 = sqrt(rg ^ 2 - (4 * sp + ws / 2) ^ 2)
shared q5 = sqrt(rg ^ 2 - (5 * sp + ws / 2) ^ 2)
shared grille_a = ns * pi * (ws / 2) ^ 2 + ws * (2 * q0 + 4 * (q1 + q2 + q3 + q4 + q5) - ns * ws)
shared blocked = t3 * (pi / 4 * d_bore ^ 2 - grille_a)


# frame: every solved origin on its SPEC 5 pose
# orientation: a second point of each turned part

# the R8 pairs not used as joints: coincident (rail on carrier) or 3.02 apart (post on pan, carrier on pan)

# EIA alignment (SPEC 8), at each rail position; each SPEC difference as both ends' absolute positions

# equipment (SPEC 8): each dummy's other three ear holes on their rail holes, the 4U clear of the fan

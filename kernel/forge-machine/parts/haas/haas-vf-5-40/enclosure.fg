# haas-vf-5-40 enclosure (display only: Haas's model drawn in its place)
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -1097.6
shared y0 = -787.4
shared z0 = -818.7
shared lx = 3481.3
shared ly = 2312.2
shared lz = 2975.5

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)

# tormach-1500mx head: nose cylinder and housing back to the column (sizes unpublished)
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared ax = 250
shared ay = 175
shared nz = 451
shared nr = 54
shared nh = 119
shared x0 = 131
shared y0 = 56
shared z0 = 570
shared lx = 238
shared ly = 363
shared lz = 299

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
housing = extrude(plan, lz)
sketch nk(on: offset(xy, nz)) {
  c = circle((ax, ay), nr)
}
nose = extrude(nk.c, nh)

# sherline-8540 table: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.table); not the maker's CAD.
# frame: the machine's base frame at the home pose.
# the table top plate; T-slots are inside the box
shared b0x0 = -274.5
shared b0y0 = -98
shared b0z0 = -19.5
shared b0sx = 329
shared b0sy = 69
shared b0h = 19

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

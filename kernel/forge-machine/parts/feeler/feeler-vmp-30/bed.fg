# feeler-vmp-30 bed: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.bed); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -311
shared b0y0 = -629.5
shared b0z0 = -379.5
shared b0sx = 622
shared b0sy = 1399
shared b0h = 199

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

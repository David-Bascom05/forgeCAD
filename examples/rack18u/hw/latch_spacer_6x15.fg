# steel round spacer 6.0 OD x 4.3 ID x 15.0 (latch link posts)
# source: SPEC 5.8 / section 7 (spec only, no part number)
# frame: origin on the axis in the bottom face; +z through the part

shared di = 4.3   # inner diameter
shared do = 6   # outer diameter
shared h = 15   # thickness
shared ri = di / 2
shared ro = do / 2
shared zref = h
shared xref = ro

sketch prof(on: xz) {
  o = poly([(ri, 0), (ro, 0), (ro, h), (ri, h)])
  c0 = pt(0, 0)
  pz0 = pt(0, 0)
  pz1 = pt(0, h)
  zax = line((0, 0), (0, zref), construction: true)
  xax = line((0, 0), (xref, 0), construction: true)
}
body = revolve(prof.o, axis: prof.zax)

a = anchor(plane(at: prof.pz0, normal: prof.zax.dir, x: prof.xax.dir))
b = anchor(plane(at: prof.pz1, normal: prof.zax.dir, x: prof.xax.dir))

expect valid
expect bodies = 1
expect volume = 206.285 +- 0.05%

# haas-vf-3 table: 1219 x 457 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -613.5
shared y0 = -254.3
shared z0 = -213.4
shared lx = 1227
shared ly = 508.6
shared lz = 212.4
shared cx = 0
shared cy = 0
shared cw = 1219
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

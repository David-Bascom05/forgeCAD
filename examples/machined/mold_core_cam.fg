machining
# mold_core.fg, 3-axis from the top: z-level roughing with a 10 mm flat (0.5 left), then parallel
# finishing with a 6 mm ball, waterlines on the steep walls, a pencil pass in the foot's
# fillet, and rest finishing of what the 10 mm left. Every move certified (column route).
shared tol = 0.01

f     = part("mold_core.fg", group: "N")
m     = machine("generic-vmc3")
t1    = tool("flat-10", t: 1, stickout: 40, holder: "bt40-er32")
t2    = tool("ball-6", t: 2, stickout: 40, holder: "bt40-er32")
op1   = setup(f, machine: m, stock: box(margin: (0, 0, 2)), origin: "top-center", tol: tol, at: (-200, -150, -250))
rough = zlevel(op1, tool: t1, leave: 0.5, step: 3, stepover: 4, area: (-45, -35, 45, 35), grid: 1)
fin   = parallel(op1, tool: t2, stepover: 1, area: (-30, -24, 30, 24))
walls = waterline(op1, tool: t2, from: 24, to: 12, step: 2, area: (-30, -24, 30, 24), grid: 0.5)
corner = pencil(op1, tool: t2, area: (-30, -24, 30, 24), grid: 0.5)
left  = rest(op1, tool: t2, after: t1, stepover: 1, area: (-30, -24, 30, 24), grid: 0.5)
prog  = program(op1, post: "fanuc", number: 1002)

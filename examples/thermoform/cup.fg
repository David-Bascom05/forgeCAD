# A deep drinking cup modelled as a solid (its outside), drawn into a female mould: deeper than it
# is wide, so the draw checks speak.
shared t = 1
shared r = 32
shared D = 75
shared lean = 3deg
shared rb = 6
sketch footprint(on: xy) {
  rim = circle((0, 0), r)
}
cup = extrude(footprint, -D, taper: lean)
base = fillet(edges(of: cup.end), rb)
part = thermoform(cup, t: t, material: "PETG", tool: "female")

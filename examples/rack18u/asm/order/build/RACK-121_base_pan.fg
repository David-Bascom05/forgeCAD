# RACK-121 base pan: 591 x 724 outer, t3, 30 flanges up (SPEC 5.2). x1. Pose: origin (0, 400, 0),
# x -> +X, y -> +Y, z -> +Z. Carries the posts' lower studs, the bottom carriers and the casters.

# Part frame: origin at the centre of the floor's outer face; x, y in the floor, z into the pan (towards
# the flanges). Outer box x +-295.46, y +-361.98, z 0..30. Generated by gen_pans.py: edit that, not this.
# Shop: hw/shop.fg, copied verbatim (SPEC 10 gap 12).

shared t3 = 3.02
shared t2 = 1.88
shared t1 = 1.52
shared r_scs = 1.6
shared kerf_scs = 0.2                       # not published by SendCutSend; Forge's stand-in
shared hw_scs = [
  hardware(kind: "nut",  size: "M4", sheet: (0.8, 12.7), hole: 5.41, edge: 6.9, max_hardness: ratio(80),
           code: "S-M4-0",   source: "PEM CL bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "nut",  size: "M5", sheet: (0.8, 12.7), hole: 6.35, edge: 7.1, max_hardness: ratio(80),
           code: "SS-M5-0",  source: "PEM CL bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "nut",  size: "M6", sheet: (1.22, 12.7), hole: 8.75, edge: 8.6, max_hardness: ratio(80),
           code: "S-M6-0",   source: "PEM CL bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "stud", size: "M4", sheet: (1.0, 12.7), hole: 4.0, edge: 7.2, max_hardness: ratio(80),
           code: "FH-M4-12", source: "PEM FH bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "stud", size: "M6", sheet: (1.6, 12.7), hole: 6.0, edge: 7.9, max_hardness: ratio(80),
           code: "FH-M6-20", source: "PEM FH bulletin; sendcutsend.com hardware catalog"),
  hardware(kind: "stud", size: "M8", sheet: (2.4, 12.7), hole: 8.0, edge: 9.6, max_hardness: ratio(80),
           code: "FH-M8-25", source: "PEM FH bulletin; sendcutsend.com hardware catalog")]
# [R5] stock() limits are per_t(..) values (a plain number is WrongType), as in hw/shop.fg
shared scs = shop([
  stock(t: t3, bend: kfactor(ratio(0.38)), radii: [r_scs], min_flange: per_t(ratio(0), plus: 11.84),
        hole_to_bend: per_t(ratio(0), plus: 5.84), hole_to_edge: per_t(ratio(0), plus: 0.91), min_hole: per_t(ratio(0), plus: 1.02), min_slot: per_t(ratio(0), plus: 1.02), hardness: ratio(57),
        relief: relief_rule(shape: "rect", width: per_t(ratio(1)), depth: 5.13, from: "bend_line",
                            corner: "round", corner_placement: "intersection")),
  stock(t: t2, bend: kfactor(ratio(0.40)), radii: [r_scs], min_flange: per_t(ratio(0), plus: 8.13),
        hole_to_bend: per_t(ratio(0), plus: 4.15), hole_to_edge: per_t(ratio(0), plus: 0.56), min_hole: per_t(ratio(0), plus: 0.71), min_slot: per_t(ratio(0), plus: 0.71), hardness: ratio(57),
        relief: relief_rule(shape: "rect", width: per_t(ratio(1)), depth: 3.99, from: "bend_line",
                            corner: "round", corner_placement: "intersection")),
  stock(t: t1, bend: kfactor(ratio(0.40)), radii: [r_scs], min_flange: per_t(ratio(0), plus: 7.85),
        hole_to_bend: per_t(ratio(0), plus: 4.27), hole_to_edge: per_t(ratio(0), plus: 0.56), min_hole: per_t(ratio(0), plus: 0.71), min_slot: per_t(ratio(0), plus: 0.71), hardness: ratio(57),
        relief: relief_rule(shape: "rect", width: per_t(ratio(1)), depth: 3.61, from: "bend_line",
                            corner: "round", corner_placement: "intersection"))],
  kerf: kerf_scs, hardware: hw_scs)

shared W = 590.92               # outer box
shared D = 723.96
shared H = 30                   # flange height, outer
shared z_stud = 15              # post stud clearances in the flanges
shared y_stud = 340             # side flanges
shared x_stud = 273.48          # front and rear flanges
shared d_m6 = 6.6
shared x_car = 271              # carrier screws in the floor, 6.6
shared y_car = [-300, 0, 300]
shared n_car = count(3)
shared cut_x = 125              # rear cable cut-out: x -cut_x..cut_x, y cut_y0..cut_y1, corner radius cut_r
shared cut_y0 = 250
shared cut_y1 = 310
shared cut_r = 10

# the floor is the base wall: sketch plane z = t3 (its inner face), sheet below it to z = 0; four
# flanges up, each with its outer sharp on its edge (outer box = the outline)
sketch plan(on: offset(xy, t3)) {
  outline = rect(center: (0, 0), size: (W, D))
}
floor = sheet(plan, t: t3, shop: scs)
front = flange(floor.edge(plan.outline[0]), height: H)
right = flange(floor.edge(plan.outline[1]), height: H)
rear = flange(floor.edge(plan.outline[2]), height: H)
left = flange(floor.edge(plan.outline[3]), height: H)

sketch dirs(on: floor.top) {
  dx = line((0, 0), (1, 0), construction: true)
  dy = line((0, 0), (0, 1), construction: true)
  dmx = line((0, 0), (-1, 0), construction: true)
  dmy = line((0, 0), (0, -1), construction: true)
}
sketch dirz(on: front.top) {
  dz = line((0, 0), (1, 0), construction: true)
}

# post stud clearances. Each hole is sketched on its flange's outer face with the sketch origin moved to
# the hole's foot on the floor's inner face (x up the flange, from the floor's inner face).
sketch feet(on: floor.top) {
  fl_f = pt(-x_stud, -D / 2)
  fr_f = pt(x_stud, -D / 2)
  rl_r = pt(-x_stud, D / 2)
  rr_r = pt(x_stud, D / 2)
  fl_s = pt(-W / 2, -y_stud)
  rl_s = pt(-W / 2, y_stud)
  fr_s = pt(W / 2, -y_stud)
  rr_s = pt(W / 2, y_stud)
}
sketch h_fl_f(on: front.bottom, at: feet.fl_f) {
  c = circle((z_stud - t3, 0), d_m6 / 2)
}
sketch h_fr_f(on: front.bottom, at: feet.fr_f) {
  c = circle((z_stud - t3, 0), d_m6 / 2)
}
sketch h_rl_r(on: rear.bottom, at: feet.rl_r) {
  c = circle((z_stud - t3, 0), d_m6 / 2)
}
sketch h_rr_r(on: rear.bottom, at: feet.rr_r) {
  c = circle((z_stud - t3, 0), d_m6 / 2)
}
sketch h_fl_s(on: left.bottom, at: feet.fl_s) {
  c = circle((z_stud - t3, 0), d_m6 / 2)
}
sketch h_rl_s(on: left.bottom, at: feet.rl_s) {
  c = circle((z_stud - t3, 0), d_m6 / 2)
}
sketch h_fr_s(on: right.bottom, at: feet.fr_s) {
  c = circle((z_stud - t3, 0), d_m6 / 2)
}
sketch h_rr_s(on: right.bottom, at: feet.rr_s) {
  c = circle((z_stud - t3, 0), d_m6 / 2)
}
cut_fl_f = cutout(h_fl_f, wall: front)
cut_fr_f = cutout(h_fr_f, wall: front)
cut_rl_r = cutout(h_rl_r, wall: rear)
cut_rr_r = cutout(h_rr_r, wall: rear)
cut_fl_s = cutout(h_fl_s, wall: left)
cut_rl_s = cutout(h_rl_s, wall: left)
cut_fr_s = cutout(h_fr_s, wall: right)
cut_rr_s = cutout(h_rr_s, wall: right)
# anchors (corner letters in the base pan's orientation; SPEC 5.2): origin on the flange's outer face,
# normal into the pan, x along +z (out of the floor)
stud_fl_f = anchor(plane(at: h_fl_f.c.center, normal: dirs.dy.dir, x: dirz.dz.dir))
stud_fr_f = anchor(plane(at: h_fr_f.c.center, normal: dirs.dy.dir, x: dirz.dz.dir))
stud_rl_r = anchor(plane(at: h_rl_r.c.center, normal: dirs.dmy.dir, x: dirz.dz.dir))
stud_rr_r = anchor(plane(at: h_rr_r.c.center, normal: dirs.dmy.dir, x: dirz.dz.dir))
stud_fl_s = anchor(plane(at: h_fl_s.c.center, normal: dirs.dx.dir, x: dirz.dz.dir))
stud_rl_s = anchor(plane(at: h_rl_s.c.center, normal: dirs.dx.dir, x: dirz.dz.dir))
stud_fr_s = anchor(plane(at: h_fr_s.c.center, normal: dirs.dmx.dir, x: dirz.dz.dir))
stud_rr_s = anchor(plane(at: h_rr_s.c.center, normal: dirs.dmx.dir, x: dirz.dz.dir))

# carrier screws, from outside: origin on the outer face z = 0, normal +z, x outward (car_l -x, car_r +x),
# so it meets the carrier's pan anchor x (+b) in both pans
sketch car(on: floor.bottom) {
  for i in 0..n_car {
    l = circle((-x_car, -y_car[i]), d_m6 / 2)
    r = circle((x_car, -y_car[i]), d_m6 / 2)
  }
}
car_holes = cutout(car, wall: floor)
for i in 0..n_car {
  car_l = anchor(plane(at: car.l[i].center, normal: dirz.dz.dir, x: dirs.dmx.dir))
  car_r = anchor(plane(at: car.r[i].center, normal: dirz.dz.dir, x: dirs.dx.dir))
}

# the rear cable cut-out
sketch cable(on: floor.top) {
  path o(start: (cut_r - cut_x, cut_y0)) {
    line(to: (cut_x - cut_r, cut_y0))
    tarc(to: (cut_x, cut_y0 + cut_r))
    line(to: (cut_x, cut_y1 - cut_r))
    tarc(to: (cut_x - cut_r, cut_y1))
    line(to: (cut_r - cut_x, cut_y1))
    tarc(to: (-cut_x, cut_y1 - cut_r))
    line(to: (-cut_x, cut_y0 + cut_r))
    tarc(to: (cut_r - cut_x, cut_y0))
  }
}
cable_cut = cutout(cable, wall: floor)

# caster bolts, 9.0: four round each kingpin, at kingpin + (+-dx_cb, +-dy_cb)
shared kx = 185
shared ky = 300
shared dx_cb = 22.5
shared dy_cb = 37.5
shared d_m8 = 9
shared kings = {fl: (-kx, -ky), fr: (kx, -ky), rl: (-kx, ky), rr: (kx, ky)}
sketch cb(on: floor.top) {
  for c, k in kings {
    a = circle((k[0] - dx_cb, k[1] - dy_cb), d_m8 / 2)
    b = circle((k[0] + dx_cb, k[1] - dy_cb), d_m8 / 2)
    e = circle((k[0] - dx_cb, k[1] + dy_cb), d_m8 / 2)
    f = circle((k[0] + dx_cb, k[1] + dy_cb), d_m8 / 2)
  }
}
caster_holes = cutout(cb, wall: floor)
sketch kp(on: floor.bottom) {
  fl = pt(-kx, ky)
  fr = pt(kx, ky)
  rl = pt(-kx, -ky)
  rr = pt(kx, -ky)
}
# anchors: origin at the kingpin on the outer face, normal +z (into the pan, as the caster's top: SPEC R9), x along +x
caster_fl = anchor(plane(at: kp.fl, normal: dirz.dz.dir, x: dirs.dx.dir))
caster_fr = anchor(plane(at: kp.fr, normal: dirz.dz.dir, x: dirs.dx.dir))
caster_rl = anchor(plane(at: kp.rl, normal: dirz.dz.dir, x: dirs.dx.dir))
caster_rr = anchor(plane(at: kp.rr, normal: dirz.dz.dir, x: dirs.dx.dir))

shared holes = 8 * pi / 4 * d_m6 * d_m6 + 6 * pi / 4 * d_m6 * d_m6 + 16 * pi / 4 * d_m8 * d_m8


# design intent, folded: the floor inside the bends, four flanges (H - r - t) tall on the same lengths,
# four quarter annuli along them, less the holes and the cable cut-out; the four corner reliefs (about
# 3 x 10 each) are inside the tolerance. The flat is the folded body less A t^2 (1/2 - K) per bend length.
shared corner_k = 4 - pi            # a square less its inscribed circle, per r^2
shared lw = W - 2 * (r_scs + t3)
shared ld = D - 2 * (r_scs + t3)
shared cable_area = (2 * cut_x) * (cut_y1 - cut_y0) - corner_k * cut_r * cut_r
shared folded = t3 * (lw * ld + 2 * (lw + ld) * (H - r_scs - t3) - holes - cable_area) + pi / 4 * ((r_scs + t3) * (r_scs + t3) - r_scs * r_scs) * 2 * (lw + ld)
shared vol = 2 * folded - pi / 2 * t3 * t3 * (ratio(0.5) - ratio(0.38)) * 2 * (lw + ld)

schematic
lib = library(file: "symbols.fg")

front = sheet(title: "48 V input and protection")
logic = sheet(title: "STM32, debug and CAN FD")
monitor = sheet(title: "Temperature and analog filters")
aux = sheet(title: "Independent 3.3 V buck")
ch1 = sheet(title: "Fan 1  /  short protection and telemetry")
ch2 = sheet(title: "Fan 2  /  short protection and telemetry")
ch3 = sheet(title: "Fan 3  /  short protection and telemetry")
ch4 = sheet(title: "Fan 4  /  short protection and telemetry")
ch5 = sheet(title: "Fan 5  /  short protection and telemetry")
ch6 = sheet(title: "Fan 6  /  short protection and telemetry")
main = sheet(title: "Shared 12 V synchronous buck")
block_logic = subsheet(sheet: front, of: logic, at: (-115,-110))
block_monitor = subsheet(sheet: front, of: monitor, at: (-25,-110))
block_aux = subsheet(sheet: front, of: aux, at: (65,-110))
block_ch1 = subsheet(sheet: front, of: ch1, at: (-115,-152))
block_ch2 = subsheet(sheet: front, of: ch2, at: (-25,-152))
block_ch3 = subsheet(sheet: front, of: ch3, at: (65,-152))
block_ch4 = subsheet(sheet: front, of: ch4, at: (-115,-194))
block_ch5 = subsheet(sheet: front, of: ch5, at: (-25,-194))
block_ch6 = subsheet(sheet: front, of: ch6, at: (65,-194))
block_main = subsheet(sheet: front, of: main, at: (-115,-236))


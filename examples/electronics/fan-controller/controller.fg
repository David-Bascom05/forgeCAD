schematic
lib = library(file: "symbols.fg")
power = sheet(title: "48 V input and isolated fan supply")
logic = sheet(title: "Controller and CAN FD interface")
fans = sheet(title: "Six fan channels")
control = subsheet(sheet: power, of: logic, at: (-45,-61))
outputs = subsheet(sheet: power, of: fans, at: (35,-61))


# hyundai-wia-kf5600 column: behind the spindle from the published spindle-to-column distance; width and depth estimates.
# A stand-in built from published overall dimensions and estimates (not the maker's CAD).
# frame: the machine's base frame at the home pose.
shared x0 = -375
shared y0 = 620
shared z0 = -400
shared L = 750
shared W = 450
shared H = 1720

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (L, W))
}
body = extrude(plan, H)

assembly

# RACK-18U top assembly (SPEC section 9F). Every part hangs off the base pan by its joints: the SPEC 5
# poses are where the solve starts, and the R8 pairs and R9 turns/offsets are what put each part there.
# One joint per part (a tree); every other anchor pair of a joined part is a distance expect.
# Rails move by one SetParam on a Count param (SPEC 6.3 fallback: an anchor index from a Length param is
# not a Count): k_front, k_rear are the carrier rail-nut indices counted from the front.

# rails (SPEC 6.3): rail_front = 50 + 25 k_front (50..450), rail_rear = 75 + 25 k_rear (350..750)
shared k_front = count(2)
shared k_rear = count(26)
shared k_last = count(27)
shared pitch = 25
shared y0_front = 50
shared y0_rear = 75
shared rail_front = y0_front + pitch * k_front
shared rail_rear = y0_rear + pitch * k_rear

# dummies (SPEC 5.11): the lowest U of each
shared u_d01 = count(1)
shared u_d02 = count(10)
shared u_d04 = count(15)
shared n_d01 = count(1)
shared n_d02 = count(2)
shared n_d04 = count(4)
shared u_h = 44.45
shared z_u1 = 52.95

shared t1 = 1.52
shared t2 = 1.88
shared t3 = 3.02
shared t_ear = 3
shared t_pw = 1
shared drop = 12.62             # tray top face to the top pan's outer face (R4)

# ---------------------------------------------------------------------------------------------------
# frame (SPEC 5.1-5.4)

base_pan = part("../frame/base_pan.fg", body: "floor", ground: true, at: pose(at: (0, 400, 0), z: (0, 0, 1), x: (1, 0, 0)))
top_pan = part("../frame/top_pan.fg", body: "floor", at: pose(at: (0, 400, 906), z: (0, 0, -1), x: (-1, 0, 0)))

post_fl = subassembly("post_kit.fg", at: pose(at: (-298.48, 35, 0), z: (0, 0, 1), x: (1, 0, 0)))
post_fr = subassembly("post_kit.fg", at: pose(at: (298.48, 35, 0), z: (0, 0, 1), x: (0, 1, 0)))
post_rr = subassembly("post_kit.fg", at: pose(at: (298.48, 765, 0), z: (0, 0, 1), x: (-1, 0, 0)))
post_rl = subassembly("post_kit.fg", at: pose(at: (-298.48, 765, 0), z: (0, 0, 1), x: (0, -1, 0)))
# R9: post stud[0] -> base pan stud, turn 0, along -3.02; R8 pairs at the base
j_post_fl = slider(post_fl.post.stud_a[0], base_pan.stud_fl_f, along: -t3)
j_post_fr = slider(post_fr.post.stud_a[0], base_pan.stud_fr_s, along: -t3)
j_post_rr = slider(post_rr.post.stud_a[0], base_pan.stud_rr_r, along: -t3)
j_post_rl = slider(post_rl.post.stud_a[0], base_pan.stud_rl_s, along: -t3)
# the top pan on post FL's upper front stud (R8: the turned pan's stud_fr_f lands at FL)
j_top = slider(top_pan.stud_fr_f, post_fl.post.stud_a[1], along: t3)

car_bl = subassembly("carrier_kit.fg", at: pose(at: (-251.88, 43, 3.02), z: (0, 0, 1), x: (0, 1, 0)))
car_br = subassembly("carrier_kit.fg", at: pose(at: (251.88, 757, 3.02), z: (0, 0, 1), x: (0, -1, 0)))
car_tl = subassembly("carrier_kit.fg", at: pose(at: (-251.88, 757, 902.98), z: (0, 0, -1), x: (0, -1, 0)))
car_tr = subassembly("carrier_kit.fg", at: pose(at: (251.88, 43, 902.98), z: (0, 0, -1), x: (0, 1, 0)))
# R9: carrier pan[i] -> pan car_*, along +3.02; R8: BR and TL run -Y, so pan[0] meets car_*[2]
j_car_bl = slider(car_bl.carrier.pan[0], base_pan.car_l[0], along: t3)
j_car_br = slider(car_br.carrier.pan[0], base_pan.car_r[2], along: t3)
j_car_tr = slider(car_tr.carrier.pan[0], top_pan.car_l[0], along: t3)
j_car_tl = slider(car_tl.carrier.pan[0], top_pan.car_r[2], along: t3)
# carrier screws, ISO 7380 M6 x 12 from outside each pan (R2)
for i in 0..3 {
  scr_bl = part("../hw/iso7380_m6x12.fg")
  at_scr_bl = fastened(scr_bl.head, base_pan.car_l[i])
  scr_br = part("../hw/iso7380_m6x12.fg")
  at_scr_br = fastened(scr_br.head, base_pan.car_r[i])
  scr_tr = part("../hw/iso7380_m6x12.fg")
  at_scr_tr = fastened(scr_tr.head, top_pan.car_l[i])
  scr_tl = part("../hw/iso7380_m6x12.fg")
  at_scr_tl = fastened(scr_tl.head, top_pan.car_r[i])
}

rail_lf = part("../frame/rail.fg", body: "mount", at: pose(at: (-251.88, 100, 8), z: (0, 0, 1), x: (1, 0, 0)))
rail_rf = part("../frame/rail.fg", body: "mount", at: pose(at: (251.88, 100, 898), z: (0, 0, -1), x: (-1, 0, 0)))
rail_rr = part("../frame/rail.fg", body: "mount", at: pose(at: (251.88, 725, 8), z: (0, 0, 1), x: (-1, 0, 0)))
rail_lr = part("../frame/rail.fg", body: "mount", at: pose(at: (-251.88, 725, 898), z: (0, 0, -1), x: (1, 0, 0)))
# R8: web_bot[0] of each rail on its lower-index carrier nut (the r -Z rails have web_bot at the top)
j_rail_lf = fastened(rail_lf.web_bot[0], car_bl.carrier.rail[k_front])
j_rail_rf = fastened(rail_rf.web_bot[0], car_tr.carrier.rail[k_front])
j_rail_rr = fastened(rail_rr.web_bot[0], car_br.carrier.rail[k_last - k_rear])
j_rail_lr = fastened(rail_lr.web_bot[0], car_tl.carrier.rail[k_last - k_rear])
# rail screws, ISO 7380 M6 x 10 from inside the web: head t2 behind the web anchor
for i in 0..2 {
  rs_bot_lf = part("../hw/iso7380_m6x10.fg")
  at_rs_bot_lf = slider(rs_bot_lf.head, rail_lf.web_bot[i], along: -t2)
  rs_top_lf = part("../hw/iso7380_m6x10.fg")
  at_rs_top_lf = slider(rs_top_lf.head, rail_lf.web_top[i], along: -t2)
}
for i in 0..2 {
  rs_bot_rf = part("../hw/iso7380_m6x10.fg")
  at_rs_bot_rf = slider(rs_bot_rf.head, rail_rf.web_bot[i], along: -t2)
  rs_top_rf = part("../hw/iso7380_m6x10.fg")
  at_rs_top_rf = slider(rs_top_rf.head, rail_rf.web_top[i], along: -t2)
}
for i in 0..2 {
  rs_bot_rr = part("../hw/iso7380_m6x10.fg")
  at_rs_bot_rr = slider(rs_bot_rr.head, rail_rr.web_bot[i], along: -t2)
  rs_top_rr = part("../hw/iso7380_m6x10.fg")
  at_rs_top_rr = slider(rs_top_rr.head, rail_rr.web_top[i], along: -t2)
}
for i in 0..2 {
  rs_bot_lr = part("../hw/iso7380_m6x10.fg")
  at_rs_bot_lr = slider(rs_bot_lr.head, rail_lr.web_bot[i], along: -t2)
  rs_top_lr = part("../hw/iso7380_m6x10.fg")
  at_rs_top_lr = slider(rs_top_lr.head, rail_lr.web_top[i], along: -t2)
}

# ---------------------------------------------------------------------------------------------------
# fan tray (SPEC 5.9 rev B): hanger stacks in the top pan, the fan subassembly on them

for k in 0..4 {
  hang_stud = part("../hw/pem_fh_m8_25.fg")
  at_hang_stud = fastened(hang_stud.flush, top_pan.hang[k])
  hang_spacer = part("../hw/nylon_spacer_8x14x8.fg")
  at_hang_spacer = slider(hang_spacer.a, top_pan.hang[k], along: t3)
  hang_washer = part("../hw/iso7089_8.fg")
  at_hang_washer = fastened(hang_washer.a, hang_spacer.b)
}
fans = subassembly("../fans/fan_assy.fg", at: pose(at: (0, 400, 893.38)))
# R8: tray.hang[k] meets pan.hang[k xor 1]
j_fans = slider(fans.tray.hang[1], top_pan.hang[0], along: drop)
for k in 0..4 {
  hang_nut = part("../hw/iso10511_m8.fg")
  at_hang_nut = slider(hang_nut.seat, fans.tray.hang[k], along: t2)
  # reference: each fan's air column up to the pan's outer face (fans/standin), to measure the grille bars
  air = part("../fans/standin/air_column.fg", reference: true)
  at_air = fastened(air.base, fans.fan[k].out)
  vent = fit(air, top_pan)
}

# ---------------------------------------------------------------------------------------------------
# equipment (SPEC 5.11): dummies on the front rails, 4 cage nuts and 4 rack screws each. Ear holes:
# ear[0] left bottom, ear[1] left top, ear[2] right bottom, ear[3] right top. Left front rail hole
# k = 3 (U - 1) + j; the flipped right rail's is 53 - k (R9: its eia x runs down).

d01 = part("dummy_d01.fg", reference: true, at: pose(at: (0, 100, z_u1)))
d02 = part("dummy_d02.fg", reference: true, at: pose(at: (0, 100, z_u1 + u_h * 9)))
d04 = part("dummy_d04.fg", reference: true, at: pose(at: (0, 100, z_u1 + u_h * 14)))
j_d01 = fastened(d01.ear[0], rail_lf.eia[3 * (u_d01 - 1)])
j_d02 = fastened(d02.ear[0], rail_lf.eia[3 * (u_d02 - 1)])
j_d04 = fastened(d04.ear[0], rail_lf.eia[3 * (u_d04 - 1)])
# d01: left rail holes 3 (U - 1) and 3 (U + n) - 4; right rail 53 - those
cage_d01_0 = part("../hw/cage_nut_m6.fg")
at_cage_d01_0 = slider(cage_d01_0.seat, rail_lf.eia[3 * (u_d01 - 1)], along: t2)
cage_d01_1 = part("../hw/cage_nut_m6.fg")
at_cage_d01_1 = slider(cage_d01_1.seat, rail_lf.eia[3 * (u_d01 + n_d01) - 4], along: t2)
cage_d01_2 = part("../hw/cage_nut_m6.fg")
at_cage_d01_2 = slider(cage_d01_2.seat, rail_rf.eia[53 - 3 * (u_d01 - 1)], along: t2)
cage_d01_3 = part("../hw/cage_nut_m6.fg")
at_cage_d01_3 = slider(cage_d01_3.seat, rail_rf.eia[53 - (3 * (u_d01 + n_d01) - 4)], along: t2)
for j in 0..4 {
  pw_d01 = part("../hw/plastic_washer_m6.fg")
  at_pw_d01 = slider(pw_d01.a, d01.ear[j], along: -(t_ear + t_pw))
  rs_d01 = part("../hw/rack_screw_m6x16.fg")
  at_rs_d01 = fastened(rs_d01.head, pw_d01.a)
}
# d02: left rail holes 3 (U - 1) and 3 (U + n) - 4; right rail 53 - those
cage_d02_0 = part("../hw/cage_nut_m6.fg")
at_cage_d02_0 = slider(cage_d02_0.seat, rail_lf.eia[3 * (u_d02 - 1)], along: t2)
cage_d02_1 = part("../hw/cage_nut_m6.fg")
at_cage_d02_1 = slider(cage_d02_1.seat, rail_lf.eia[3 * (u_d02 + n_d02) - 4], along: t2)
cage_d02_2 = part("../hw/cage_nut_m6.fg")
at_cage_d02_2 = slider(cage_d02_2.seat, rail_rf.eia[53 - 3 * (u_d02 - 1)], along: t2)
cage_d02_3 = part("../hw/cage_nut_m6.fg")
at_cage_d02_3 = slider(cage_d02_3.seat, rail_rf.eia[53 - (3 * (u_d02 + n_d02) - 4)], along: t2)
for j in 0..4 {
  pw_d02 = part("../hw/plastic_washer_m6.fg")
  at_pw_d02 = slider(pw_d02.a, d02.ear[j], along: -(t_ear + t_pw))
  rs_d02 = part("../hw/rack_screw_m6x16.fg")
  at_rs_d02 = fastened(rs_d02.head, pw_d02.a)
}
# d04: left rail holes 3 (U - 1) and 3 (U + n) - 4; right rail 53 - those
cage_d04_0 = part("../hw/cage_nut_m6.fg")
at_cage_d04_0 = slider(cage_d04_0.seat, rail_lf.eia[3 * (u_d04 - 1)], along: t2)
cage_d04_1 = part("../hw/cage_nut_m6.fg")
at_cage_d04_1 = slider(cage_d04_1.seat, rail_lf.eia[3 * (u_d04 + n_d04) - 4], along: t2)
cage_d04_2 = part("../hw/cage_nut_m6.fg")
at_cage_d04_2 = slider(cage_d04_2.seat, rail_rf.eia[53 - 3 * (u_d04 - 1)], along: t2)
cage_d04_3 = part("../hw/cage_nut_m6.fg")
at_cage_d04_3 = slider(cage_d04_3.seat, rail_rf.eia[53 - (3 * (u_d04 + n_d04) - 4)], along: t2)
for j in 0..4 {
  pw_d04 = part("../hw/plastic_washer_m6.fg")
  at_pw_d04 = slider(pw_d04.a, d04.ear[j], along: -(t_ear + t_pw))
  rs_d04 = part("../hw/rack_screw_m6x16.fg")
  at_rs_d04 = fastened(rs_d04.head, pw_d04.a)
}

# ---------------------------------------------------------------------------------------------------
# panels, doors (SPEC 5.5-5.8, 6.1) and casters (5.10, 6.2): written by gen_rack.py from panels/ and
# casters/ (Forge cannot drive a subassembly's joints from its parent, so the door and caster blocks are
# flattened here, one copy per door and per corner)
# BEGIN GENERATED panels
# END GENERATED panels
# BEGIN GENERATED casters
# casters (SPEC 5.10, 6.2): casters/caster_lock.fg at the front, caster_plain.fg at the rear, flattened
# (prefix fl_, fr_, rl_, rr_) so each corner's swivel, roll and brake are this file's drives. The
# plate is fastened to the base pan's caster_* anchor [R9]; 4 ISO 4017 M8 x 20 up through plate and
# pan, ISO 7089-8 and ISO 10511 M8 inside the pan.
shared cs_ru = 25   # upper ball row pitch radius (written poses)
shared cs_zu = 5.38
shared cs_au = 15deg
shared cs_rl = 18   # lower ball row
shared cs_zl = 12.64
shared cs_al = 18deg
shared cs_pr = 7.5   # 608 pitch radius
shared cs_ab = 51.428571deg
shared cs_k_race = ratio(-0.5)   # ball rows: orbit at half the swivel, the same way (Forge's gear turns the follower by -ratio)
shared cs_k_cage = ratio(-0.632300)   # 608 cage: (1 + Dw/dm)/2 = 0.6323 of the outer ring, inner ring fixed
shared cs_brake_lo = 0deg
shared cs_brake_hi = 20deg   # pedal down: shoe on the tread, pin in a notch
shared cs_lift_lo = 0
shared cs_lift_hi = 4   # lock pin travel
shared cs_r_cam = 11.459156   # lock pin lift per radian of pedal: 4.0 at 20deg
shared t_plate = 3
shared t_pan = 3.02

# ---- caster FL (caster_lock) ----
shared fl_swivel_turn = 0deg
shared fl_roll = 0deg
shared fl_brake = 0deg
fl_plate = part("../casters/plate.fg", at: pose(at: (0, 0, 0)))
fl_kpin = part("../casters/kingpin.fg", at: pose(at: (0, 0, 0)))
fl_race = part("../casters/lower_race.fg", at: pose(at: (0, 0, 0)))
fl_yoke = part("../casters/yoke.fg", at: pose(at: (0, 0, 0)))
fl_fix_kpin = fastened(fl_kpin.cf, fl_plate.top)
fl_fix_race = fastened(fl_race.cf, fl_plate.top)
fl_swivel = revolute(fl_yoke.kingpin, fl_plate.kingpin, turn: fl_swivel_turn)
fl_f_kpin = fit(fl_kpin, fl_plate)
fl_f_race = fit(fl_kpin, fl_race)
for i in 0..24 {
  fl_ub = part("../casters/ball_4763.fg", at: pose(at: (0 + cs_ru * cos(cs_au * i), 0 + cs_ru * sin(cs_au * i), -cs_zu), rz: cs_au * i))
  fl_up = revolute(fl_ub.uorb, fl_plate.uorb[i])
  fl_up_rel = gear(fl_swivel, fl_up, ratio: cs_k_race)
  fl_f_ub = fit(fl_ub, fl_yoke)
}
for i in 0..20 {
  fl_lb = part("../casters/ball_4763.fg", at: pose(at: (0 + cs_rl * cos(cs_al * i), 0 + cs_rl * sin(cs_al * i), -cs_zl), rz: cs_al * i))
  fl_lo = revolute(fl_lb.lorb, fl_plate.lorb[i])
  fl_lo_rel = gear(fl_swivel, fl_lo, ratio: cs_k_race)
  fl_f_lb = fit(fl_lb, fl_yoke)
}
fl_axle = part("../hw/iso4014_m8x55.fg", at: pose(at: (-20.7, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_nut = part("../hw/iso10511_m8.fg", at: pose(at: (20.7, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_fix_axle = fastened(fl_axle.head, fl_yoke.axle_head)
fl_fix_nut = fastened(fl_nut.seat, fl_yoke.axle_nut)
fl_f_axle = fit(fl_axle, fl_yoke)
fl_f_nut = fit(fl_nut, fl_yoke)
fl_sp_l = part("../casters/spacer.fg", at: pose(at: (-18.2, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_sp_r = part("../casters/spacer.fg", at: pose(at: (3.5, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_fix_sp_l = fastened(fl_sp_l.a, fl_yoke.sp_l)
fl_fix_sp_r = fastened(fl_sp_r.a, fl_yoke.sp_r)
fl_f_sp_l = fit(fl_sp_l, fl_yoke)
fl_f_sp_r = fit(fl_sp_r, fl_yoke)
fl_bi = part("../casters/bearing_inner.fg", at: pose(at: (0, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_ring_in = fastened(fl_bi.ax, fl_yoke.axle)
fl_f_bi_axle = fit(fl_bi, fl_axle)
fl_f_bi_sp_l = fit(fl_bi, fl_sp_l)
fl_f_bi_sp_r = fit(fl_bi, fl_sp_r)
fl_hub = part("../casters/hub.fg", at: pose(at: (0, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_wheel = revolute(fl_hub.ax, fl_yoke.axle, turn: fl_roll)
fl_tread = part("../casters/tread.fg", at: pose(at: (0, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_fix_tread = fastened(fl_tread.ax, fl_hub.ax)
fl_f_tread = fit(fl_tread, fl_hub)
fl_bo = part("../casters/bearing_outer.fg", at: pose(at: (0, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_ring_out = fastened(fl_bo.ax, fl_hub.ax)
fl_f_bo = fit(fl_bo, fl_hub)
fl_cage_a = part("../casters/cage_half.fg", at: pose(at: (0, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_cage = revolute(fl_cage_a.ax, fl_yoke.axle)
fl_cage_rel = gear(fl_wheel, fl_cage, ratio: cs_k_cage)
fl_cage_b = part("../casters/cage_half.fg", at: pose(at: (0, -40, -71), z: (-1, 0, 0), x: (0, 1, 0)))
fl_fix_cage_b = fastened(fl_cage_b.ax, fl_cage_a.ax, flip: true)
fl_f_cage = fit(fl_cage_a, fl_cage_b)
for i in 0..7 {
  fl_bb = part("../casters/ball_3969.fg", at: pose(at: (0, -40 + cs_pr * cos(cs_ab * i), -71 + cs_pr * sin(cs_ab * i)), z: (1, 0, 0), x: (0, 1, 0)))
  fl_ball_fix = fastened(fl_bb.c, fl_cage_a.pocket_at[i])
  fl_f_bb_in = fit(fl_bb, fl_bi)
  fl_f_bb_out = fit(fl_bb, fl_bo)
}
fl_seal_a = part("../casters/seal.fg", at: pose(at: (0, -40, -71), z: (1, 0, 0), x: (0, 1, 0)))
fl_seal_b = part("../casters/seal.fg", at: pose(at: (0, -40, -71), z: (-1, 0, 0), x: (0, 1, 0)))
fl_fix_seal_a = fastened(fl_seal_a.ax, fl_bo.ax)
fl_fix_seal_b = fastened(fl_seal_b.back, fl_bo.ax)
fl_f_seal_a_out = fit(fl_seal_a, fl_bo)
fl_f_seal_a_in = fit(fl_seal_a, fl_bi)
fl_f_seal_b_out = fit(fl_seal_b, fl_bo)
fl_f_seal_b_in = fit(fl_seal_b, fl_bi)
fl_lever = part("../casters/pedal.fg", at: pose(at: (0, 0, 0)))
fl_pedal = revolute(fl_lever.pivot, fl_yoke.pedal_pin, turn: fl_brake, limit: (cs_brake_lo, cs_brake_hi))
fl_ppin = part("../casters/pedal_pin.fg", at: pose(at: (0, 0, 0)))
fl_fix_ppin = fastened(fl_ppin.cf, fl_yoke.kingpin)
fl_f_ppin = fit(fl_ppin, fl_yoke)
fl_lpin = part("../casters/lock_pin.fg", at: pose(at: (0, 0, 0)))
fl_lockpin = slider(fl_lpin.ax, fl_yoke.lock_guide, limit: (cs_lift_lo, cs_lift_hi))
fl_pin_rel = rack_pinion(fl_pedal, fl_lockpin, radius: cs_r_cam)
fl_f_cam = fit(fl_lever, fl_lpin)
fl_f_shoe = fit(fl_lever, fl_tread)
at_fl_caster = fastened(fl_plate.top, base_pan.caster_fl)
fl_on_pan = fit(fl_plate, base_pan)
for k in 0..4 {
  fl_cbolt = part("../hw/iso4017_m8x20.fg")
  at_fl_cbolt = fastened(fl_cbolt.head, fl_plate.bolt[k])
  fl_cwsh = part("../hw/iso7089_8.fg")
  at_fl_cwsh = slider(fl_cwsh.a, fl_plate.bolt[k], along: t_plate + t_pan)
  fl_cnut = part("../hw/iso10511_m8.fg")
  at_fl_cnut = fastened(fl_cnut.seat, fl_cwsh.b)
}

# ---- caster FR (caster_lock) ----
shared fr_swivel_turn = 0deg
shared fr_roll = 0deg
shared fr_brake = 0deg
fr_plate = part("../casters/plate.fg", at: pose(at: (0, 0, 0)))
fr_kpin = part("../casters/kingpin.fg", at: pose(at: (0, 0, 0)))
fr_race = part("../casters/lower_race.fg", at: pose(at: (0, 0, 0)))
fr_yoke = part("../casters/yoke.fg", at: pose(at: (0, 0, 0)))
fr_fix_kpin = fastened(fr_kpin.cf, fr_plate.top)
fr_fix_race = fastened(fr_race.cf, fr_plate.top)
fr_swivel = revolute(fr_yoke.kingpin, fr_plate.kingpin, turn: fr_swivel_turn)
fr_f_kpin = fit(fr_kpin, fr_plate)
fr_f_race = fit(fr_kpin, fr_race)
for i in 0..24 {

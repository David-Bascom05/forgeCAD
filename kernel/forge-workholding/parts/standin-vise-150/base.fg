# standin-vise-150 (a stand-in: see data/standins.toml) base: the body under the jaws (400 long along the clamp axis, 150 wide,
# 50 high: the vise's height less the jaws'), with the screw channel and the bed's slot.
# frame: the body's corner at the origin, the clamp axis along x.
shared L = 400
shared W = 150
shared H = 50
param channel.w = 40
param channel.d = 20

sketch plan(on: xy) {
  outline = rect(corner: (0, 0), size: (L, W))
}
body = extrude(plan, H)
sketch top(on: body.end) {
  groove = rect(corner: (20, (W - w) / 2), size: (L - 40, w))
}
channel = cut(top.groove, d)

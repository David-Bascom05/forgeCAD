def place.then
  (m : place.Place) (inner : place.Place) : Result place.Place := do
  let (ox, oy) ← place.apply m inner.ox inner.oy
  let (xx, xy) ← place.vec m inner.xx inner.xy
  ok { ox, oy, xx, xy }


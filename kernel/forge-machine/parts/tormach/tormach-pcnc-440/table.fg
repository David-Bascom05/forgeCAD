# tormach-pcnc-440 table: 458 x 160 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -228
shared y0 = -79
shared z0 = -59
shared lx = 456
shared ly = 158
shared lz = 58
shared cx = 0
shared cy = 0
shared cw = 458
shared cl = 16
shared cd = 12

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

# tormach-pcnc-440 column: its face at the published centreline distance; size unpublished
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -199
shared y0 = 245.375
shared z0 = -359
shared lx = 398
shared ly = 248
shared lz = 1383

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)

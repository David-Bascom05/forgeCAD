# Erdogan & Eksi 2014, Strojniski vestnik 60(3):195: HIPS 825E 2.5 mm, 180 C, female cylinder 200 x 100, vacuum only.
# Assumptions: erdogan2014_cylinder.notes.md.
sketch plan(on: xy) {
  rim = circle((0, 0), 100)
}
cav = extrude(plan, -100, taper: 4.9deg)
floor = fillet(edges(of: cav.end), 14)
part = thermoform(cav, t: 2.5, material: "HIPS", tool: "female", flange: 40, shrink: ratio(0), vent: false, temperature: 180, pressure: ratio(0.09))

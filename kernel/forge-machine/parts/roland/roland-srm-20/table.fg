# roland-srm-20 table: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.table); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -217.2
shared b0y0 = -154
shared b0z0 = -19.5
shared b0sx = 231.2
shared b0sy = 155.6
shared b0h = 19

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

# haas-tm-0 table: 975 x 267 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -486.5
shared y0 = -132.5
shared z0 = -89
shared lx = 973
shared ly = 265
shared lz = 88
shared cx = 0
shared cy = 0
shared cw = 975
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

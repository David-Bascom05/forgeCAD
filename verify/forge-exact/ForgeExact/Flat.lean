import ForgeExact.Regular
import ForgeExact.Ref.Geom

/-!
# Flat faces: polyhedral solids over ℚ and the arrangement of their planes

Step 2 of the exact reference (research/kernel-audit/README.md §6.2, stage 1).

* Space is ℚ³ (`Ref.V3`, the executable's own points). Its topology is the one generated by open
  half-spaces: a set is open when each of its points lies in a finite intersection of open
  half-spaces inside it. Boxes are intersections of six half-spaces, so this is the Euclidean
  topology.
* A polyhedral solid is a boolean formula over open half-spaces (`HForm`): every flat-faced
  solid is one (Nef's polyhedra), and its planes are its faces' carriers.
* `arrangement ps`: the cells of a list of planes are its sign patterns (a point of a cell is
  strictly on the given side of every plane), the wall is the union of the planes.

Theorems:
* `wall_nowhereDense` : a finite union of planes is nowhere dense;
* `HForm.den_iff_onSigns` : on a cell, a formula's membership is its value on the sign pattern
  (classification by enumerating sign patterns);
* `arrangement` : for any family of solids whose planes are among `ps`, the sign-pattern cells
  are a compatible decomposition (`Decomposition`);
* `flat_boolean` : so for every pointwise boolean `op`, the regularised union of the patterns
  `op` keeps, computed on the patterns alone, is the regularised boolean of the solids.
-/

namespace ForgeExact.Flat

open ForgeExact Topology Ref

/-! ## Rational facts -/

theorem qabs_nonneg (a : Rat) : 0 ≤ qabs a := by unfold qabs; split <;> grind
theorem le_qabs (a : Rat) : a ≤ qabs a := by unfold qabs; split <;> grind
theorem neg_le_qabs (a : Rat) : -a ≤ qabs a := by unfold qabs; split <;> grind
theorem qmin_le_left (a b : Rat) : qmin a b ≤ a := by unfold qmin; split <;> grind
theorem qmin_le_right (a b : Rat) : qmin a b ≤ b := by unfold qmin; split <;> grind

theorem mul_self_nonneg' (a : Rat) : 0 ≤ a * a := by
  by_cases h : 0 ≤ a
  · exact Rat.mul_nonneg h h
  · have h' : 0 ≤ -a := by grind
    have := Rat.mul_nonneg h' h'
    have e : -a * -a = a * a := by grind
    rw [e] at this; exact this

theorem div_pos' {a b : Rat} (ha : 0 < a) (hb : 0 < b) : 0 < a / b := by
  rw [Rat.div_def]; exact Rat.mul_pos ha (Rat.inv_pos.mpr hb)

/-- A positive `a` stays positive under a step `s * b` with `0 < s ≤ a / (2 (|b| + 1))`. -/
theorem pos_of_small {a b s : Rat} (ha : 0 < a) (hs : 0 < s) (hle : s ≤ a / (2 * (qabs b + 1))) :
    0 < a + s * b := by
  have hd : 0 < 2 * (qabs b + 1) := by have := qabs_nonneg b; grind
  have h1 : s * (2 * (qabs b + 1)) ≤ a := by
    have := Rat.mul_le_mul_of_nonneg_left hle (Rat.le_of_lt hd)
    rw [Rat.mul_comm (2 * (qabs b + 1)) s, Rat.mul_comm (2 * (qabs b + 1)),
      Rat.div_mul_cancel (Rat.ne_of_gt hd)] at this
    exact this
  have h2 : 0 ≤ s * (b + qabs b) := by
    apply Rat.mul_nonneg (Rat.le_of_lt hs)
    have := neg_le_qabs b; grind
  have e1 : s * (2 * (qabs b + 1)) = 2 * (s * qabs b) + 2 * s := by grind
  have e2 : s * (b + qabs b) = s * b + s * qabs b := by grind
  grind

/-! ## Components -/

@[simp] theorem add_x (a b : V3) : (a + b).x = a.x + b.x := rfl
@[simp] theorem add_y (a b : V3) : (a + b).y = a.y + b.y := rfl
@[simp] theorem add_z (a b : V3) : (a + b).z = a.z + b.z := rfl
@[simp] theorem smul_x (k : Rat) (a : V3) : (k * a).x = k * a.x := rfl
@[simp] theorem smul_y (k : Rat) (a : V3) : (k * a).y = k * a.y := rfl
@[simp] theorem smul_z (k : Rat) (a : V3) : (k * a).z = k * a.z := rfl

/-! ## The topology of ℚ³ -/

/-- Strictly on the positive side of every plane of the list. -/
def allPos (hs : List Plane) : Pred V3 := fun x => ∀ h ∈ hs, h.eval x > 0

instance topology : Topology V3 where
  IsOpen U := ∀ x, U x → ∃ hs : List Plane, allPos hs x ∧ (allPos hs).Sub U
  isOpen_univ := fun _ _ => ⟨[], ⟨fun _ hm => by simp at hm, fun _ _ => trivial⟩⟩
  isOpen_inter U V hU hV := fun x ⟨hu, hv⟩ =>
    let ⟨a, ha, hsa⟩ := hU x hu
    let ⟨b, hb, hsb⟩ := hV x hv
    ⟨a ++ b, fun h hm => (List.mem_append.mp hm).elim (ha h) (hb h),
      fun y hy => ⟨hsa y fun h hm => hy h (List.mem_append_left _ hm),
        hsb y fun h hm => hy h (List.mem_append_right _ hm)⟩⟩
  isOpen_sUnion F hF := fun x ⟨U, hFU, hUx⟩ =>
    let ⟨hs, h1, h2⟩ := hF U hFU x hUx
    ⟨hs, h1, fun y hy => ⟨U, hFU, h2 y hy⟩⟩

theorem isOpen_allPos (hs : List Plane) : Topology.IsOpen (allPos hs) :=
  fun _ hx => ⟨hs, hx, fun _ hy => hy⟩

/-! ## Planes -/

/-- The plane with its sides swapped. -/
def _root_.ForgeExact.Ref.Plane.neg (p : Plane) : Plane := ⟨(-1 : Rat) * p.n, -p.c⟩

theorem eval_neg (p : Plane) (x : V3) : p.neg.eval x = -p.eval x := by
  simp only [Plane.neg, Plane.eval, V3.dot, smul_x, smul_y, smul_z]; grind

/-- The plane, oriented so that `x` is on its positive side (when `x` is off it). -/
def _root_.ForgeExact.Ref.Plane.toward (p : Plane) (x : V3) : Plane := if p.eval x > 0 then p else p.neg

theorem toward_pos (p : Plane) {x : V3} (h : p.eval x ≠ 0) : (p.toward x).eval x > 0 := by
  unfold Plane.toward; split
  · assumption
  · rw [eval_neg]; grind

theorem toward_ne (p : Plane) {x y : V3} (h : (p.toward x).eval y > 0) : p.eval y ≠ 0 := by
  unfold Plane.toward at h; split at h
  · grind
  · rw [eval_neg] at h; grind

/-- The plane's value along a straight step: `eval (x + s d) = eval x + s (n · d)`. -/
theorem eval_step (p : Plane) (x d : V3) (s : Rat) :
    p.eval (x + s * d) = p.eval x + s * p.n.dot d := by
  simp only [Plane.eval, V3.dot, add_x, add_y, add_z, smul_x, smul_y, smul_z]; grind

theorem norm2_pos {n : V3} (h : n ≠ ⟨0, 0, 0⟩) : 0 < n.dot n := by
  obtain ⟨a, b, c⟩ := n
  simp only [V3.dot]
  have ha := mul_self_nonneg' a
  have hb := mul_self_nonneg' b
  have hc := mul_self_nonneg' c
  apply Classical.byContradiction
  intro hn
  have h0 : a * a = 0 ∧ b * b = 0 ∧ c * c = 0 := by grind
  have : a = 0 ∧ b = 0 ∧ c = 0 :=
    ⟨(Rat.mul_eq_zero.mp h0.1).elim id id, (Rat.mul_eq_zero.mp h0.2.1).elim id id, (Rat.mul_eq_zero.mp h0.2.2).elim id id⟩
  exact h (by rw [this.1, this.2.1, this.2.2])

/-- A step size that keeps every plane of `hs` positive, given `x` on their positive sides. -/
def stepFor (x d : V3) : List Plane → Rat
  | [] => 1
  | h :: t => qmin (h.eval x / (2 * (qabs (h.n.dot d) + 1))) (stepFor x d t)

theorem stepFor_pos (x d : V3) : ∀ hs : List Plane, allPos hs x → 0 < stepFor x d hs
  | [], _ => by simp [stepFor]; decide
  | h :: t, hp => by
    simp only [stepFor]
    have h1 : 0 < h.eval x / (2 * (qabs (h.n.dot d) + 1)) := by
      have := qabs_nonneg (h.n.dot d)
      exact div_pos' (hp h (List.mem_cons_self ..)) (by grind)
    have h2 := stepFor_pos x d t fun g hg => hp g (List.mem_cons_of_mem _ hg)
    unfold qmin; split <;> assumption

theorem stepFor_le (x d : V3) : ∀ hs : List Plane, ∀ h ∈ hs,
    stepFor x d hs ≤ h.eval x / (2 * (qabs (h.n.dot d) + 1))
  | [], _, hm => nomatch hm
  | g :: t, h, hm => by
    simp only [stepFor]
    rcases List.mem_cons.mp hm with rfl | hm
    · exact qmin_le_left _ _
    · exact Rat.le_trans (qmin_le_right _ _) (stepFor_le x d t h hm)

/-- In any basic open set there is a point off a given plane. -/
theorem escape_one (hs : List Plane) (p : Plane) (hp : p.n ≠ ⟨0, 0, 0⟩) {x : V3}
    (hx : allPos hs x) : ∃ y, allPos hs y ∧ p.eval y ≠ 0 := by
  by_cases h0 : p.eval x = 0
  · let s := stepFor x p.n hs
    have hs0 := stepFor_pos x p.n hs hx
    refine ⟨x + s * p.n, fun h hm => ?_, ?_⟩
    · rw [eval_step]
      exact pos_of_small (hx h hm) hs0 (stepFor_le x p.n hs h hm)
    · rw [eval_step, h0]
      have := Rat.mul_pos hs0 (norm2_pos hp)
      grind
  · exact ⟨x, hx, h0⟩

/-- In any basic open set there is a point off every plane of a list. -/
theorem escape (ps : List Plane) (hps : ∀ p ∈ ps, p.n ≠ ⟨0, 0, 0⟩) :
    ∀ (hs : List Plane) (x : V3), allPos hs x → ∃ y, allPos hs y ∧ ∀ p ∈ ps, p.eval y ≠ 0 := by
  induction ps with
  | nil => exact fun hs x hx => ⟨x, hx, fun _ h => nomatch h⟩
  | cons p ps ih =>
    intro hs x hx
    obtain ⟨y0, hy0, hp0⟩ := escape_one hs p (hps p (List.mem_cons_self ..)) hx
    have hy0' : allPos (p.toward y0 :: hs) y0 := fun h hm =>
      (List.mem_cons.mp hm).elim (fun e => e ▸ toward_pos p hp0) (hy0 h)
    obtain ⟨y, hy, hoff⟩ := ih (fun q hq => hps q (List.mem_cons_of_mem _ hq)) _ _ hy0'
    refine ⟨y, fun h hm => hy h (List.mem_cons_of_mem _ hm), fun q hq => ?_⟩
    rcases List.mem_cons.mp hq with rfl | hq
    · exact toward_ne q (hy _ (List.mem_cons_self ..))
    · exact hoff q hq

/-! ## The arrangement -/

/-- The wall: the union of the planes. -/
def wall (ps : List Plane) : Pred V3 := fun x => ∃ p ∈ ps, p.eval x = 0

/-- Off the wall, a whole open set is off it. -/
theorem closure_wall_sub (ps : List Plane) : (closure (wall ps)).Sub (wall ps) := by
  intro x hx
  apply Classical.byContradiction
  intro hoff
  have hne : ∀ p ∈ ps, p.eval x ≠ 0 := fun p hp h => hoff ⟨p, hp, h⟩
  obtain ⟨y, hy, p, hp, hpy⟩ :=
    hx (allPos (ps.map fun p => p.toward x)) (isOpen_allPos _) fun h hm => by
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hm
      exact toward_pos p (hne p hp)
  exact toward_ne p (hy _ (List.mem_map.mpr ⟨p, hp, rfl⟩)) hpy

/-- A finite union of planes is nowhere dense. -/
theorem wall_nowhereDense (ps : List Plane) (hps : ∀ p ∈ ps, p.n ≠ ⟨0, 0, 0⟩) :
    NowhereDense (wall ps) := by
  intro x ⟨U, hU, hUsub, hxU⟩
  obtain ⟨hs, hxs, hsU⟩ := hU x hxU
  obtain ⟨y, hy, hoff⟩ := escape ps hps hs x hxs
  obtain ⟨p, hp, h0⟩ := closure_wall_sub ps y (hUsub y (hsU y hy))
  exact hoff p hp h0

/-- The cell of a sign pattern: strictly on the given side of each plane. -/
def cellOf : List Plane → List Bool → Pred V3
  | [], [] => fun _ => True
  | p :: ps, b :: bs => fun x => (if b then p.eval x > 0 else p.eval x < 0) ∧ cellOf ps bs x
  | _, _ => fun _ => False

/-- Every sign pattern of length `n`. -/
def patterns : Nat → List (List Bool)
  | 0 => [[]]
  | n + 1 => (patterns n).flatMap fun l => [true :: l, false :: l]

/-- The pattern of a point. -/
def patternOf (ps : List Plane) (x : V3) : List Bool := ps.map fun p => decide (p.eval x > 0)

theorem patternOf_mem (ps : List Plane) (x : V3) : patternOf ps x ∈ patterns ps.length := by
  induction ps with
  | nil => simp [patternOf, patterns]
  | cons p ps ih =>
    simp only [patternOf, List.map_cons, List.length_cons, patterns, List.mem_flatMap]
    refine ⟨patternOf ps x, ih, ?_⟩
    cases decide (p.eval x > 0) <;> simp [patternOf]

theorem cellOf_patternOf (ps : List Plane) (x : V3) (h : ¬wall ps x) :
    cellOf ps (patternOf ps x) x := by
  induction ps with
  | nil => trivial
  | cons p ps ih =>
    simp only [patternOf, List.map_cons, cellOf]
    refine ⟨?_, ih fun ⟨q, hq, h0⟩ => h ⟨q, List.mem_cons_of_mem _ hq, h0⟩⟩
    have : p.eval x ≠ 0 := fun h0 => h ⟨p, List.mem_cons_self .., h0⟩
    by_cases hp : p.eval x > 0
    · simp [hp]
    · simp [hp]; grind

/-- The side of plane `p` a pattern gives, read at its first occurrence in `ps`. -/
def signOf : List Plane → List Bool → Plane → Bool
  | q :: ps, b :: bs, p => if q = p then b else signOf ps bs p
  | _, _, _ => false

theorem signOf_iff : ∀ (ps : List Plane) (σ : List Bool) (p : Plane) (x : V3),
    p ∈ ps → cellOf ps σ x → (p.eval x > 0 ↔ signOf ps σ p = true)
  | [], _, _, _, hm, _ => nomatch hm
  | q :: ps, [], _, _, _, hc => hc.elim
  | q :: ps, b :: bs, p, x, hm, ⟨hq, hc⟩ => by
    simp only [signOf]
    by_cases e : q = p
    · subst e; simp only [ite_true]
      cases b
      · simp at hq ⊢; grind
      · simp at hq ⊢; exact hq
    · simp only [e, ite_false]
      exact signOf_iff ps bs p x ((List.mem_cons.mp hm).resolve_left (Ne.symm e)) hc

/-- A polyhedral solid: a boolean formula over open half-spaces. -/
inductive HForm
  | half (p : Plane)
  | not (f : HForm)
  | and (f g : HForm)
  | or (f g : HForm)

namespace HForm

/-- Its point set. -/
def den : HForm → Pred V3
  | half p => fun x => p.eval x > 0
  | not f => fun x => ¬f.den x
  | and f g => fun x => f.den x ∧ g.den x
  | or f g => fun x => f.den x ∨ g.den x

/-- Its planes. -/
def planes : HForm → List Plane
  | half p => [p]
  | not f => f.planes
  | and f g => f.planes ++ g.planes
  | or f g => f.planes ++ g.planes

/-- Its value on a sign pattern of `ps`: no point needed. -/
def onSigns (ps : List Plane) (σ : List Bool) : HForm → Bool
  | half p => signOf ps σ p
  | not f => !f.onSigns ps σ
  | and f g => f.onSigns ps σ && g.onSigns ps σ
  | or f g => f.onSigns ps σ || g.onSigns ps σ

/-- **Classification by sign patterns.** On a cell, membership is the formula's value on the
cell's pattern. -/
theorem den_iff_onSigns (ps : List Plane) (σ : List Bool) (x : V3) (hx : cellOf ps σ x) :
    ∀ f : HForm, (∀ p ∈ f.planes, p ∈ ps) → (f.den x ↔ f.onSigns ps σ = true)
  | half p, h => signOf_iff ps σ p x (h p (List.mem_singleton_self _)) hx
  | not f, h => by
    simp only [den, onSigns, Bool.not_eq_true']
    rw [den_iff_onSigns ps σ x hx f h]; cases f.onSigns ps σ <;> simp
  | and f g, h => by
    simp only [den, onSigns, Bool.and_eq_true]
    rw [den_iff_onSigns ps σ x hx f fun p hp => h p (List.mem_append_left _ hp),
      den_iff_onSigns ps σ x hx g fun p hp => h p (List.mem_append_right _ hp)]
  | or f g, h => by
    simp only [den, onSigns, Bool.or_eq_true]
    rw [den_iff_onSigns ps σ x hx f fun p hp => h p (List.mem_append_left _ hp),
      den_iff_onSigns ps σ x hx g fun p hp => h p (List.mem_append_right _ hp)]

end HForm

universe v

/-- **The arrangement of the solids' planes is a compatible decomposition.** For any family of
polyhedral solids whose planes are among `ps` (all with nonzero normals), the sign-pattern cells
of `ps` are a finite decomposition compatible with every solid. -/
def arrangement {ι : Type v} (F : ι → HForm) (ps : List Plane)
    (hps : ∀ p ∈ ps, p.n ≠ ⟨0, 0, 0⟩) (hF : ∀ i, ∀ p ∈ (F i).planes, p ∈ ps) :
    Decomposition.{0, v, 0} fun i => (F i).den where
  κ := List Bool
  cells := patterns ps.length
  cell := cellOf ps
  wall := wall ps
  wall_nowhereDense := wall_nowhereDense ps hps
  cover x h := ⟨patternOf ps x, patternOf_mem ps x, cellOf_patternOf ps x h⟩
  compatible σ i := by
    cases hb : (F i).onSigns ps σ
    · exact Or.inr fun x hx hA =>
        absurd ((HForm.den_iff_onSigns ps σ x hx (F i) (hF i)).mp hA) (by simp [hb])
    · exact Or.inl fun x hx => (HForm.den_iff_onSigns ps σ x hx (F i) (hF i)).mpr hb

/-- **The flat-face boolean, by sign patterns.** For every pointwise boolean `op` of a family of
polyhedral solids, the regularised union of the sign-pattern cells `op` keeps (decided on the
patterns alone, by `onSigns`) is the regularised boolean of the solids. -/
theorem flat_boolean {ι : Type v} (F : ι → HForm) (ps : List Plane)
    (hps : ∀ p ∈ ps, p.n ≠ ⟨0, 0, 0⟩) (hF : ∀ i, ∀ p ∈ (F i).planes, p ∈ ps)
    (op : (ι → Prop) → Prop) :
    reg ((arrangement F ps hps hF).kept fun σ => op fun i => (F i).onSigns ps σ = true) =
      reg (combine op fun i => (F i).den) :=
  reg_kept (arrangement F ps hps hF) op _ fun σ x hx => by
    have : (fun i => (F i).onSigns ps σ = true) = (fun i => (F i).den x) :=
      funext fun i => propext (HForm.den_iff_onSigns ps σ x hx (F i) (hF i)).symm
    rw [this]

/-- A pair of formulas as a family indexed by `Bool` (`true` is the first operand). -/
def pairF (FA FB : HForm) : Bool → HForm
  | true => FA
  | false => FB

/-- The two-body case: union, intersection and difference of two polyhedral solids. -/
theorem flat_bool (o : Op) (FA FB : HForm) (ps : List Plane) (hps : ∀ p ∈ ps, p.n ≠ ⟨0, 0, 0⟩)
    (hA : ∀ p ∈ FA.planes, p ∈ ps) (hB : ∀ p ∈ FB.planes, p ∈ ps) :
    reg ((arrangement (pairF FA FB) ps hps (fun b => by cases b <;> assumption)).kept
        fun σ => o.rule fun b => (pairF FA FB b).onSigns ps σ = true) =
      regBool o FA.den FB.den := by
  rw [flat_boolean]
  unfold regBool
  congr 2
  funext b; cases b <;> rfl

end ForgeExact.Flat

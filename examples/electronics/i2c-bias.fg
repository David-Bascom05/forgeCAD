schematic
frames = library(file: "forge:frames")
logic_high = role(kind: "pull_up", voltage_range_v: [3.0,3.6], value_range: ["2.2 kΩ","10 kΩ"])
internal = role(kind: "pull_up", voltage_mv: 3300, value: "8.2 kΩ")
v33 = role(kind: "power", voltage_mv: 3300)
Controller = symbol(ref_prefix: "U", pins: {
  SDA: pin(kind: "open_drain", number: "1", at: (8,4), wants: [logic_high], functions: {BIAS: function(kind:"open_drain", wants:[logic_high], gives:[internal])}),
  SCL: pin(kind: "open_drain", number: "2", at: (8,-4), wants: [logic_high])
}, graphics: [rect(from:(-6,-6),to:(6,6)),line(from:(6,4),to:(8,4)),line(from:(6,-4),to:(8,-4))])
Device = symbol(ref_prefix: "U", pins: {SDA: pin(kind:"open_drain", number:"1", at:(-8,4)), SCL:pin(kind:"input",number:"2",at:(-8,-4))}, graphics:[rect(from:(-6,-6),to:(6,6)),line(from:(-8,4),to:(-6,4)),line(from:(-8,-4),to:(-6,-4))])
Pull = symbol(ref_prefix:"R",part_kind:"resistor",pins:{A:pin(number:"1",kind:"passive",at:(0,-4)),B:pin(number:"2",kind:"passive",at:(0,4))},graphics:[rect(from:(-1,-2),to:(1,2)),line(from:(0,-4),to:(0,-2)),line(from:(0,2),to:(0,4))])
Supply = symbol(ref_prefix:"J",pins:{OUT:pin(kind:"power_out",number:"1",at:(0,0),gives:[v33])})
main = sheet(title:"I²C pull-ups",template:frames.A4)
U1 = place(sheet:main,symbol:Controller,at:(-26,0))
U2 = place(sheet:main,symbol:Device,at:(28,0))
R4 = place(sheet:main,symbol:Pull,value:"4.7 kΩ",at:(-6,15))
R5 = place(sheet:main,symbol:Pull,value:"4.7 kΩ",at:(9,15))
J1 = place(sheet:main,symbol:Supply,at:(-20,24))
sda = junction(sheet:main,at:(-6,4))
scl = junction(sheet:main,at:(9,-4))
rail = junction(sheet:main,at:(-6,24))
data_drive = wire(sheet:main,from:U1.SDA,to:sda)
data_sink = wire(sheet:main,from:sda,to:U2.SDA)
data_bias = wire(sheet:main,from:sda,to:R4.A)
clock_drive = wire(sheet:main,from:U1.SCL,to:scl)
clock_sink = wire(sheet:main,from:scl,to:U2.SCL)
clock_bias = wire(sheet:main,from:scl,to:R5.A)
regulated = wire(sheet:main,from:J1.OUT,to:rail)
rail_data = wire(sheet:main,from:rail,to:R4.B)
rail_clock = wire(sheet:main,from:rail,to:R5.B,via:[(9,24)])
no_sda_pull = variant(omit:["main/R4"])

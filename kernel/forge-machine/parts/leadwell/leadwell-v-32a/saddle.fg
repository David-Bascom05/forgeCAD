# leadwell-v-32a saddle: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.saddle); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -266.5
shared b0y0 = -509.5
shared b0z0 = -179.5
shared b0sx = 533
shared b0sy = 499
shared b0h = 119

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

{"op":"ReplaceFeature","id":"outer","text":"sketch outer(on: offset(plan.plane, -t1)) {\n  lc = pt(h_l, -k_l)\n  for i in 0..3 {\n    st = pt(h_l + r_st * cos(a_st[i]), -(k_l + r_st * sin(a_st[i])))\n  }\n  up = line((0, 0), (0, -xl), construction: true)\n  down = line((0, 0), (0, xl), construction: true)\n}\n"}

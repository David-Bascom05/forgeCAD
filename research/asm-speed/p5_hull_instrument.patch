+// ---- P5 measurement (throwaway, env FORGEASM_P5=path) ----
+mod p5 {
+    use super::*;
+    fn support(pts: &[Point3], d: Vec3) -> Point3 {
+        let mut best = pts[0];
+        let mut bd = best.to_vec().dot(d);
+        for &p in &pts[1..] {
+            let v = p.to_vec().dot(d);
+            if v > bd {
+                bd = v;
+                best = p;
+            }
+        }
+        best
+    }
+    // closest point to origin on a simplex (<=4 Minkowski points), by enumerating faces
+    fn closest(s: &[Vec3]) -> (Vec3, Vec<Vec3>) {
+        let mut best: Option<(f64, Vec3, Vec<Vec3>)> = None;
+        let mut consider = |p: Vec3, sub: Vec<Vec3>| {
+            let d = p.dot(p);
+            if best.as_ref().is_none_or(|b| d < b.0) {
+                best = Some((d, p, sub));
+            }
+        };
+        for &a in s {
+            consider(a, vec![a]);
+        }
+        for i in 0..s.len() {
+            for j in i + 1..s.len() {
+                let (a, b) = (s[i], s[j]);
+                let ab = b - a;
+                let t = -(a.dot(ab)) / ab.dot(ab);
+                if t > 0.0 && t < 1.0 {
+                    consider(a + ab * t, vec![a, b]);
+                }
+            }
+        }
+        for i in 0..s.len() {
+            for j in i + 1..s.len() {
+                for k in j + 1..s.len() {
+                    let (a, b, c) = (s[i], s[j], s[k]);
+                    let n = (b - a).cross(c - a);
+                    let nn = n.dot(n);
+                    if nn == 0.0 {
+                        continue;
+                    }
+                    let p = n * (a.dot(n) / nn);
+                    let e = |u: Vec3, v: Vec3| (v - u).cross(p - u).dot(n);
+                    if e(a, b) >= 0.0 && e(b, c) >= 0.0 && e(c, a) >= 0.0 {
+                        consider(p, vec![a, b, c]);
+                    }
+                }
+            }
+        }
+        if s.len() == 4 {
+            let side = |a: Vec3, b: Vec3, c: Vec3, d: Vec3| {
+                let n = (b - a).cross(c - a);
+                (n.dot(d - a) > 0.0, n.dot(a * -1.0) > 0.0)
+            };
+            let f = [(0, 1, 2, 3), (0, 1, 3, 2), (0, 2, 3, 1), (1, 2, 3, 0)];
+            if f.iter().all(|&(a, b, c, d)| {
+                let (x, y) = side(s[a], s[b], s[c], s[d]);
+                x == y
+            }) {
+                return (Vec3::new(0.0, 0.0, 0.0), s.to_vec());
+            }
+        }
+        let b = best.unwrap();
+        (b.1, b.2)
+    }
+    /// distance between the convex hulls of two point sets (0 when they meet)
+    pub fn hull_gap(a: &[Point3], b: &[Point3]) -> f64 {
+        let sup = |d: Vec3| support(a, d) - support(b, d * -1.0);
+        let mut v = a[0] - b[0];
+        let mut s: Vec<Vec3> = vec![v];
+        for _ in 0..200 {
+            let vv = v.dot(v);
+            if vv < 1e-24 {
+                return 0.0;
+            }
+            let w = sup(v * -1.0);
+            // lower bound check: v.v - v.w small → converged
+            if vv - v.dot(w) <= 1e-12 * vv.max(1.0) {
+                return vv.sqrt();
+            }
+            s.push(w);
+            let (nv, ns) = closest(&s);
+            if ns.len() == 4 && nv.dot(nv) == 0.0 {
+                return 0.0;
+            }
+            if nv.dot(nv) >= vv {
+                return vv.sqrt();
+            }
+            v = nv;
+            s = ns;
+        }
+        v.dot(v).sqrt()
+    }
+    pub fn record(a: &PartMesh, b: &PartMesh, rel: &Frame, reach: f64, narrowed: Narrow, near: bool) {
+        let Ok(path) = std::env::var("FORGEASM_P5") else { return };
+        let pb: Vec<Point3> = b.positions.iter().map(|&p| rel.point_to_world(p)).collect();
+        let t0 = std::time::Instant::now();
+        let hg = hull_gap(&a.positions, &pb);
+        let t_hull = t0.elapsed().as_secs_f64();
+        let t0 = std::time::Instant::now();
+        let n2 = narrow(a, b, rel, reach);
+        let t_narrow = t0.elapsed().as_secs_f64();
+        let t0 = std::time::Instant::now();
+        let d2 = distance(a, b, rel, reach);
+        let t_dist = t0.elapsed().as_secs_f64();
+        assert_eq!(n2, narrowed);
+        use std::io::Write;
+        let mut f = std::fs::OpenOptions::new().create(true).append(true).open(path).unwrap();
+        writeln!(
+            f,
+            "{{\"narrow\":\"{:?}\",\"near\":{},\"hull_gap\":{},\"reach\":{},\"na\":{},\"nb\":{},\"t_hull\":{},\"t_narrow\":{},\"t_dist\":{},\"dist\":{}}}",
+            narrowed, near, hg, reach, a.positions.len(), b.positions.len(), t_hull, t_narrow, t_dist,
+            d2.map_or(-1.0, |d| d.0)
+        )
+        .unwrap();
+    }
+}
+#[cfg(test)]
+mod p5_tests {
+    use super::*;
+    #[test]
+    fn hull_gap_of_cubes() {
+        let c = |o: f64| -> Vec<Point3> {
+            let mut v = vec![];
+            for x in [0.0, 1.0] { for y in [0.0, 1.0] { for z in [0.0, 1.0] { v.push(Point3::new(x + o, y + 0.3 * o, z)); } } }
+            v
+        };
+        assert!((p5::hull_gap(&c(0.0), &c(2.0)) - (1.0f64 + 0.0).hypot(0.0)).abs() < 1e-9 || true);
+        let g = p5::hull_gap(&c(0.0), &c(2.0));
+        assert!((g - 1.0).abs() < 1e-9, "{g}");
+        assert_eq!(p5::hull_gap(&c(0.0), &c(0.5)), 0.0);
+        let g = p5::hull_gap(&c(0.0), &[Point3::new(2.0, 2.0, 2.0)]);
+        assert!((g - 3f64.sqrt()).abs() < 1e-9, "{g}");
+    }
+}

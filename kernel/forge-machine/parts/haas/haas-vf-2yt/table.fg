# haas-vf-2yt table: 914 x 457 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -837.2
shared y0 = -481.6
shared z0 = -145.7
shared lx = 1674.4
shared ly = 963.2
shared lz = 144.7
shared cx = 0
shared cy = 0
shared cw = 914
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

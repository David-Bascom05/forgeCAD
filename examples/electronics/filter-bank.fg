bottom = copper(kind: "mixed", weight_oz_ft2: 1, thickness: 0.035mm)
stack = stackup(layers: [top, core, bottom])
prototype = process(vendor: "oshpark", service: "two-layer")
packages = library(file: "footprints/filter-bank.fg")

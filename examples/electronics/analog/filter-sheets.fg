schematic

analog = library(file: "analog-symbols.fg")
main = sheet(title: "Dual sensor input")
filter_cell = sheet(title: "RC input filter")
left_filter = subsheet(sheet: main, of: filter_cell, at: (-20, 0))
right_filter = subsheet(sheet: main, of: filter_cell, at: (12, 0))

input = port(sheet: filter_cell, at: (-28, 0))
output = port(sheet: filter_cell, at: (22, 0))
power = library(file: "forge:power")
R1 = place(sheet: filter_cell, symbol: analog.Resistor, value: "10 k", at: (-10, 0))
C1 = place(sheet: filter_cell, symbol: analog.Capacitor, value: "10 nF", at: (4, -8))
ground = place(sheet: filter_cell, symbol: power.GND, at: (4, -16))
tap = junction(sheet: filter_cell, at: (4, 0))
w1 = wire(sheet: filter_cell, from: input, to: R1.A)
w2 = wire(sheet: filter_cell, from: R1.B, to: tap)
w3 = wire(sheet: filter_cell, from: tap, to: output)
w4 = wire(sheet: filter_cell, from: tap, to: C1.P)
w5 = wire(sheet: filter_cell, from: C1.N, to: ground.net)
incoming = flow(sheet: filter_cell, from: input, to: R1.A)
filtered = flow(sheet: filter_cell, from: R1.B, to: output)

outline = rect(sheet: filter_cell, from: (-39, -23), to: (33, 15), width: 0.3mm)
heading = note(sheet: filter_cell, at: (-36, 10), value: "Analog input filter", size: 2.8mm, bold: true)
rule = line(sheet: filter_cell, from: (-36, 8), to: (30, 8), width: 0.45mm)
callout = circle(sheet: filter_cell, at: (-27, -13), radius: 2.1mm, width: 0.3mm)
index = note(sheet: filter_cell, at: (-27.6, -13.8), value: "1", size: 1.6mm, bold: true)
caption = note(sheet: filter_cell, at: (-23.8, -13.8), value: "Signal return", size: 1.6mm)

symbol_library

PowerInput = symbol(ref_prefix: "J", part_kind: "connector",
  pins: {
    POS: pin(number: "1", kind: "passive", at: (9,2.65)),
    NEG: pin(number: "2", kind: "passive", at: (9,-2.65))},
  graphics: [
    rect(from: (-6,-5.3), to: (6,5.3)),
    line(from: (9,2.65), to: (6,2.65)),
    line(from: (9,-2.65), to: (6,-2.65)),
    text(at: (1.21,2.1), value: "POS"),
    text(at: (1.21,-3.2), value: "NEG")])

Brick = symbol(ref_prefix: "U", datasheet: "https://product.tdk.com/system/files/dam/doc/product/power/switching-power/dc-dc-converter/specification/iql48025a120v_spec.pdf",

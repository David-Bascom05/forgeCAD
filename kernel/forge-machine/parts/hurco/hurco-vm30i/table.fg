# hurco-vm30i table: 1321 x 508 published, thickness estimated
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -659.5
shared y0 = -253
shared z0 = -89
shared lx = 1319
shared ly = 506
shared lz = 88
shared cx = 0
shared cy = 0
shared cw = 1321
shared cl = 18
shared cd = 12

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

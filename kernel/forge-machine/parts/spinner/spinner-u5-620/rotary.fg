# spinner-u5-620 rotary: the rotary table: radius 360, the larger listed diameter (720) kept large; thickness an estimate.
# A stand-in built from dealer-listed overall sizes and estimates (not the maker's CAD).
# frame: the machine's base frame at the home pose.
shared d = -80
shared u = 0
shared v = 0
shared r = 360
shared h = 80

sketch plan(on: offset(xy, d)) {
  outline = circle((u, v), r)
}
body = extrude(plan.outline, h)

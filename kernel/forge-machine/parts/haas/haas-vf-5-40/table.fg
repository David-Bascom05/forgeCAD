# haas-vf-5-40 table: 1372 x 610 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -684.8
shared y0 = -310.2
shared z0 = -182.4
shared lx = 1369.6
shared ly = 620.4
shared lz = 181.4
shared cx = 0
shared cy = 0
shared cw = 1372
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

machining
# plate_mark.fg: face, profile, and engrave the mark along its sketch's centre line, 0.3 deep
# with a 60° V tool, into the groove the model carries.
shared tol = 0.01

f    = part("plate_mark.fg", group: "N")
m    = machine("generic-vmc3")
t1   = tool("flat-10", t: 1, stickout: 32, holder: "bt40-er32")
t5   = tool("engrave-60", t: 5, stickout: 20, holder: "bt40-er32")
op1  = setup(f, machine: m, stock: box(margin: (3, 3, 1)), origin: "top-corner", tol: tol)
skim = facing(op1, tool: t1, to: 5, step: 1)
side = clear(op1, tool: t1, from: 5, to: -0.5, step: 2, stepover: 4)
mark = engrave(op1, f.mark, tool: t5, depth: 0.3, step: 0.15)
prog = program(op1, post: "fanuc", number: 3001)

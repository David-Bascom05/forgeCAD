schematic

analog = library(file: "analog-symbols.fg")
main = sheet(title: "Sensor interface")

R1 = place(sheet: main, symbol: analog.Resistor, value: "10k", footprint: "R_0603", at: (-27, 3))
C1 = place(sheet: main, symbol: analog.Capacitor, value: "10 nF", footprint: "C_0603", at: (-15, -7))
U1 = place(sheet: main, symbol: analog.Amplifier, value: "TLV9001", footprint: "SOT-23-5", at: (4, 0))
C2 = place(sheet: main, symbol: analog.Capacitor, value: "100 nF", footprint: "C_0603", at: (23, 18))

input = port(sheet: main, at: (-42,3))
output = port(sheet: main, at: (38,0))
supply = port(sheet: main, at: (-7,22))
ground = port(sheet: main, at: (4,-21))
filter = junction(sheet: main, at: (-15,3))
feedback = junction(sheet: main, at: (19,0))
vdd = junction(sheet: main, at: (4,22))
gnd = junction(sheet: main, at: (4,-15))

w1 = wire(sheet: main, from: input, to: R1.A)
w2 = wire(sheet: main, from: R1.B, to: filter)
w3 = wire(sheet: main, from: filter, to: U1.INP)
w4 = wire(sheet: main, from: filter, to: C1.P)
w5 = wire(sheet: main, from: C1.N, to: gnd, via: [(-15,-15)])
w6 = wire(sheet: main, from: U1.OUT, to: feedback)
w7 = wire(sheet: main, from: feedback, to: output)
w8 = wire(sheet: main, from: feedback, to: U1.INM, via: [(19,-11),(-5,-11),(-5,-3)])
w9 = wire(sheet: main, from: U1.VDD, to: vdd)
w10 = wire(sheet: main, from: supply, to: vdd)
w11 = wire(sheet: main, from: vdd, to: C2.P)
w12 = wire(sheet: main, from: U1.VSS, to: gnd)
w13 = wire(sheet: main, from: gnd, to: ground)
pwr = label(sheet: main, on: vdd, value: "+3V3", at: (6,23))
ret = label(sheet: main, on: gnd, value: "GND", at: (6,-17))
cap_ret = label(sheet: main, on: C2.N, value: "GND", at: (24,13))
local_cap = fulfill(sheet: main, want: U1.VDD, give: C2.P, role: analog.bypass, return_from: C2.N, return_to: U1.VSS)

import ForgeExact.Regular
import ForgeExact.Flat

/-!
# Uniform scale: the regularised solid's image, and its mass properties

L1 of the uniform-scale motion (`scale(about: c, by: k)`, forge_topo::similar), over the reference's
own space ℚ³ (`Ref.V3`) and its topology (`Flat.topology`, generated by open half-spaces).

* `Homeo.reg_img`, `Homeo.combine_img`, `Homeo.reg_combine_img`: a homeomorphism commutes with
  interior, closure and so regularisation, and with every pointwise boolean. So the regularised
  boolean of the moved solids is the image of the regularised boolean (`reg_kept` then applies to
  the image's arrangement as it did to the original's).
* `scale c k`, k > 0, is such a homeomorphism (`scaleHomeo`): it pulls an open half-space back to an
  open half-space (`eval_scale`), and `scale c k⁻¹` undoes it. So a scaled body is the regularised
  solid's image: `scaled_solid`.
* Mass properties, exactly, of any list of triangles (a closed triangulated boundary in use) about
  any reference point r, the reference point moved with the solid:
  - `vol6_scale`: six times the signed volume, Σ det(a − r, b − r, d − r), is times k³;
  - `varea2_scale`: twice the vector area, Σ (b − a) × (d − a), is times k²; each triangle's
    squared area |(b − a) × (d − a)|² is times k⁴ (`area2_scale`), so its area times k²;
  - `mom24_scale`: twenty-four times the first moment about r is times k⁴, so the centroid
    r + M/V of the image is the image of the centroid (`centroid_scale`).
  `vol6_shift` gives the reference point's part: moving it by t changes six times the volume by
  t · (twice the vector area), which is zero for a closed boundary, so there the volume is the
  same about every point.

Every identity is a polynomial identity over ℚ, proven with no rounding: the kernel's mass rules
are exact per kind (L1 of mass properties), and its scale maps each kind to its own kind with
lengths times k, so its scaled volume, area and centroid are these, to the rounding of the rules.
forge-model's tests/scale.rs checks every suite part to 1e-9.
-/

namespace ForgeExact.Similar

open ForgeExact Topology Ref

universe u

/-! ## A homeomorphism commutes with regularisation and with booleans -/

/-- A homeomorphism: `f` and its inverse `g` both continuous (open sets pull back to open sets). -/
structure Homeo (X : Type u) [Topology X] where
  f : X → X
  g : X → X
  gf : ∀ x, g (f x) = x
  fg : ∀ y, f (g y) = y
  f_cont : ∀ U : Pred X, IsOpen U → IsOpen fun x => U (f x)
  g_cont : ∀ U : Pred X, IsOpen U → IsOpen fun y => U (g y)

namespace Homeo

variable {X : Type u} [Topology X] (h : Homeo X)

/-- The image of a set: the points whose inverse image lies in it. -/
def img (S : Pred X) : Pred X := fun y => S (h.g y)

theorem interior_img (S : Pred X) : interior (h.img S) = h.img (interior S) := by
  apply Pred.ext; intro y; constructor
  · intro ⟨U, hU, hUS, hy⟩
    refine ⟨fun x => U (h.f x), h.f_cont U hU, fun x hx => ?_, by simp only [h.fg]; exact hy⟩
    have := hUS _ hx
    simp only [img, h.gf] at this
    exact this
  · intro ⟨V, hV, hVS, hy⟩
    exact ⟨fun y => V (h.g y), h.g_cont V hV, fun z hz => hVS _ hz, hy⟩

theorem closure_img (S : Pred X) : closure (h.img S) = h.img (closure S) := by
  apply Pred.ext; intro y; constructor
  · intro hc V hV hVy
    obtain ⟨z, hz, hS⟩ := hc (fun y => V (h.g y)) (h.g_cont V hV) hVy
    exact ⟨h.g z, hz, hS⟩
  · intro hc U hU hUy
    obtain ⟨x, hx, hS⟩ := hc (fun x => U (h.f x)) (h.f_cont U hU) (by simp only [h.fg]; exact hUy)
    exact ⟨h.f x, hx, by simp only [img, h.gf]; exact hS⟩

/-- The regularisation of the image is the image of the regularisation. -/
theorem reg_img (S : Pred X) : reg (h.img S) = h.img (reg S) := by
  unfold reg; rw [interior_img, closure_img]

/-- A pointwise boolean of images is the image of the boolean. -/
theorem combine_img {ι : Type} (op : (ι → Prop) → Prop) (A : ι → Pred X) :
    combine op (fun i => h.img (A i)) = h.img (combine op A) := rfl

/-- So the regularised boolean of the moved solids is the moved regularised boolean. -/
theorem reg_combine_img {ι : Type} (op : (ι → Prop) → Prop) (A : ι → Pred X) :
    reg (combine op (fun i => h.img (A i))) = h.img (reg (combine op A)) := by
  rw [combine_img, reg_img]

end Homeo

/-! ## The uniform scale of ℚ³ -/

/-- p ↦ c + k (p − c). -/
def scale (c : V3) (k : Rat) (p : V3) : V3 :=
  ⟨c.x + k * (p.x - c.x), c.y + k * (p.y - c.y), c.z + k * (p.z - c.z)⟩

theorem scale_scale_inv (c : V3) {k : Rat} (hk : k ≠ 0) (p : V3) : scale c k⁻¹ (scale c k p) = p := by
  have e : k⁻¹ * k = 1 := Rat.inv_mul_cancel k hk
  simp only [scale]
  cases p
  simp only [V3.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> grind

theorem scale_inv_scale (c : V3) {k : Rat} (hk : k ≠ 0) (p : V3) : scale c k (scale c k⁻¹ p) = p := by
  have e : k * k⁻¹ = 1 := Rat.mul_inv_cancel k hk
  simp only [scale]
  cases p
  simp only [V3.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> grind

/-- The half-space a scale pulls `h` back to: h (scale x) = k · (pull h)(x). -/
def pull (c : V3) (k : Rat) (h : Plane) : Plane := ⟨h.n, (h.c - h.n.dot c + k * h.n.dot c) / k⟩

theorem eval_scale (c : V3) {k : Rat} (hk : k ≠ 0) (h : Plane) (x : V3) :
    h.eval (scale c k x) = k * (pull c k h).eval x := by
  simp only [Plane.eval, pull, V3.dot, scale]
  grind

theorem pos_of_mul_pos {k e : Rat} (hk : 0 < k) (h : 0 < k * e) : 0 < e := by
  apply Classical.byContradiction; intro hn
  have he : 0 ≤ -e := by grind
  have := Rat.mul_nonneg (Rat.le_of_lt hk) he
  have : k * -e = -(k * e) := by grind
  grind

theorem scale_cont (c : V3) {k : Rat} (hk : 0 < k) (U : Pred V3) (hU : IsOpen U) :
    IsOpen fun x => U (scale c k x) := by
  have hk0 : k ≠ 0 := Rat.ne_of_gt hk
  intro x hx
  obtain ⟨hs, hpos, hsub⟩ := hU _ hx
  refine ⟨hs.map (pull c k), fun p hp => ?_, fun y hy => hsub _ fun h hm => ?_⟩
  · obtain ⟨h, hm, rfl⟩ := List.mem_map.mp hp
    have := hpos h hm
    rw [eval_scale c hk0] at this
    exact pos_of_mul_pos hk this
  · have := hy (pull c k h) (List.mem_map.mpr ⟨h, hm, rfl⟩)
    rw [eval_scale c hk0]
    exact Rat.mul_pos hk this

/-- The uniform scale by k > 0 about c is a homeomorphism of ℚ³. -/
def scaleHomeo (c : V3) {k : Rat} (hk : 0 < k) : Homeo V3 where
  f := scale c k
  g := scale c k⁻¹
  gf := scale_scale_inv c (Rat.ne_of_gt hk)
  fg := scale_inv_scale c (Rat.ne_of_gt hk)
  f_cont := scale_cont c hk
  g_cont := scale_cont c (Rat.inv_pos.mpr hk)

/-- L1: the regularised boolean of the scaled solids is the scaled regularised boolean; and a
point is in the image exactly when its preimage is in the solid. -/
theorem scaled_solid (c : V3) {k : Rat} (hk : 0 < k) {ι : Type} (op : (ι → Prop) → Prop)
    (A : ι → Pred V3) :
    reg (combine op (fun i => (scaleHomeo c hk).img (A i))) = (scaleHomeo c hk).img (reg (combine op A)) ∧
      ∀ p S, (scaleHomeo c hk).img S (scale c k p) ↔ S p :=
  ⟨(scaleHomeo c hk).reg_combine_img op A, fun p S => by
    simp only [Homeo.img, scaleHomeo, scale_scale_inv c (Rat.ne_of_gt hk)]⟩

/-! ## Mass properties scale exactly -/

/-- A point relative to r. -/
def rel (r p : V3) : V3 := ⟨p.x - r.x, p.y - r.y, p.z - r.z⟩

def det3 (a b d : V3) : Rat :=
  a.x * (b.y * d.z - b.z * d.y) - a.y * (b.x * d.z - b.z * d.x) + a.z * (b.x * d.y - b.y * d.x)

/-- A triangle of a boundary, its corners in order (the outward normal by the right-hand rule). -/
structure Tri where
  a : V3
  b : V3
  d : V3

def Tri.map (f : V3 → V3) (t : Tri) : Tri := ⟨f t.a, f t.b, f t.d⟩

/-- Six times the signed volume of the tetrahedron (r, a, b, d). -/
def tet6 (r : V3) (t : Tri) : Rat := det3 (rel r t.a) (rel r t.b) (rel r t.d)

/-- Six times the signed volume a boundary encloses, about r. -/
def vol6 (r : V3) : List Tri → Rat
  | [] => 0
  | t :: ts => tet6 r t + vol6 r ts

theorem rel_scale (c : V3) (k : Rat) (r p : V3) :
    rel (scale c k r) (scale c k p) = ⟨k * (p.x - r.x), k * (p.y - r.y), k * (p.z - r.z)⟩ := by
  simp only [rel, scale, V3.mk.injEq]; refine ⟨?_, ?_, ?_⟩ <;> grind

theorem tet6_scale (c : V3) (k : Rat) (r : V3) (t : Tri) :
    tet6 (scale c k r) (t.map (scale c k)) = k * k * k * tet6 r t := by
  simp only [tet6, Tri.map, det3, rel, scale]; grind

/-- Volume times k³. -/
theorem vol6_scale (c : V3) (k : Rat) (r : V3) (T : List Tri) :
    vol6 (scale c k r) (T.map (Tri.map (scale c k))) = k * k * k * vol6 r T := by
  induction T with
  | nil => simp only [List.map, vol6]; grind
  | cons t ts ih => simp only [List.map, vol6, ih, tet6_scale]; grind

/-- Twice a triangle's vector area, (b − a) × (d − a). -/
def area2v (t : Tri) : V3 := (rel t.a t.b).cross (rel t.a t.d)

/-- Twice the vector area of a boundary. -/
def varea2 : List Tri → V3
  | [] => ⟨0, 0, 0⟩
  | t :: ts => ⟨(area2v t).x + (varea2 ts).x, (area2v t).y + (varea2 ts).y, (area2v t).z + (varea2 ts).z⟩

theorem area2v_scale (c : V3) (k : Rat) (t : Tri) :
    area2v (t.map (scale c k)) = ⟨k * k * (area2v t).x, k * k * (area2v t).y, k * k * (area2v t).z⟩ := by
  simp only [area2v, Tri.map, V3.cross, rel, scale, V3.mk.injEq]; refine ⟨?_, ?_, ?_⟩ <;> grind

/-- Vector area times k². -/
theorem varea2_scale (c : V3) (k : Rat) (T : List Tri) :
    varea2 (T.map (Tri.map (scale c k))) =
      ⟨k * k * (varea2 T).x, k * k * (varea2 T).y, k * k * (varea2 T).z⟩ := by
  induction T with
  | nil => simp only [List.map, varea2, V3.mk.injEq]; refine ⟨?_, ?_, ?_⟩ <;> grind
  | cons t ts ih =>
    simp only [List.map, varea2, ih, area2v_scale, V3.mk.injEq]; refine ⟨?_, ?_, ?_⟩ <;> grind

/-- Four times a triangle's squared area, |(b − a) × (d − a)|², times k⁴: its area times k². -/
theorem area2_scale (c : V3) (k : Rat) (t : Tri) :
    (area2v (t.map (scale c k))).norm2 = k * k * k * k * (area2v t).norm2 := by
  rw [area2v_scale]; simp only [V3.norm2, V3.dot]; grind

/-- The reference point's part: about r + t, six times the volume is less t · (twice the vector
area) — zero for a closed boundary, whose volume is then the same about every point. -/
theorem vol6_shift (r t : V3) (T : List Tri) :
    vol6 ⟨r.x + t.x, r.y + t.y, r.z + t.z⟩ T = vol6 r T - (t.dot (varea2 (T.map (Tri.map (rel r))))) := by
  induction T with
  | nil => simp only [vol6, List.map, varea2, V3.dot]; grind
  | cons a ts ih =>
    simp only [vol6, List.map, varea2, V3.dot] at ih ⊢
    rw [ih]
    simp only [tet6, det3, rel, area2v, Tri.map, V3.cross]
    grind

/-- Twenty-four times the first moment of the tetrahedron (r, a, b, d) about r: its six-times volume
times the sum of its corners relative to r. -/
def mom24t (r : V3) (t : Tri) : V3 :=
  let s := tet6 r t
  let (a, b, d) := (rel r t.a, rel r t.b, rel r t.d)
  ⟨s * (a.x + b.x + d.x), s * (a.y + b.y + d.y), s * (a.z + b.z + d.z)⟩

def mom24 (r : V3) : List Tri → V3
  | [] => ⟨0, 0, 0⟩
  | t :: ts => ⟨(mom24t r t).x + (mom24 r ts).x, (mom24t r t).y + (mom24 r ts).y,
      (mom24t r t).z + (mom24 r ts).z⟩

theorem mom24t_scale (c : V3) (k : Rat) (r : V3) (t : Tri) :
    mom24t (scale c k r) (t.map (scale c k)) =
      ⟨k * k * k * k * (mom24t r t).x, k * k * k * k * (mom24t r t).y, k * k * k * k * (mom24t r t).z⟩ := by
  simp only [mom24t, tet6, det3, Tri.map, rel, scale, V3.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> grind

/-- The first moment about the reference point times k⁴. -/
theorem mom24_scale (c : V3) (k : Rat) (r : V3) (T : List Tri) :
    mom24 (scale c k r) (T.map (Tri.map (scale c k))) =
      ⟨k * k * k * k * (mom24 r T).x, k * k * k * k * (mom24 r T).y, k * k * k * k * (mom24 r T).z⟩ := by
  induction T with
  | nil => simp only [List.map, mom24, V3.mk.injEq]; refine ⟨?_, ?_, ?_⟩ <;> grind
  | cons t ts ih =>
    simp only [List.map, mom24, ih, mom24t_scale, V3.mk.injEq]; refine ⟨?_, ?_, ?_⟩ <;> grind

/-- The centroid, r + M / (4 V) with M = mom24 and V = vol6 (∫ (x − r) dV = M / 24, ∫ dV = V / 6). -/
def centroid (r : V3) (T : List Tri) : V3 :=
  let v := vol6 r T
  let m := mom24 r T
  ⟨r.x + m.x / (4 * v), r.y + m.y / (4 * v), r.z + m.z / (4 * v)⟩

/-- The centroid of the image (about the image of the reference point) is the image of the
centroid, for a body of nonzero volume and k ≠ 0. -/
theorem centroid_scale (c : V3) {k : Rat} (hk : k ≠ 0) (r : V3) (T : List Tri) (hv : vol6 r T ≠ 0) :
    centroid (scale c k r) (T.map (Tri.map (scale c k))) = scale c k (centroid r T) := by
  simp only [centroid]
  rw [vol6_scale, mom24_scale]
  simp only [scale, V3.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> grind

end ForgeExact.Similar

# grizzly-g0876 bed: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.bed); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -239.6
shared b0y0 = -301.5
shared b0z0 = -369.5
shared b0sx = 479.2
shared b0sy = 854.5
shared b0h = 199

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

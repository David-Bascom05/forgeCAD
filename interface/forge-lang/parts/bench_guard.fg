# Belt guard (tools/bench-parts/guard.fc), hand port: the belt's envelope round two pulleys
# drawn as a solid (a hull of the two discs: its lines held tangent by the solver), grown by the
# running clearance with offset_faces, its top edges rounded for the sheet's bend.
# Not ported (lanes fg-holes/bodies): the sheet thickened off the top and sides as a body of its
# own needs a union of face sets; the louvres, sight hole, tabs and screw holes go `in guard`.

shared r1 = 62
shared r2 = 38
shared d = 240
shared h = 50
shared gap = 6
param bend.r = 5

sketch plan(on: xy) {
  big = pt(0, 0)
  small = pt(d, 0)
  outline = hull(disc(big, r1), disc(small, r2))
}
env = extrude(plan, h)
grown = offset_faces(env.faces, gap)
bend = fillet(edges(of: env.end, crease: "convex"), r)
expect faces = 10

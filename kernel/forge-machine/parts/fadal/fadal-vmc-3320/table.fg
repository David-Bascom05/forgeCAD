# fadal-vmc-3320 table: 31.6 x 17.75 in published, thickness estimated
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -400.32
shared y0 = -224.425
shared z0 = -99
shared lx = 800.64
shared ly = 448.85
shared lz = 98
shared cx = 0
shared cy = 0
shared cw = 802.64
shared cl = 18
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

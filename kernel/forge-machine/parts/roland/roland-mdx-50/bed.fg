# roland-mdx-50 bed: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.bed); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -399.5
shared b0y0 = -457
shared b0z0 = -79.5
shared b0sx = 399
shared b0sy = 781.5
shared b0h = 59

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

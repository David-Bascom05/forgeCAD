harness(ctrl, ma, mb, sn, plate, slack: slack, round_up: step, insert: seat_in)
# The robot's loom as a file of its own: robot_loom.fg places it with the occurrences it wires.
p18 = wire_type(awg: g18, od: od18, min_bend: bend18, colour: "RD", source: "example values, not a datasheet")
s22 = wire_type(awg: g22, od: od22, min_bend: bend22, colour: "WH", source: "example values, not a datasheet")
s26 = wire_type(awg: g26, od: od26, min_bend: bend26, colour: "YE", source: "example values, not a datasheet")

J1 = connector(ctrl.face, pins: ctrl.pin)
J2 = connector(ma.face, pins: ma.pin)
J3 = connector(mb.face, pins: mb.pin)
J4 = connector(sn.face, pins: sn.pin)

n1 = node(J1, out: out_ctrl)
hub1 = node(plate.clip1, off: rise, along: "x")
hub2 = node(plate.clip2, off: rise, along: "x")
n2 = node(J2, out: out)
n3 = node(J3, out: out)
n4 = node(J4, out: out)

trunk = segment(n1, hub1, covering: "PET braid 8", wall: braid)
span = segment(hub1, hub2)
to_a = segment(hub1, n2)
to_b = segment(hub2, n3)
to_s = segment(hub2, n4)

W1 = wire(J1[1], J2[1], type: p18, colour: "RD")
W2 = wire(J1[2], J2[2], type: p18, colour: "BK")
W3 = wire(J1[3], J2[3], type: s22, colour: "WH")
W4 = wire(J1[4], J2[4], type: s22, colour: "BU")
W5 = wire(J1[5], J3[1], type: p18, colour: "RD")
W6 = wire(J1[6], J3[2], type: p18, colour: "BK")
W7 = wire(J1[7], J3[3], type: s22, colour: "WH")
W8 = wire(J1[8], J3[4], type: s22, colour: "BU")
W9 = wire(J1[9], J4[1], type: s26, colour: "RD")
W10 = wire(J1[10], J4[2], type: s26, colour: "BK")
W11 = wire(J1[11], J4[3], type: s26, colour: "YE")
W12 = wire(J1[12], J4[4], type: s26, colour: "GN")
W13 = wire(J1[13], J4[5], type: s26, colour: "OG")
W14 = wire(J1[14], J4[6], type: s26, colour: "VT")

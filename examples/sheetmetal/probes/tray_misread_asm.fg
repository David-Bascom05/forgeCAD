assembly
tray = part("tray_misread.fg", ground: true)
rack = part("../rack_face.fg", ground: true, at: pose(at: (-1.7, -25, -20), z: (0, -1, 0), x: (1, 0, 0)))
# the wall's first hole lands at y 95, 70 off the ear's at 25: this expect fails, measured 70
expect axis_offset(tray.lh.a.axis, rack.lh.a.axis) <= 0.01

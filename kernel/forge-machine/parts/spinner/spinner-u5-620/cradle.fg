# spinner-u5-620 cradle: the tilting cradle under the rotary table (estimate).
# A stand-in built from dealer-listed overall sizes and estimates (not the maker's CAD).
# frame: the machine's base frame at the home pose.
shared x0 = -340
shared y0 = -400
shared z0 = -200
shared L = 680
shared W = 800
shared H = 120

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (L, W))
}
body = extrude(plan, H)

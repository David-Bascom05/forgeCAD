# haas-mini-mill table: 914 x 305 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -543.9
shared y0 = -158
shared z0 = -154.7
shared lx = 1087.8
shared ly = 316
shared lz = 153.7
shared cx = 0
shared cy = 0
shared cw = 914
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

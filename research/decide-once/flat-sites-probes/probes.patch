+// PROBE (temporary): exactness of classify's and point_in_face's `On`.
+fn probe_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("FORGE_PROBE_ON").is_ok())
+}
+fn exact_side(s: &Surface, p: Point3) -> Option<i32> {
+    use forge_math::exact::{DyPlane, DyV3, HPoint};
+    let Surface::Plane(pl) = s else { return None };
+    let o = pl.frame.origin;
+    let n = pl.frame.z().get();
+    let pp = DyPlane::from_frame([o.x, o.y, o.z], [n.x, n.y, n.z]);
+    Some(pp.side(&HPoint::from_dy(DyV3::from_f64(p.x, p.y, p.z))))
+}
+fn probe_classify_on(body: &Body, f: FaceId, p: Point3) {
+    if !probe_on() {
+        return;
+    }
+    let s = &body.face(f).surface;
+    let d = s.distance(p);
+    match exact_side(s, p) {
+        Some(0) => eprintln!("PROBE cls_on plane exact0 d={d:e}"),
+        Some(_) => eprintln!("PROBE cls_on plane OFF d={d:e}"),
+        None => eprintln!("PROBE cls_on curved d={d:e}"),
+    }
+}
+fn probe_pif_on(body: &Body, f: FaceId, c: forge_topo::CoedgeId, p: Point3, d: f64) {
+    if !probe_on() {
+        return;
+    }
+    let s = &body.face(f).surface;
+    let own = exact_side(s, p);
+    let e = body.edge(body.coedge(c).edge);
+    let line = matches!(e.curve, Curve::Line(_));
+    let across = body.partner(c).map(|o| body.coedge_face(o)).filter(|&g| g != f);
+    let acr = across.and_then(|g| exact_side(&body.face(g).surface, p));
+    let kind = match (own, line, acr) {
+        (None, _, _) => "curved".to_string(),
+        (Some(o), true, Some(a)) => format!("plane-line own={} across={}", o == 0, a == 0),
+        (Some(o), _, _) => format!("plane-other own={}", o == 0),
+    };
+    eprintln!("PROBE pif_on {kind} d={d:e}");
+}

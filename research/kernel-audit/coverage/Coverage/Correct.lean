import Coverage.Theorems
import ForgeExact.Regular
import ForgeExact.Flat

/-!
# The modelled kernel against the exact spec

The spec (verify/forge-exact, `ForgeExact`) defines the regularised boolean of two point sets of
ℚ³, `regBool o A B = reg (A op B)` with `reg = closure ∘ interior` in the topology generated by open
half-spaces, and proves (`reg_kept`) that for any finite decomposition compatible with the operands
the regularised union of the kept cells is that boolean.

Here a pattern is realised over ℚ with every end at its rank (`rv`), so A and B are the open boxes
`boxA p`, `boxB p`. Their planes x, y, z ∈ {0, 1, 2, 3} cut ℚ³ into 5³ open grid cells (`cellPt`,
interval `t` of an axis is (t-1, t), with t = 0 below rank 0 and t = 4 above rank 3), a
decomposition compatible with both boxes (`grid`). So:

* `exact_is_regBool`: the regularised union of the cells the model's `kept3` keeps (the exact
  answer `Model.exact` and `Model.exactBoundary` are computed from) is the spec's `regBool`, for
  every valid pattern, not only the 6591 listed.
* `kernel_correct`: on every consistent pattern off the eight corner-touch unions, the modelled
  kernel's outcome is the exact one (`correct_off_gaps`); `Model.kernel` answers `.ok` only when the
  boundary it builds is `exactBoundary p`, the boundary between kept and dropped grid cells, i.e. of
  the spec's `regBool` by `exact_is_regBool`; `.empty` exactly when that boolean has no interior
  cell; `.zeroThickness` exactly when it is not a manifold.

`correct_off_gaps` is checked by `native_decide` (it trusts the Lean compiler); everything else here
is kernel-checked.
-/

namespace Coverage.Correct

open ForgeExact ForgeExact.Topology

/-- The spec's points (ℚ³); `V3` here is the model's Nat cell. -/
abbrev Q3 := ForgeExact.Ref.V3
abbrev Plane := ForgeExact.Ref.Plane

/-- A rank's coordinate. -/
def rv : Nat → Rat
  | 0 => 0
  | 1 => 1
  | 2 => 2
  | _ => 3

/-- Open interval `t` of an axis: (t-1, t), unbounded below for t = 0 and above for t = 4. -/
def iv (t : Nat) (q : Rat) : Prop := (1 ≤ t → rv (t - 1) < q) ∧ (t ≤ 3 → q < rv t)

def coord (x : Q3) : Nat → Rat
  | 0 => x.x
  | 1 => x.y
  | _ => x.z

/-- The open grid cell (t₀, t₁, t₂). -/
def cellPt (c : Nat × Nat × Nat) : Pred Q3 := fun x => iv c.1 x.x ∧ iv c.2.1 x.y ∧ iv c.2.2 x.z

/-- An open box with ends at ranks. -/
def box (lo hi : Nat → Nat) : Pred Q3 := fun x =>
  (rv (lo 0) < x.x ∧ x.x < rv (hi 0)) ∧ (rv (lo 1) < x.y ∧ x.y < rv (hi 1)) ∧
  (rv (lo 2) < x.z ∧ x.z < rv (hi 2))

def boxA (p : Pat) : Pred Q3 := box (fun i => (p.rel i).a0) (fun i => (p.rel i).a1)
def boxB (p : Pat) : Pred Q3 := box (fun i => (p.rel i).b0) (fun i => (p.rel i).b1)

/-- The model's op as the spec's. -/
def specOp : Coverage.Op → ForgeExact.Op
  | .union => .union
  | .subtract => .diff
  | .intersect => .inter

/-- Interval t lies inside (lo, hi). -/
def inIv (lo hi t : Nat) : Bool := lo + 1 ≤ t && t ≤ hi

theorem iv_box_small (lo hi t : Nat) (hl : lo < hi) (hh : hi ≤ 3) (ht : t ≤ 4) :
    (inIv lo hi t = true → ∀ q, iv t q → rv lo < q ∧ q < rv hi) ∧
    (inIv lo hi t = false → ∀ q, iv t q → ¬(rv lo < q ∧ q < rv hi)) := by
  have hlo : lo = 0 ∨ lo = 1 ∨ lo = 2 := by omega
  have hhi : hi = 1 ∨ hi = 2 ∨ hi = 3 := by omega
  have htt : t = 0 ∨ t = 1 ∨ t = 2 ∨ t = 3 ∨ t = 4 := by omega
  rcases hlo with rfl | rfl | rfl <;> rcases hhi with rfl | rfl | rfl <;>
    rcases htt with rfl | rfl | rfl | rfl | rfl <;>
    first
    | omega
    | (simp only [inIv, iv, rv]; constructor <;> intro h <;> simp at h <;> intro q hq <;> grind)

theorem rv_le (r : Nat) : rv r ≤ 3 := by
  unfold rv; split <;> grind

/-- Every interval index lies in or out of an open box (indices past 4 are (3, ∞), as 4 is). -/
theorem iv_box (lo hi t : Nat) (hl : lo < hi) (hh : hi ≤ 3) :
    (inIv lo hi t = true → ∀ q, iv t q → rv lo < q ∧ q < rv hi) ∧
    (inIv lo hi t = false → ∀ q, iv t q → ¬(rv lo < q ∧ q < rv hi)) := by
  by_cases ht : t ≤ 4
  · exact iv_box_small lo hi t hl hh ht
  · have h3 : rv (t - 1) = 3 := by
      unfold rv; split <;> first | rfl | (exfalso; omega)
    refine ⟨fun h => by exfalso; simp only [inIv, Bool.and_eq_true, decide_eq_true_eq] at h; omega, fun _ q hq hb => ?_⟩
    have := hq.1 (by omega)
    rw [h3] at this
    have := rv_le hi
    grind

/-- The pattern's ranks are a valid weak order on each axis. -/
def Valid (p : Pat) : Prop :=
  ∀ i, (p.rel i).a0 < (p.rel i).a1 ∧ (p.rel i).a1 ≤ 3 ∧ (p.rel i).b0 < (p.rel i).b1 ∧ (p.rel i).b1 ≤ 3

theorem valid_all : ∀ p ∈ Pat.all, Valid p := by
  intro p hp i
  have hr : ∀ r ∈ Rel.all, r.a0 < r.a1 ∧ r.a1 ≤ 3 ∧ r.b0 < r.b1 ∧ r.b1 ≤ 3 := by decide
  simp only [Pat.all, List.mem_flatMap, List.mem_map] at hp
  obtain ⟨_, _, x, hx, y, hy, z, hz, rfl⟩ := hp
  match i with
  | 0 => exact hr x hx
  | 1 => exact hr y hy
  | _ + 2 => exact hr z hz

/-- Cell `c` inside the box (lo, hi): every axis's interval inside. -/
def inBox (lo hi : Nat → Nat) (c : Nat × Nat × Nat) : Bool :=
  inIv (lo 0) (hi 0) c.1 && inIv (lo 1) (hi 1) c.2.1 && inIv (lo 2) (hi 2) c.2.2

theorem box_cell (lo hi : Nat → Nat) (hv : ∀ i, lo i < hi i ∧ hi i ≤ 3) (c : Nat × Nat × Nat)
    (x : Q3) (hx : cellPt c x) :
    box lo hi x ↔ inBox lo hi c = true := by
  obtain ⟨h0, h1, h2⟩ := hx
  have b0 := iv_box (lo 0) (hi 0) c.1 (hv 0).1 (hv 0).2
  have b1 := iv_box (lo 1) (hi 1) c.2.1 (hv 1).1 (hv 1).2
  have b2 := iv_box (lo 2) (hi 2) c.2.2 (hv 2).1 (hv 2).2
  simp only [box, inBox, Bool.and_eq_true]
  constructor
  · rintro ⟨x0, x1, x2⟩
    refine ⟨⟨?_, ?_⟩, ?_⟩ <;>
    · apply Classical.byContradiction; intro hn; simp only [Bool.not_eq_true] at hn
      first
      | exact b0.2 hn _ h0 x0
      | exact b1.2 hn _ h1 x1
      | exact b2.2 hn _ h2 x2
  · rintro ⟨⟨i0, i1⟩, i2⟩
    exact ⟨b0.1 i0 _ h0, b1.1 i1 _ h1, b2.1 i2 _ h2⟩

/-- The twelve planes x, y, z = 0..3. -/
def planes : List Plane :=
  [0, 1, 2, 3].flatMap fun r : Nat =>
    [⟨⟨1, 0, 0⟩, rv r⟩, ⟨⟨0, 1, 0⟩, rv r⟩, ⟨⟨0, 0, 1⟩, rv r⟩]

theorem planes_nonzero : ∀ p ∈ planes, p.n ≠ ⟨0, 0, 0⟩ := by
  intro p hp
  simp only [planes, List.mem_flatMap, List.mem_cons, List.mem_nil_iff, or_false] at hp
  obtain ⟨r, _, h⟩ := hp
  rcases h with rfl | rfl | rfl <;> simp

/-- Off the twelve planes, a coordinate is in one of the five intervals. -/
theorem pick (q : Rat) (h0 : q ≠ 0) (h1 : q ≠ 1) (h2 : q ≠ 2) (h3 : q ≠ 3) :
    ∃ t, t ≤ 4 ∧ iv t q := by
  by_cases a : q < 0
  · exact ⟨0, by omega, by simp [iv, rv, a]⟩
  by_cases b : q < 1
  · exact ⟨1, by omega, by simp [iv, rv]; grind⟩
  by_cases c : q < 2
  · exact ⟨2, by omega, by simp [iv, rv]; grind⟩
  by_cases d : q < 3
  · exact ⟨3, by omega, by simp [iv, rv]; grind⟩
  · exact ⟨4, by omega, by simp [iv, rv]; grind⟩

def cells : List (Nat × Nat × Nat) :=
  (List.range 5).flatMap fun a => (List.range 5).flatMap fun b => (List.range 5).map fun c => (a, b, c)

theorem mem_cells (a b c : Nat) (ha : a ≤ 4) (hb : b ≤ 4) (hc : c ≤ 4) : (a, b, c) ∈ cells := by
  simp only [cells, List.mem_flatMap, List.mem_range, List.mem_map, Prod.mk.injEq]
  exact ⟨a, by omega, b, by omega, c, by omega, rfl, rfl, rfl⟩

theorem cells_le : ∀ c ∈ cells, c.1 ≤ 4 ∧ c.2.1 ≤ 4 ∧ c.2.2 ≤ 4 := by
  intro c hc
  simp only [cells, List.mem_flatMap, List.mem_range, List.mem_map] at hc
  obtain ⟨a, ha, b, hb, d, hd, rfl⟩ := hc
  simp only; omega

theorem off_wall (x : Q3) (h : ¬Flat.wall planes x) (r : Nat) (hr : r ≤ 3) :
    x.x ≠ rv r ∧ x.y ≠ rv r ∧ x.z ≠ rv r := by
  have mem : ∀ n : Q3, (⟨n, rv r⟩ : Plane) ∈ planes ↔ n = ⟨1, 0, 0⟩ ∨ n = ⟨0, 1, 0⟩ ∨ n = ⟨0, 0, 1⟩ := by
    intro n
    have : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 := by omega
    rcases this with rfl | rfl | rfl | rfl <;> simp [planes, rv] <;> grind
  refine ⟨fun e => h ⟨_, (mem _).2 (Or.inl rfl), ?_⟩, fun e => h ⟨_, (mem _).2 (Or.inr (Or.inl rfl)), ?_⟩,
    fun e => h ⟨_, (mem _).2 (Or.inr (Or.inr rfl)), ?_⟩⟩ <;>
    simp [ForgeExact.Ref.Plane.eval, ForgeExact.Ref.V3.dot, e] <;> grind

/-- The grid: a finite decomposition of ℚ³ compatible with both boxes. -/
def grid (p : Pat) (hv : Valid p) : Decomposition.{0, 0, 0} (pair (boxA p) (boxB p)) where
  κ := Nat × Nat × Nat
  cells := cells
  cell := cellPt
  wall := Flat.wall planes
  wall_nowhereDense := Flat.wall_nowhereDense planes planes_nonzero
  cover x h := by
    have o := fun r hr => off_wall x h r hr
    obtain ⟨a, ha, hxa⟩ := pick x.x (o 0 (by omega)).1 (o 1 (by omega)).1 (o 2 (by omega)).1 (o 3 (by omega)).1
    obtain ⟨b, hb, hxb⟩ := pick x.y (o 0 (by omega)).2.1 (o 1 (by omega)).2.1 (o 2 (by omega)).2.1 (o 3 (by omega)).2.1
    obtain ⟨c, hc, hxc⟩ := pick x.z (o 0 (by omega)).2.2 (o 1 (by omega)).2.2 (o 2 (by omega)).2.2 (o 3 (by omega)).2.2
    exact ⟨(a, b, c), mem_cells a b c ha hb hc, hxa, hxb, hxc⟩
  compatible c i := by
    cases i
    · have hv' : ∀ j, (p.rel j).b0 < (p.rel j).b1 ∧ (p.rel j).b1 ≤ 3 := fun j => ⟨(hv j).2.2.1, (hv j).2.2.2⟩
      cases hb : inBox (fun j => (p.rel j).b0) (fun j => (p.rel j).b1) c
      · exact Or.inr fun x hx hB => by
          have := (box_cell _ _ hv' c x hx).1 hB; simp_all
      · exact Or.inl fun x hx => (box_cell _ _ hv' c x hx).2 hb
    · have hv' : ∀ j, (p.rel j).a0 < (p.rel j).a1 ∧ (p.rel j).a1 ≤ 3 := fun j => ⟨(hv j).1, (hv j).2.1⟩
      cases hb : inBox (fun j => (p.rel j).a0) (fun j => (p.rel j).a1) c
      · exact Or.inr fun x hx hA => by
          have := (box_cell _ _ hv' c x hx).1 hA; simp_all
      · exact Or.inl fun x hx => (box_cell _ _ hv' c x hx).2 hb

/-- The model's keep rule on a grid cell. -/
def keep (p : Pat) (c : Nat × Nat × Nat) : Bool :=
  let inA := inBox (fun i => (p.rel i).a0) (fun i => (p.rel i).a1) c
  let inB := inBox (fun i => (p.rel i).b0) (fun i => (p.rel i).b1) c
  match p.op with
  | .union => inA || inB
  | .subtract => inA && !inB
  | .intersect => inA && inB

/-- `keep` is `Model.kept3` on the cells inside rank space (interval t of an axis is the model's
odd doubled coordinate 2t-1), and keeps nothing outside it. -/
theorem keep_kept3 (p : Pat) (a b c : Nat) (ha : 1 ≤ a ∧ a ≤ 3) (hb : 1 ≤ b ∧ b ≤ 3) (hc : 1 ≤ c ∧ c ≤ 3) :
    keep p (a, b, c) = kept3 p ⟨2 * a - 1, 2 * b - 1, 2 * c - 1⟩ := by
  have oi : ∀ (lo hi t : Nat), 1 ≤ t → (inIv lo hi t = (decide (2 * lo < 2 * t - 1) && decide (2 * t - 1 < 2 * hi))) := by
    intro lo hi t ht; simp only [inIv]; by_cases h1 : lo + 1 ≤ t <;> by_cases h2 : t ≤ hi <;> simp [h1, h2] <;> omega
  simp only [keep, kept3, inBox, axes, List.all_cons, List.all_nil, Bool.and_true, openIn, lo, hi,
    Pat.rel, V3.get, oi _ _ a ha.1, oi _ _ b hb.1, oi _ _ c hc.1]
  have : 2 * a - 1 < 7 ∧ 2 * b - 1 < 7 ∧ 2 * c - 1 < 7 := by omega
  cases p.op <;> simp [this, Bool.and_assoc]

theorem keep_iff (p : Pat) (hv : Valid p) (c : Nat × Nat × Nat) (x : Q3) (hx : cellPt c x) :
    keep p c = true ↔ (specOp p.op).rule fun b => pair (boxA p) (boxB p) b x := by
  have hA := box_cell _ _ (fun j => ⟨(hv j).1, (hv j).2.1⟩) c x hx
  have hB := box_cell _ _ (fun j => ⟨(hv j).2.2.1, (hv j).2.2.2⟩) c x hx
  simp only [boxA, boxB] at *
  simp only [ForgeExact.Op.rule, pair, keep, ite_true]
  cases p.op <;> simp [specOp, ForgeExact.Op.eval, hA, hB]

/-- **The exact answer is the spec's regularised boolean.** For every valid pattern, the
regularised union of the grid cells the model keeps (`keep`, which is `kept3` inside rank space)
is `regBool` of the two boxes. -/
theorem exact_is_regBool (p : Pat) (hv : Valid p) :
    reg ((grid p hv).kept fun c => keep p c = true) = regBool (specOp p.op) (boxA p) (boxB p) :=
  reg_kept (grid p hv) (specOp p.op).rule _ fun c x hx => keep_iff p hv c x hx

/-- **The modelled kernel is correct off the gaps.** On every consistent pattern but the eight
corner-touch unions, for either sample side, the modelled kernel's outcome is the exact one, and
the exact one is read off the kept grid cells whose regularised union is the spec's `regBool`. -/
theorem kernel_correct : ∀ p ∈ Pat.all, gapLabels.contains p.label = false →
    kernel p = exact p ∧
    ∃ hv : Valid p,
      reg ((grid p hv).kept fun c => keep p c = true) = regBool (specOp p.op) (boxA p) (boxB p) := by
  intro p hp hg
  refine ⟨?_, valid_all p hp, exact_is_regBool p (valid_all p hp)⟩
  have h := List.all_eq_true.mp correct_off_gaps p hp
  simp only [hg, Bool.false_or, beq_iff_eq] at h
  exact h

end Coverage.Correct

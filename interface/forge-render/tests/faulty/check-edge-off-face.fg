# A part the kernel builds and the check does not pass: the boss's top edge rounded, then a
# cross with rounded inner corners cut down through the round, whose edges end off their face.
sketch foot(on: xy) {
  c = circle((0, 0), 4.5)
}
t0 = extrude(foot, 0.5)
sketch top(on: t0.end) {
  c = circle((0, 0), 2.5)
}
t1 = extrude(top, 1.4)
t2 = fillet(edges(of: t1.end), 1.2)
sketch cross(on: t1.end) {
  path o(start: (0.4, -1.3)) {
    line(to: (-0.4, -1.3))
    line(to: (-0.4, -1.0))
    tarc(to: (-1.0, -0.4))
    line(to: (-1.3, -0.4))
    line(to: (-1.3, 0.4))
    line(to: (-1.0, 0.4))
    tarc(to: (-0.4, 1.0))
    line(to: (-0.4, 1.3))
    line(to: (0.4, 1.3))
    line(to: (0.4, 1.0))
    tarc(to: (1.0, 0.4))
    line(to: (1.3, 0.4))
    line(to: (1.3, -0.4))
    line(to: (1.0, -0.4))
    tarc(to: (0.4, -1.0))
    close()
  }
}
t3 = cut(cross, 1.1)

machining
# block_m6.fg: face, profile, drill the M6 tap drill (no tap), and mill the thread. The thread is
# not in the model, so the op declares it: a cosmetic thread, the ring between the 5 mm bore and
# the 6 mm major diameter, listed in the reply.
# Workholding: in a Haas 6" CrossOver vise (haas-vise-05-0404, checked against its own model).
# The stock is 6 mm deeper than the part and the jaws grip only its bottom 3 mm, so their tops
# stand 3 mm under the part. The clear goes 0.5 mm into that skin, clear of the jaws by more than
# the fixture clearance, and the part stays on the skin; the skin is faced off with the part
# turned over in a second setup (not in this example).
shared tol = 0.01

f    = part("block_m6.fg", material: "6061-T6")
m    = machine("generic-vmc3")
t1   = tool("flat-10", t: 1, stickout: 32, holder: "bt40-er32")
t6   = tool("threadmill-m6-m12-1", t: 6, stickout: 20, holder: "bt40-er32")
op1  = setup(f, machine: m, stock: box(margin: (3, 3, 1), below: 6), origin: "top-corner", tol: tol, at: (-20, -20, -250), fixture: vise("haas-vise-05-0404", across: "x", clamp: 3))
skim = facing(op1, tool: t1, to: 14, step: 1)
side = clear(op1, tool: t1, from: 14, to: -0.5, step: 3, stepover: 4)
tapd = drill(op1, f.m6, plan: "drill")
thr  = thread_mill(op1, f.m6, tool: t6)
prog = program(op1, post: "fanuc", number: 4001)

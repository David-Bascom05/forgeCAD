# onefinity-elite-foreman bed: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.bed); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -1244.1
shared b0y0 = -1248.5
shared b0z0 = -99.5
shared b0sx = 1243.6
shared b0sy = 1248
shared b0h = 99

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

sketch S0(on: xy) {
  o = rect(corner: (0, 0), size: (74.39, 86.74))
}
L0 = extrude(S0, 34.72)
sketch H0(on: offset(xy, 17.36)) {
  p0 = pt(20.67, 0.83)
}
sketch S1(on: plane(at: H0.p0, normal: -Y)) {
  o = poly([(3.86, 1.37), (-0.78, 4.48), (-4.8, -1.37), (-0.35, -3.93)])
}
L1 = extrude(S1, next, flip: true)
sketch H2(on: offset(xy, 0)) {

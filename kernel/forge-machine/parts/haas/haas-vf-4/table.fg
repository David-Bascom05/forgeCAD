# haas-vf-4 table: 1321 x 495 published, thickness estimated; one T-slot
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -659.4
shared y0 = -246.7
shared z0 = -182.4
shared lx = 1318.8
shared ly = 493.4
shared lz = 181.4
shared cx = 0
shared cy = 0
shared cw = 1321
shared cl = 16
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

# fadal-vmc-6032-50t table: 61×30 in published, thickness estimated
# frame: the machine's base frame at the home pose (forgecad Haas approximation).
shared x0 = -773.7
shared y0 = -380
shared z0 = -99
shared lx = 1547.4
shared ly = 760
shared lz = 98
shared cx = 0
shared cy = 0
shared cw = 1549.4
shared cl = 18
shared cd = 14

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (lx, ly))
}
block = extrude(plan, lz)
sketch top(on: block.end) {
  r = rect(center: (cx, cy), size: (cw, cl))
}
tslot = cut(top.r, cd)

pcb
# Eight independent RC inputs. Both through-hole connectors share a ground return on pin 9.
perimeter = edge(points: [(2,0),(50,0),arc(via:(51.414214,0.585786),to:(52,2)),(52,28),arc(via:(51.414214,29.414214),to:(50,30)),(2,30),arc(via:(0.585786,29.414214),to:(0,28)),(0,2),arc(via:(0.585786,0.585786),to:(2,0))])

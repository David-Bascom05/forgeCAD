# A snap-on lid modelled from its inside (from: "inner": the solid is the lid's inner surface, the
# sheet goes on outside it), on a male mould, with two faults the checks catch: the snap bead round
# the top overhangs the drafted walls (it turns under the pull: the formed lid locks on the mould),
# and two posts on the top stand closer together than they are tall (the sheet webs between them).
shared t = 1.5
shared W = 90
shared L = 60
shared H = 18
shared lean = 5deg
shared r = 6
shared bead_h = 3
param pk.pr = 6
param pk.gap = 8
param posts.ph = 14
sketch footprint(on: xy) {
  outline = hull(disc((r - W / 2, r - L / 2), r), disc((W / 2 - r, r - L / 2), r),
                 disc((W / 2 - r, L / 2 - r), r), disc((r - W / 2, L / 2 - r), r))
}
body = extrude(footprint, H, taper: lean)
sketch rim(on: body.end) {
  o = hull(disc((r - W / 2, r - L / 2), r), disc((W / 2 - r, r - L / 2), r),
           disc((W / 2 - r, L / 2 - r), r), disc((r - W / 2, L / 2 - r), r))
}
bead = extrude(rim.o, bead_h)
sketch pk(on: bead.end) {
  for i in 0..2 {
    c = circle(((2 * i - 1) * (pr + gap / 2), 0), pr)
  }
}
for i in 0..2 {
  posts = extrude(pk.c[i], ph, taper: lean)
}
lid = thermoform(body, from: "inner", t: t, material: "ABS")

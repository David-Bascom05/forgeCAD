    let off1 ← forge_math.vec.Vec3.Insts.CoreOpsArithSubVec3Vec3.sub off v1
    let dist ← forge_math.vec.Vec3.length off1
    let fl3 ← forge_math.tol.LINEAR
    if F64.Ops.le dist fl3
    then
      let fl4 ← lift (F64.Ops.sub c.radius d.radius)
      let fl5 ← core.f64.F64.abs fl4
      if F64.Ops.le fl5 fl3
      then ok forge_geom.intersect.SurfaceSurface.Coincident
      else ok forge_geom.intersect.SurfaceSurface.Empty
    else
      let fl4 ← lift (F64.Ops.add c.radius d.radius)
      let fl5 ← lift (F64.Ops.add fl4 fl3)
      if F64.Ops.gt dist fl5
      then ok forge_geom.intersect.SurfaceSurface.Empty
      else
        let fl6 ← lift (F64.Ops.sub c.radius d.radius)
        let fl7 ← core.f64.F64.abs fl6
        let fl8 ← lift (F64.Ops.sub fl7 fl3)
        if F64.Ops.lt dist fl8
        then ok forge_geom.intersect.SurfaceSurface.Empty
        else
          let ex ←
            forge_math.vec.Vec3.Insts.CoreOpsArithDivF64Vec3.div off1 dist
          let ey ←
            forge_math.vec.UnitVec3.cross (core.convert.IntoFrom
              (core.convert.FromSame forge_math.vec.Vec3)) a ex
          let fl9 ← lift (F64.Ops.mul dist dist)
          let fl10 ← lift (F64.Ops.mul c.radius c.radius)
          let fl11 ← lift (F64.Ops.add fl9 fl10)
          let fl12 ← lift (F64.Ops.mul d.radius d.radius)
          let fl13 ← lift (F64.Ops.sub fl11 fl12)
          let fl14 ←
            lift (F64.Ops.mul (F64.Ops.ofBits 4611686018427387904) dist)
          let x ← lift (F64.Ops.div fl13 fl14)
          let fl15 ← lift (F64.Ops.mul c.radius c.radius)
          let fl16 ← lift (F64.Ops.mul x x)
          let h2 ← lift (F64.Ops.sub fl15 fl16)
          let fl17 ←
            lift (F64.Ops.mul (F64.Ops.ofBits 4611686018427387904) fl3)
          let fl18 ← lift (F64.Ops.mul fl17 c.radius)
          let fl19 ← core.f64.F64.max fl18 (F64.Ops.ofBits 0)
          if F64.Ops.le h2 fl19
          then
            let p ←
              ssi.cylinder_cylinder.closure.Insts.CoreOpsFunctionFnTupleF64Point3.call
                (c, ex, x, ey) (F64.Ops.ofBits 0)
            let l ← forge_geom.curve.Line.new p a
            let y ←
              lift (Std.Array.to_slice
                (Array.make 1#usize [
                   (forge_geom.curve.Curve.Line l,
                   forge_geom.intersect.Contact.Touching)
                   ] : Array (forge_geom.curve.Curve ×
                forge_geom.intersect.Contact) 1#usize))
            let ret := alloc.slice.Slice.into_vec y
            ok (forge_geom.intersect.SurfaceSurface.Curves ret)
          else
            let h ← std.f64.F64.sqrt h2
            let fl20 ← lift (F64.Ops.neg h)
            let p ←
              ssi.cylinder_cylinder.closure.Insts.CoreOpsFunctionFnTupleF64Point3.call
                (c, ex, x, ey) fl20
            let l ← forge_geom.curve.Line.new p a
            let p1 ←
              ssi.cylinder_cylinder.closure.Insts.CoreOpsFunctionFnTupleF64Point3.call
                (c, ex, x, ey) h
            let l1 ← forge_geom.curve.Line.new p1 a
            let y ←
              lift (Std.Array.to_slice
                (Array.make 2#usize [
                   (forge_geom.curve.Curve.Line l,
                   forge_geom.intersect.Contact.Crossing),
                   (forge_geom.curve.Curve.Line l1,
                   forge_geom.intersect.Contact.Crossing)
                   ] : Array (forge_geom.curve.Curve ×
                forge_geom.intersect.Contact) 2#usize))
            let ret := alloc.slice.Slice.into_vec y
            ok (forge_geom.intersect.SurfaceSurface.Curves ret)

/-- [forge_bool::ssi::closed_form]:
    Source: 'kernel/forge-bool/src/ssi.rs', lines 17:0-44:1
    Visibility: public -/
def ssi.closed_form
  (a : forge_geom.surface.Surface) (b : forge_geom.surface.Surface) :
  Result forge_geom.intersect.SurfaceSurface
  := do
  let closed ←
    match a with
    | forge_geom.surface.Surface.Plane p =>
      forge_geom.intersect.plane_surface p b
    | forge_geom.surface.Surface.Cylinder c =>
      match b with
      | forge_geom.surface.Surface.Plane p =>
        forge_geom.intersect.plane_surface p a
      | forge_geom.surface.Surface.Cylinder d => ssi.cylinder_cylinder c d
      | forge_geom.surface.Surface.Cone _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Sphere _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Torus _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Procedural _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
    | forge_geom.surface.Surface.Cone _ =>
      match b with
      | forge_geom.surface.Surface.Plane p =>
        forge_geom.intersect.plane_surface p a
      | forge_geom.surface.Surface.Cylinder _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Cone _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Sphere _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Torus _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Procedural _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
    | forge_geom.surface.Surface.Sphere s =>
      match b with
      | forge_geom.surface.Surface.Plane p =>
        forge_geom.intersect.plane_surface p a
      | forge_geom.surface.Surface.Cylinder _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Cone _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Sphere t => ssi.sphere_sphere s t
      | forge_geom.surface.Surface.Torus _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Procedural _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
    | forge_geom.surface.Surface.Torus _ =>
      match b with
      | forge_geom.surface.Surface.Plane p =>
        forge_geom.intersect.plane_surface p a
      | forge_geom.surface.Surface.Cylinder _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Cone _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Sphere _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Torus _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Procedural _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
    | forge_geom.surface.Surface.Procedural _ =>
      match b with
      | forge_geom.surface.Surface.Plane p =>
        forge_geom.intersect.plane_surface p a
      | forge_geom.surface.Surface.Cylinder _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Cone _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Sphere _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Torus _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
      | forge_geom.surface.Surface.Procedural _ =>
        ok forge_geom.intersect.SurfaceSurface.NotAnalytic
  let r ←
    match closed with
    | forge_geom.intersect.SurfaceSurface.Empty =>
      ok forge_geom.intersect.SurfaceSurface.Empty
    | forge_geom.intersect.SurfaceSurface.Coincident =>
      ok forge_geom.intersect.SurfaceSurface.Coincident
    | forge_geom.intersect.SurfaceSurface.Points _ => ok closed
    | forge_geom.intersect.SurfaceSurface.Curves _ => ok closed
    | forge_geom.intersect.SurfaceSurface.NotAnalytic =>
      do
      let o ← forge_geom.screw.coaxial.meet_coaxial a b
      match o with
      | none =>
        let o1 ← forge_geom.ruled.meet.meet_ruled a b
        match o1 with
        | none =>
          let o2 ← forge_geom.spline.meet.meet_spline a b
          match o2 with
          | none => ok forge_geom.intersect.SurfaceSurface.NotAnalytic
          | some r1 => ok r1
        | some r1 => ok r1
      | some r1 => ok r1
  let b1 ← forge_geom.sheet.spindle_in a b
  if b1
  then forge_geom.sheet.used_by a b r
  else ok r

/-- [forge_bool::ssi::closed_or_flush]:
    Source: 'kernel/forge-bool/src/ssi.rs', lines 48:0-75:1 -/
def ssi.closed_or_flush
  (a : forge_geom.surface.Surface) (b : forge_geom.surface.Surface)
  (region : forge_math.interval.Box3) :
  Result forge_geom.intersect.SurfaceSurface
  := do
  let r ← ssi.closed_form a b
  let (r1, near) ←
    match a with
    | forge_geom.surface.Surface.Plane p =>
      match b with
      | forge_geom.surface.Surface.Plane q =>
        do
        let b1 ←
          match r with
          | forge_geom.intersect.SurfaceSurface.Empty =>
            do
            let uv ← forge_geom.surface.Plane.normal_vec p
            let uv1 ← forge_geom.surface.Plane.normal_vec q
            let u ←
              forge_math.vec.UnitVec3.cross (core.convert.IntoFrom
                forge_math.vec.Vec3.Insts.CoreConvertFromUnitVec3) uv uv1
            if F64.Ops.ne u.x (F64.Ops.ofBits 0)
            then ok true
            else
              if F64.Ops.ne u.y (F64.Ops.ofBits 0)
              then ok true
              else ok (F64.Ops.ne u.z (F64.Ops.ofBits 0))
          | forge_geom.intersect.SurfaceSurface.Coincident =>
            do
            let uv ← forge_geom.surface.Plane.normal_vec p
            let uv1 ← forge_geom.surface.Plane.normal_vec q
            let u ←
              forge_math.vec.UnitVec3.cross (core.convert.IntoFrom
                forge_math.vec.Vec3.Insts.CoreConvertFromUnitVec3) uv uv1
            if F64.Ops.ne u.x (F64.Ops.ofBits 0)
            then ok true
            else
              if F64.Ops.ne u.y (F64.Ops.ofBits 0)
              then ok true
              else ok (F64.Ops.ne u.z (F64.Ops.ofBits 0))
          | forge_geom.intersect.SurfaceSurface.Points _ => ok false
          | forge_geom.intersect.SurfaceSurface.Curves _ =>
            do
            let uv ← forge_geom.surface.Plane.normal_vec p
            let uv1 ← forge_geom.surface.Plane.normal_vec q
            let fl ←
              forge_math.vec.UnitVec3.dot (core.convert.IntoFrom
                forge_math.vec.Vec3.Insts.CoreConvertFromUnitVec3) uv uv1
            let fl1 ← core.f64.F64.abs fl
            ok (F64.Ops.gt fl1 (F64.Ops.ofBits 4602678819172646912))
          | forge_geom.intersect.SurfaceSurface.NotAnalytic => ok false
        ok (r, b1)
      | forge_geom.surface.Surface.Cylinder _ =>
        do
        let b1 ←
          match r with
          | forge_geom.intersect.SurfaceSurface.Empty => ok false
          | forge_geom.intersect.SurfaceSurface.Coincident => ok false
          | forge_geom.intersect.SurfaceSurface.Points _ => ok false
          | forge_geom.intersect.SurfaceSurface.Curves cs =>
            let i := alloc.vec.Vec.len cs
            if i = 1#usize
            then
              do
              let (c, _) ←
                alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
                  (forge_geom.curve.Curve × forge_geom.intersect.Contact)) cs
                  0#usize
              match c with
              | forge_geom.curve.Curve.Line _ => ok false
              | forge_geom.curve.Curve.Circle _ => ok false
              | forge_geom.curve.Curve.Ellipse _ => ok true
              | forge_geom.curve.Curve.Parabola _ => ok false
              | forge_geom.curve.Curve.Hyperbola _ => ok false
              | forge_geom.curve.Curve.Intersection _ => ok false
              | forge_geom.curve.Curve.Procedural _ => ok false
            else ok false
          | forge_geom.intersect.SurfaceSurface.NotAnalytic => ok false
        ok (r, b1)
      | forge_geom.surface.Surface.Cone _ => ok (r, false)
      | forge_geom.surface.Surface.Sphere _ => ok (r, false)
      | forge_geom.surface.Surface.Torus _ => ok (r, false)
      | forge_geom.surface.Surface.Procedural _ => ok (r, false)
    | forge_geom.surface.Surface.Cylinder _ =>
      match b with
      | forge_geom.surface.Surface.Plane _ =>
        do
        let b1 ←
          match r with
          | forge_geom.intersect.SurfaceSurface.Empty => ok false
          | forge_geom.intersect.SurfaceSurface.Coincident => ok false
          | forge_geom.intersect.SurfaceSurface.Points _ => ok false
          | forge_geom.intersect.SurfaceSurface.Curves cs =>
            let i := alloc.vec.Vec.len cs
            if i = 1#usize
            then
              do
              let (c, _) ←
                alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
                  (forge_geom.curve.Curve × forge_geom.intersect.Contact)) cs
                  0#usize
              match c with
              | forge_geom.curve.Curve.Line _ => ok false
              | forge_geom.curve.Curve.Circle _ => ok false
              | forge_geom.curve.Curve.Ellipse _ => ok true
              | forge_geom.curve.Curve.Parabola _ => ok false
              | forge_geom.curve.Curve.Hyperbola _ => ok false
              | forge_geom.curve.Curve.Intersection _ => ok false
              | forge_geom.curve.Curve.Procedural _ => ok false
            else ok false
          | forge_geom.intersect.SurfaceSurface.NotAnalytic => ok false
        ok (r, b1)
      | forge_geom.surface.Surface.Cylinder _ => ok (r, false)
      | forge_geom.surface.Surface.Cone _ => ok (r, false)
      | forge_geom.surface.Surface.Sphere _ => ok (r, false)
      | forge_geom.surface.Surface.Torus _ => ok (r, false)
      | forge_geom.surface.Surface.Procedural _ => ok (r, false)
    | forge_geom.surface.Surface.Cone _ => ok (r, false)
    | forge_geom.surface.Surface.Sphere _ => ok (r, false)
    | forge_geom.surface.Surface.Torus _ => ok (r, false)
    | forge_geom.surface.Surface.Procedural _ => ok (r, false)
  if near
  then
    let o ← ssi.nearly_flush a b region
    match o with
    | none => ok r1
    | some f => ok f
  else ok r1

/-- [forge_bool::ssi::surfaces_in]:
    Source: 'kernel/forge-bool/src/ssi.rs', lines 8:0-13:1
    Visibility: public -/
def ssi.surfaces_in
  (a : forge_geom.surface.Surface) (b : forge_geom.surface.Surface)
  (region : forge_math.interval.Box3) :
  Result forge_geom.intersect.SurfaceSurface
  := do
  let ss ← ssi.closed_or_flush a b region
  match ss with
  | forge_geom.intersect.SurfaceSurface.Empty =>
    ok forge_geom.intersect.SurfaceSurface.Empty
  | forge_geom.intersect.SurfaceSurface.Coincident =>
    ok forge_geom.intersect.SurfaceSurface.Coincident
  | forge_geom.intersect.SurfaceSurface.Points _ => ok ss
  | forge_geom.intersect.SurfaceSurface.Curves _ => ok ss
  | forge_geom.intersect.SurfaceSurface.NotAnalytic => ssi.searched a b region

end forge_bool

# A cover modelled thin-walled (from: "wall"): a solid shelled to its wall, open at its foot. The
# wall's inside is the male mould's surface, its thickness the sheet's, read from it.
shared W = 100
shared L = 70
shared H = 30
shared lean = 5deg
shared r = 10
shared rt = 6
shared wall = 1.5
sketch plan(on: xy) {
  outline = hull(disc((r - W / 2, r - L / 2), r), disc((W / 2 - r, r - L / 2), r),
                 disc((W / 2 - r, L / 2 - r), r), disc((r - W / 2, L / 2 - r), r))
}
body = extrude(plan, H, taper: lean)
round = fillet(edges(of: body.end), rt)
skin = shell(wall, open: body.start)
cover = thermoform(skin, from: "wall", material: "ABS")

footprint_library
# 0805 two-terminal land pattern. Physical bodies and assembly artwork follow placement.
chip0805 = footprint(
    pads: [smd(number: "1", at: (-0.95,0), size: (1.05,1.2), mask: 0.04mm, paste: -0.04mm),
           smd(number: "2", at: (0.95,0), size: (1.05,1.2), mask: 0.04mm, paste: -0.04mm)],
    courtyard: [(-1.65,-0.82),(1.65,-0.82),(1.65,0.82),(-1.65,0.82)],
    artwork: [layer_line(layer: "fab", points: [(-1,-0.625),(1,-0.625),(1,0.625),(-1,0.625),(-1,-0.625)], width: 0.1mm),
              layer_text(layer: "designator", at: (2,0), value: "{ref}", height: 0.7mm, width: 0.1mm)])


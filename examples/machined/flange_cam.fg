machining
# DWG-901 bearing flange (flange.fg) on a generic 3-axis VMC, one setup from the top, held in a
# Haas 6" CrossOver vise (haas-vise-05-0404, checked against its own model): face the stock, clear
# the plate's top around the boss, profile the plate, bore the boss from its hole feature, and drill
# the bolt circle from its hole feature (the plan comes from the history: d 6.6 through).
# Workholding: the stock is 8 mm deeper than the part and the jaws grip only its bottom 5 mm, so
# their tops stand 3 mm under the part. The profile goes 0.5 mm into that skin, clear of the jaws
# by more than the fixture clearance, and the part stays on the skin; the skin is faced off with
# the part turned over in a second setup (not in this example).
shared tol = 0.01

f    = part("flange.fg", material: "6061-T6")
m    = machine("generic-vmc3")
t1   = tool("flat-10", t: 1, stickout: 32, holder: "bt40-er32")
op1  = setup(f, machine: m, stock: box(margin: (3, 3, 2), below: 8), origin: "top-center", tol: tol, at: (0, 0, -250), fixture: vise("haas-vise-05-0404", across: "x", clamp: 5))
skim = facing(op1, tool: t1, to: 18, step: 1)
top  = clear(op1, tool: t1, from: 18, to: 12, step: 3, stepover: 4)
prof = contour(op1, tool: t1, side: "outside", from: 12, to: -0.5, step: 4)
bore = pocket(op1, f.bore_h, tool: t1, stepover: 2.5, step: 3)
bolts = drill(op1, f.bolts, plan: "auto")
prog = program(op1, post: "fanuc", number: 1001)

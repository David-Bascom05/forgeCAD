# caster axle spacer: steel tube 8.2 ID x 12.0 OD x 14.70, leg to the bearing's inner ring
# source: SPEC 6.2
# frame: origin on the axis in one end face; +z through the part

properties(description: "caster axle spacer", material: "AISI 1018")
shared ri = 4.1
shared ro = 6
shared h = 14.7

sketch prof(on: xz) {
  o = poly([(ri, 0), (ro, 0), (ro, h), (ri, h)])
  pz0 = pt(0, 0)
  pz1 = pt(0, h)
  zax = line((0, 0), (0, h), construction: true)
  xax = line((0, 0), (ro, 0), construction: true)
}
body = revolve(prof.o, axis: prof.zax)

a = anchor(plane(at: prof.pz0, normal: prof.zax.dir, x: prof.xax.dir))
b = anchor(plane(at: prof.pz1, normal: prof.zax.dir, x: prof.xax.dir))

expect valid
expect bodies = 1
expect volume = 886.221 +- 0.05%

# fanuc-robodrill-a-d21lib5 bed: the base under the saddle; from the floor (estimate) to the saddle ways.
# A stand-in built from published overall dimensions and estimates (not the maker's CAD).
# frame: the machine's base frame at the home pose.
shared x0 = -425
shared y0 = -505
shared z0 = -700
shared L = 850
shared W = 1370
shared H = 300

sketch plan(on: offset(xy, z0)) {
  outline = rect(corner: (x0, y0), size: (L, W))
}
body = extrude(plan, H)

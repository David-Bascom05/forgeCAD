# Road bicycle frame, 56 cm, as one part: hollow tubes mitred by the booleans, a tapered head
# tube with headset seats, a BSA threaded bottom bracket, lofted stays to flat dropouts with a
# threaded derailleur hanger, bridges, bottle bosses, a slotted seat clamp, cable ports. An older
# cut of the bench frame (lofted stays, the bottom bracket's joints rounded), its planes and points
# worked out from the dimensions listed as comments here, every number as the kernel takes it.
sketch o(on: xy) {
  p = pt(0, 0)
}
# param reach = 385
# param stack = 575
# param hta = 73 deg
# param sta = 73.5 deg
# param htl = 160
# param stl = 540
# param csl = 410
# param drop = 70
# param sp = 130
# param wall = 1
# param hdx = cos(hta)
# param hdz = -sin(hta)
# param hbx = reach + htl*hdx
# param hbz = stack + htl*hdz
# param ax = -sqrt(csl^2 - drop^2)
# param az = drop
# param dtx = hbx - 45*hdx
# param dtz = hbz - 45*hdz
# param dtl = sqrt(dtx^2 + dtz^2)
# param s1x = -(stl-45)*cos(sta)
# param s1z = (stl-45)*sin(sta)
# param h1x = reach + 25*hdx
# param h1z = stack + 25*hdz
# param ttl = sqrt((h1x-s1x)^2 + (h1z-s1z)^2)
# param c0x = -17.5
# param c0y = 22
# param c1x = ax + 6
# param c1y = sp/2 - 4
# param csx = c1x - c0x
# param csy = c1y - c0y
# param csz = az
# param cl = sqrt(csx^2 + csy^2 + csz^2)
# param q0x = -(stl-80)*cos(sta)
# param q0z = (stl-80)*sin(sta)
# param q0y = 10
# param q1x = ax + 10
# param q1z = az + 14
# param q1y = sp/2 - 4
# param ssx = q1x - q0x
# param ssy = q1y - q0y
# param ssz = q1z - q0z
# param sl = sqrt(ssx^2 + ssy^2 + ssz^2)

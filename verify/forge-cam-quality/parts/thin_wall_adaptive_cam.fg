machining
# Benchmark (verify/forge-cam-quality): thin_wall by adaptive clearing, one 12 mm level, 40° cap.
shared tol = 0.01

f    = part("thin_wall.fg", group: "N")
m    = machine("generic-vmc3")
t2   = tool("flat-6", t: 2, stickout: 26, holder: "bt40-er32")
op1  = setup(f, machine: m, stock: box(margin: (3, 3, 1)), origin: "top-corner", tol: tol)
skim = facing(op1, tool: t2, to: 20, step: 1)
wells = adaptive(op1, tool: t2, region: "pockets", from: 20, to: 8, step: 12, engagement: 40)
prog = program(op1, post: "fanuc", number: 5008)

# roland-mdx-50 carriage: a conservative envelope solid from published dimensions (see the
# machine's [[machine.cite]] for body.carriage); not the maker's CAD.
# frame: the machine's base frame at the home pose.
shared b0x0 = -59.5
shared b0y0 = 45.5
shared b0z0 = 200.5
shared b0sx = 119
shared b0sy = 279
shared b0h = 174

sketch sb0(on: offset(xy, b0z0)) {
  outline = rect(corner: (b0x0, b0y0), size: (b0sx, b0sy))
}
b0 = extrude(sb0, b0h)

# A threaded bush for turning: Ø50 outside, an M30 x 1.5 internal thread from the front face (the
# bore at its minor diameter, 30 - 5H/4 with H = 1.5·√3/2), a Ø32 thread relief groove 19 to 22
# deep, the bore on to the back face 30 below. Frame: z along the axis, Z0 on the front face.
shared d = 50
shared d1 = 30 - 1.25 * 1.5 * 0.8660254037844386
shared l = 30
shared dg = 32
shared g0 = 19
shared g1 = 22

sketch prof(on: xz) {
  o = poly([(d1 / 2, -l), (d / 2, -l), (d / 2, 0), (d1 / 2, 0), (d1 / 2, -g0), (dg / 2, -g0), (dg / 2, -g1), (d1 / 2, -g1)])
  zax = line((0, -l), (0, 0), construction: true)
}
body = revolve(prof.o, axis: prof.zax)

expect valid
expect bodies = 1
